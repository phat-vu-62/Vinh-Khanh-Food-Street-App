@page "/usage-history"
@inject IAdminDataService DataService
@inject ToastService Toasts

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Lịch sử sử dụng</h1>
        <small class="text-muted">Nhật ký hoạt động xem điểm tham quan và nghe âm thanh</small>
    </div>
    <div class="d-flex gap-2">
        <InputDate class="form-control" style="min-width: 150px;" @bind-Value="_selectedDate" @bind-Value:after="() => { _currentPage = 1; LoadAsync(); }" TValue="DateTime?" placeholder="Lọc theo ngày..." />
        <button class="btn btn-outline-secondary" @onclick="ClearFilter" disabled="@(_selectedDate == null)">Xóa lọc</button>
        <button class="btn btn-outline-primary" @onclick="LoadAsync">Làm mới</button>
    </div>
</div>

<section class="module-panel">
    <LoadingState IsLoading="_isLoading" Message="Đang tải lịch sử sử dụng..." />

    @if (!_isLoading && _history.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-clock-history empty-icon"></i>
            <div class="empty-title">Chưa có lịch sử sử dụng</div>
            <div class="empty-description">Nhật ký hoạt động sẽ xuất hiện tại đây khi người dùng tương tác với các điểm tham quan qua ứng dụng di động.</div>
        </div>
    }
    else if (!_isLoading)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="input-group" style="max-width:320px;">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input class="form-control" placeholder="Tìm kiếm theo người dùng, điểm hoặc hành động..." @bind="_searchTerm" @bind:event="oninput" @bind:after="() => { _currentPage = 1; }" />
            </div>
            <small class="text-muted">@GetFilteredHistory().Count() bản ghi</small>
        </div>

        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th>Người dùng</th>
                        <th>Điểm tham quan</th>
                        <th>Hành động</th>
                        <th>Thời lượng</th>
                        <th>Thời gian</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in GetPagedHistory())
                    {
                        <tr>
                            <td>
                                <span class="d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-person-circle text-muted"></i>

                                </span>
                            </td>
                            <td class="fw-semibold">@FindPoiName(item.PoiId)</td>
                            <td>
                                <span class="badge @(GetActionBadge(item.Action))">@GetActionLabel(item.Action)</span>
                            </td>
                            <td>
                                @if (item.DurationSeconds.HasValue && item.DurationSeconds > 0)
                                {
                                    <span>@item.DurationSeconds giây</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>@item.VisitedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (GetTotalHistoryPages() > 1)
        {
            <div class="d-flex justify-content-between align-items-center mt-3">
                <small class="text-muted">Trang @_currentPage / @GetTotalHistoryPages()</small>
                <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(_currentPage <= 1)" @onclick="() => _currentPage--">
                        <i class="bi bi-chevron-left"></i> Trước
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(_currentPage >= GetTotalHistoryPages())" @onclick="() => _currentPage++">
                        Sau <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    }
</section>

@code {
    private readonly List<UserHistory> _history = [];
    private readonly List<POI> _pois = [];
    private bool _isLoading;
    private DateTime? _selectedDate;
    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 15;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _history.Clear();
        _pois.Clear();

        try
        {
            _pois.AddRange(DataService.GetPois());
        }
        catch { /* POI table may be empty */ }

        try
        {
            _history.AddRange(DataService.GetUsageHistories());
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[USAGE] Cannot load histories: {ex.Message}");
        }

        if (_history.Count == 0 && _pois.Count > 0)
        {
            try
            {
                SeedMockHistory();
                _history.Clear();
                _history.AddRange(DataService.GetUsageHistories());
            }
            catch { /* seeding failed, show empty */ }
        }

        _isLoading = false;
        await Task.CompletedTask;
    }

    private void SeedMockHistory()
    {
        if (_pois.Count == 0) return;

        var firstPoiId = _pois[0].Id;
        var now = DateTime.UtcNow;

        DataService.AddUsageHistory(new UserHistory
        {
            UserId = "guest-001",
            PoiId = firstPoiId,
            Action = "POI viewed",
            VisitedAtUtc = now.AddMinutes(-10)
        });

        DataService.AddUsageHistory(new UserHistory
        {
            UserId = "guest-001",
            PoiId = firstPoiId,
            Action = "Audio played",
            VisitedAtUtc = now.AddMinutes(-7)
        });

        Toasts.Info("Đã khởi tạo lịch sử sử dụng giả lập.");
    }

    private IEnumerable<UserHistory> GetFilteredHistory()
    {
        var query = _history.OrderByDescending(x => x.VisitedAtUtc).AsEnumerable();
        if (_selectedDate.HasValue)
        {
            query = query.Where(x => x.VisitedAtUtc.ToLocalTime().Date == _selectedDate.Value.Date);
        }
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(x =>
                (x.UserId ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)
                || FindPoiName(x.PoiId).Contains(term, StringComparison.OrdinalIgnoreCase)
                || (x.Action ?? "").Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        return query;
    }

    private IEnumerable<UserHistory> GetPagedHistory() => GetFilteredHistory().Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    private int GetTotalHistoryPages() => (int)Math.Ceiling((double)GetFilteredHistory().Count() / _pageSize);

    private Task ClearFilter()
    {
        _selectedDate = null;
        _searchTerm = string.Empty;
        _currentPage = 1;
        return LoadAsync();
    }

    private string FindPoiName(int poiId) => _pois.FirstOrDefault(x => x.Id == poiId)?.Name ?? $"POI #{poiId}";

    private static string GetActionLabel(string? action) => string.IsNullOrWhiteSpace(action) ? "Không rõ" : (action.ToLowerInvariant() switch
    {
        "poi viewed" or "poi_viewed" => "Xem điểm",
        "audio played" or "audio_played" => "Nghe âm thanh",
        "route_entry" => "Vào tuyến",
        "listen" => "Đã nghe",
        _ => action
    });

    private static string GetActionBadge(string? action)
    {
        return action?.ToLowerInvariant() switch
        {
            "poi viewed" or "poi_viewed" => "text-bg-primary",
            "audio played" or "audio_played" => "text-bg-success",
            "route_entry" => "text-bg-info",
            "listen" => "text-bg-success",
            _ => "text-bg-secondary"
        };
    }
}
