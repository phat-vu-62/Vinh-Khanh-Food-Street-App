@page "/usage-history"
@inject IAdminDataService DataService
@inject ToastService Toasts

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="h3 fw-bold mb-1">Dữ liệu phân tích</h1>
        <p class="text-muted mb-0">Theo dõi hành vi người dùng và hiệu quả nội dung trên hệ thống.</p>
    </div>
    <div class="d-flex gap-2">
        <div class="input-group shadow-sm" style="width: 220px;">
            <span class="input-group-text bg-white border-end-0 rounded-start-2"><i class="bi bi-calendar3 text-muted"></i></span>
            <InputDate class="form-control border-start-0 rounded-end-2 small" @bind-Value="_selectedDate" @bind-Value:after="() => { _currentPage = 1; LoadAsync(); }" TValue="DateTime?" />
        </div>
        <button class="btn btn-saas btn-saas-secondary shadow-sm" @onclick="ClearFilter" disabled="@(_selectedDate == null)"><i class="bi bi-x-lg me-1"></i> Xóa lọc</button>
        <button class="btn btn-saas btn-saas-primary shadow-sm" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Làm mới</button>
    </div>
</div>

<LoadingState IsLoading="_isLoading" Message="Đang xử lý dữ liệu lớn..." />

@if (!_isLoading)
{
    @if (_history.Count == 0)
    {
        <div class="saas-card p-5 text-center">
            <i class="bi bi-clock-history text-light" style="font-size: 3rem;"></i>
            <h5 class="fw-bold mt-4">Chưa có hoạt động nào trong thời gian này</h5>
            <p class="text-muted small">Hãy chọn một mốc thời gian khác hoặc chờ dữ liệu mới.</p>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5">
            <!-- Avg Duration Metric -->
            <div class="col-lg-4">
                <div class="saas-card p-4 h-100">
                    <span class="stats-label d-block mb-2">Thời lượng nghe trung bình</span>
                    <div class="d-flex align-items-center gap-3">
                        <span class="stats-value">@(_history.Any() ? _history.Average(h => h.DurationSeconds ?? 0).ToString("0.0") : "0")s</span>
                        <span class="text-success small fw-bold">Active Engagement</span>
                    </div>
                    <div class="mt-4 pt-4 border-top">
                        <div class="d-flex justify-content-between small text-muted mb-2">
                            <span>Mục tiêu: 120s</span>
                            <span>@((_history.Average(h => h.DurationSeconds ?? 0) * 100 / 120).ToString("0"))%</span>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-primary" style="width: @(Math.Min(100, _history.Average(h => h.DurationSeconds ?? 0) * 100 / 120))%; background-color: var(--primary-color);"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Distribution SVG -->
            <div class="col-lg-8">
                <div class="saas-card p-4 h-100">
                    <h6 class="fw-bold mb-4">Mật độ tương tác (24h)</h6>
                    <div class="chart-container" style="height: 120px;">
                         <svg width="100%" height="80" preserveAspectRatio="none">
                             <polyline points="0,60 50,40 100,55 150,20 200,30 250,10 300,50 350,45 400,15 450,35 500,25" 
                                       fill="none" stroke="var(--primary-color)" stroke-width="2" />
                             <path d="M0,60 50,40 100,55 150,20 200,30 250,10 300,50 350,45 400,15 450,35 500,25 V80 H0 Z" 
                                   fill="var(--primary-soft)" />
                         </svg>
                         <div class="d-flex justify-content-between mt-2 small text-muted">
                             <span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>23:59</span>
                         </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="saas-card overflow-hidden">
            <div class="table-responsive">
                <table class="saas-table">
                    <thead>
                        <tr>
                            <th>Người dùng</th>
                            <th>Địa điểm</th>
                            <th>Hành động</th>
                            <th>Thời lượng</th>
                            <th class="text-end">Thời gian</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in GetPagedHistory())
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-light rounded-circle small d-flex align-items-center justify-content-center" style="width:28px; height:28px;">
                                            <i class="bi bi-fingerprint text-muted"></i>
                                        </div>
                                        <span class="fw-medium small text-dark">UID-@h.UserId?.Take(8)</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="saas-badge badge-inactive">@FindPoiName(h.PoiId)</span>
                                </td>
                                <td>
                                    <span class="saas-badge @(h.Action == "Listen" ? "badge-active" : "badge-highlight")">
                                        @h.Action.ToUpper()
                                    </span>
                                </td>
                                <td class="small fw-semibold">@(h.DurationSeconds ?? 0) giây</td>
                                <td class="text-end text-muted small">@h.VisitedAtUtc.ToLocalTime().ToString("HH:mm:ss, dd/MM")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (GetTotalHistoryPages() > 1)
        {
            <div class="d-flex justify-content-center align-items-center mt-5 gap-3">
                <button class="btn btn-saas btn-saas-secondary btn-sm" disabled="@(_currentPage <= 1)" @onclick="() => _currentPage--">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <span class="small fw-bold">@_currentPage / @GetTotalHistoryPages()</span>
                <button class="btn btn-saas btn-saas-secondary btn-sm" disabled="@(_currentPage >= GetTotalHistoryPages())" @onclick="() => _currentPage++">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        }
    }
}

@code {
    private readonly List<UserHistory> _history = [];
    private readonly List<POI> _pois = [];
    private bool _isLoading;
    private DateTime? _selectedDate;
    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 15;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _history.Clear();
        _pois.Clear();

        try
        {
            _pois.AddRange(DataService.GetPois());
        }
        catch { /* POI table may be empty */ }

        try
        {
            _history.AddRange(DataService.GetUsageHistories());
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[USAGE] Cannot load histories: {ex.Message}");
        }

        if (_history.Count == 0 && _pois.Count > 0)
        {
            try
            {
                SeedMockHistory();
                _history.Clear();
                _history.AddRange(DataService.GetUsageHistories());
            }
            catch { /* seeding failed, show empty */ }
        }

        _isLoading = false;
        await Task.CompletedTask;
    }

    private void SeedMockHistory()
    {
        if (_pois.Count == 0) return;

        var firstPoiId = _pois[0].Id;
        var now = DateTime.UtcNow;

        DataService.AddUsageHistory(new UserHistory
        {
            UserId = "guest-001",
            PoiId = firstPoiId,
            Action = "POI viewed",
            VisitedAtUtc = now.AddMinutes(-10)
        });

        DataService.AddUsageHistory(new UserHistory
        {
            UserId = "guest-001",
            PoiId = firstPoiId,
            Action = "Audio played",
            VisitedAtUtc = now.AddMinutes(-7)
        });

        Toasts.Info("Đã khởi tạo lịch sử sử dụng giả lập.");
    }

    private IEnumerable<UserHistory> GetFilteredHistory()
    {
        var query = _history.OrderByDescending(x => x.VisitedAtUtc).AsEnumerable();
        if (_selectedDate.HasValue)
        {
            query = query.Where(x => x.VisitedAtUtc.ToLocalTime().Date == _selectedDate.Value.Date);
        }
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(x =>
                (x.UserId ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)
                || FindPoiName(x.PoiId).Contains(term, StringComparison.OrdinalIgnoreCase)
                || (x.Action ?? "").Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        return query;
    }

    private IEnumerable<UserHistory> GetPagedHistory() => GetFilteredHistory().Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    private int GetTotalHistoryPages() => (int)Math.Ceiling((double)GetFilteredHistory().Count() / _pageSize);

    private Task ClearFilter()
    {
        _selectedDate = null;
        _searchTerm = string.Empty;
        _currentPage = 1;
        return LoadAsync();
    }

    private string FindPoiName(int poiId) => _pois.FirstOrDefault(x => x.Id == poiId)?.Name ?? $"POI #{poiId}";

    private static string GetActionLabel(string? action) => string.IsNullOrWhiteSpace(action) ? "Không rõ" : (action.ToLowerInvariant() switch
    {
        "poi viewed" or "poi_viewed" => "Xem điểm",
        "audio played" or "audio_played" => "Nghe âm thanh",
        "route_entry" => "Vào tuyến",
        "listen" => "Đã nghe",
        _ => action
    });

    private static string GetActionBadge(string? action)
    {
        return action?.ToLowerInvariant() switch
        {
            "poi viewed" or "poi_viewed" => "text-bg-primary",
            "audio played" or "audio_played" => "text-bg-success",
            "route_entry" => "text-bg-info",
            "listen" => "text-bg-success",
            _ => "text-bg-secondary"
        };
    }
}
