@page "/usage-history"
@inject IAdminDataService DataService
@inject ToastService Toasts

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-0 text-orange">Lịch sử truy cập</h1>
        <p class="text-muted mb-0">Nhật ký hoạt động của khách tham quan trên ứng dụng di động</p>
    </div>
    <div class="d-flex gap-2">
        <div class="input-group" style="width: 220px;">
            <span class="input-group-text bg-white border-end-0 rounded-start-3"><i class="bi bi-calendar3"></i></span>
            <InputDate class="form-control border-start-0 rounded-end-3" @bind-Value="_selectedDate" @bind-Value:after="() => { _currentPage = 1; LoadAsync(); }" TValue="DateTime?" />
        </div>
        <button class="btn btn-modern btn-light border shadow-sm" @onclick="ClearFilter" disabled="@(_selectedDate == null)">Xóa lọc</button>
        <button class="btn btn-modern btn-primary-f&b shadow-sm" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Làm mới</button>
    </div>
</div>

<section class="food-card p-4 border-0 shadow-sm">
    <LoadingState IsLoading="_isLoading" Message="Đang tải lịch sử sử dụng..." />

    @if (!_isLoading && _history.Count == 0)
    {
        <div class="empty-state py-5">
            <i class="bi bi-clock-history text-muted" style="font-size: 3rem;"></i>
            <h5 class="fw-bold mt-3">Chưa có hoạt động nào</h5>
            <p class="text-muted">Nhật ký sẽ tự động xuất hiện khi có người dùng tương tác với mã QR hoặc xem bản đồ.</p>
        </div>
    }
    else if (!_isLoading)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div class="input-group" style="max-width:380px;">
                <span class="input-group-text bg-white border-end-0 rounded-start-3"><i class="bi bi-search text-muted"></i></span>
                <input class="form-control border-start-0 rounded-end-3" placeholder="Tìm tên khách, địa điểm hoặc hành động..." @bind="_searchTerm" @bind:event="oninput" @bind:after="() => { _currentPage = 1; }" />
            </div>
            <span class="badge badge-pill badge-gray border">Tổng cộng: @GetFilteredHistory().Count() bản ghi</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="bg-light">
                    <tr>
                        <th class="border-0">Khách tham quan</th>
                        <th class="border-0">Địa điểm tương tác</th>
                        <th class="border-0">Hành động</th>
                        <th class="border-0">Thời lượng</th>
                        <th class="border-0 text-end">Thời gian</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in GetPagedHistory())
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="bi bi-person-circle text-orange"></i>
                                    </div>
                                    <span class="fw-bold text-dark">@(string.IsNullOrEmpty(item.UserId) ? "Khách ẩn danh" : item.UserId)</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge badge-pill badge-gray border">
                                    <i class="bi bi-geo-alt me-1"></i>@FindPoiName(item.PoiId)
                                </span>
                            </td>
                            <td>
                                <span class="badge badge-pill @(GetActionBadge(item.Action)) px-2 py-1">
                                    @GetActionLabel(item.Action)
                                </span>
                            </td>
                            <td>
                                @if (item.DurationSeconds.HasValue && item.DurationSeconds > 0)
                                {
                                    <span class="fw-bold text-primary">@item.DurationSeconds giây</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end text-muted small">
                                <i class="bi bi-clock me-1"></i>@item.VisitedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (GetTotalHistoryPages() > 1)
        {
            <div class="d-flex justify-content-center align-items-center mt-4 gap-3">
                <button class="btn btn-sm btn-modern border bg-white shadow-sm" disabled="@(_currentPage <= 1)" @onclick="() => _currentPage--">
                    <i class="bi bi-chevron-left"></i> Trang trước
                </button>
                <span class="fw-bold text-orange">@_currentPage / @GetTotalHistoryPages()</span>
                <button class="btn btn-sm btn-modern border bg-white shadow-sm" disabled="@(_currentPage >= GetTotalHistoryPages())" @onclick="() => _currentPage++">
                    Trang sau <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        }
    }
</section>

@code {
    private readonly List<UserHistory> _history = [];
    private readonly List<POI> _pois = [];
    private bool _isLoading;
    private DateTime? _selectedDate;
    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 15;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _history.Clear();
        _pois.Clear();

        try
        {
            _pois.AddRange(DataService.GetPois());
        }
        catch { /* POI table may be empty */ }

        try
        {
            _history.AddRange(DataService.GetUsageHistories());
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[USAGE] Cannot load histories: {ex.Message}");
        }

        if (_history.Count == 0 && _pois.Count > 0)
        {
            try
            {
                SeedMockHistory();
                _history.Clear();
                _history.AddRange(DataService.GetUsageHistories());
            }
            catch { /* seeding failed, show empty */ }
        }

        _isLoading = false;
        await Task.CompletedTask;
    }

    private void SeedMockHistory()
    {
        if (_pois.Count == 0) return;

        var firstPoiId = _pois[0].Id;
        var now = DateTime.UtcNow;

        DataService.AddUsageHistory(new UserHistory
        {
            UserId = "guest-001",
            PoiId = firstPoiId,
            Action = "POI viewed",
            VisitedAtUtc = now.AddMinutes(-10)
        });

        DataService.AddUsageHistory(new UserHistory
        {
            UserId = "guest-001",
            PoiId = firstPoiId,
            Action = "Audio played",
            VisitedAtUtc = now.AddMinutes(-7)
        });

        Toasts.Info("Đã khởi tạo lịch sử sử dụng giả lập.");
    }

    private IEnumerable<UserHistory> GetFilteredHistory()
    {
        var query = _history.OrderByDescending(x => x.VisitedAtUtc).AsEnumerable();
        if (_selectedDate.HasValue)
        {
            query = query.Where(x => x.VisitedAtUtc.ToLocalTime().Date == _selectedDate.Value.Date);
        }
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(x =>
                (x.UserId ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)
                || FindPoiName(x.PoiId).Contains(term, StringComparison.OrdinalIgnoreCase)
                || (x.Action ?? "").Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        return query;
    }

    private IEnumerable<UserHistory> GetPagedHistory() => GetFilteredHistory().Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    private int GetTotalHistoryPages() => (int)Math.Ceiling((double)GetFilteredHistory().Count() / _pageSize);

    private Task ClearFilter()
    {
        _selectedDate = null;
        _searchTerm = string.Empty;
        _currentPage = 1;
        return LoadAsync();
    }

    private string FindPoiName(int poiId) => _pois.FirstOrDefault(x => x.Id == poiId)?.Name ?? $"POI #{poiId}";

    private static string GetActionLabel(string? action) => string.IsNullOrWhiteSpace(action) ? "Không rõ" : (action.ToLowerInvariant() switch
    {
        "poi viewed" or "poi_viewed" => "Xem điểm",
        "audio played" or "audio_played" => "Nghe âm thanh",
        "route_entry" => "Vào tuyến",
        "listen" => "Đã nghe",
        _ => action
    });

    private static string GetActionBadge(string? action)
    {
        return action?.ToLowerInvariant() switch
        {
            "poi viewed" or "poi_viewed" => "text-bg-primary",
            "audio played" or "audio_played" => "text-bg-success",
            "route_entry" => "text-bg-info",
            "listen" => "text-bg-success",
            _ => "text-bg-secondary"
        };
    }
}
