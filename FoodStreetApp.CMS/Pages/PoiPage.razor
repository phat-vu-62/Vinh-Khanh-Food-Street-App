    private async Task ApproveAsync(int id)
    {
        try
        {
            var success = await DataService.ApprovePoiAsync(id);
            if (success)
            {
                Toasts.Success("Đã duyệt địa điểm thành công! 🏛️");
                await LoadAsync();
            }
            else
            {
                Toasts.Error("Không thể duyệt địa điểm.");
            }
        }
        catch (Exception ex)
        {
            Toasts.Error($"Lỗi: {ex.Message}");
        }
    }
