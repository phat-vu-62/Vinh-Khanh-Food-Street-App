@page "/poi"
@inject IAdminDataService DataService
@inject ToastService Toasts

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">POI Management</h1>
        <small class="text-muted">Create, edit, activate and remove POIs</small>
    </div>
    <button class="btn btn-primary" @onclick="StartCreate">+ New POI</button>
</div>

<div class="module-panel">
    <LoadingState IsLoading="_isLoading" Message="Loading POIs..." />

    @if (!_isLoading && _pois.Count == 0)
    {
        <div class="empty-state">
            <p class="mb-2">No POIs found.</p>
            <button class="btn btn-primary btn-sm" @onclick="StartCreate">Create first POI</button>
        </div>
    }
    else if (!_isLoading)
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Coordinates</th>
                        <th>Translations</th>
                        <th>Active</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var poi in _pois.OrderByDescending(x => x.Id))
                    {
                        <tr>
                            <td>@poi.Name</td>
                            <td class="text-muted">@poi.Description</td>
                            <td>@poi.Latitude.ToString("0.00000"), @poi.Longitude.ToString("0.00000")</td>
                            <td>
                                @if (GetTranslationCount(poi) > 0)
                                {
                                    <span class="badge text-bg-primary">@GetTranslationCount(poi) languages</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" checked="@poi.IsActive" @onchange="(args) => ToggleActiveAsync(poi, args)" />
                                </div>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => TranslatePoiAsync(poi)" disabled="@_isTranslating">
                                    🌐 Translate
                                </button>
                                <button class="btn btn-sm btn-outline-secondary me-2" @onclick="() => StartEdit(poi)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(poi)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_isEditorOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5)">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content form-card">
                <EditForm Model="_form" OnValidSubmit="SaveAsync">
                    <div class="modal-header">
                        <h5 class="modal-title">@(_isEditing ? "Edit POI" : "Create POI")</h5>
                        <button type="button" class="btn-close" @onclick="CloseEditor"></button>
                    </div>
                    <div class="modal-body">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Name</label>
                                <InputText class="form-control" @bind-Value="_form.Name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Audio URL</label>
                                <InputText class="form-control" @bind-Value="_form.AudioUrl" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Description</label>
                                <InputText class="form-control" @bind-Value="_form.Description" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Latitude</label>
                                <InputNumber class="form-control" @bind-Value="_form.Latitude" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Longitude</label>
                                <InputNumber class="form-control" @bind-Value="_form.Longitude" />
                            </div>
                        </div>

                        @* ── Translation Section ── *@
                        @if (_isEditing)
                        {
                            <hr class="my-4" />
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="mb-0">
                                    <i class="bi bi-translate"></i> Translations
                                </h6>
                                <button type="button"
                                        class="btn btn-outline-primary btn-sm"
                                        disabled="@_isTranslating"
                                        @onclick="TranslateAsync">
                                    @if (_isTranslating)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                        <span>Translating…</span>
                                    }
                                    else
                                    {
                                        <span>🌐 Translate</span>
                                    }
                                </button>
                            </div>

                            <div class="row g-3">
                                @* Vietnamese *@
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇻🇳 Name (Vi)</label>
                                    <input class="form-control form-control-sm" readonly value="@_form.NameVi" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇻🇳 Description (Vi)</label>
                                    <input class="form-control form-control-sm" readonly value="@_form.DescriptionVi" />
                                </div>

                                @* English *@
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇺🇸 Name (En)</label>
                                    <input class="form-control form-control-sm" readonly value="@_form.NameEn" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇺🇸 Description (En)</label>
                                    <input class="form-control form-control-sm" readonly value="@_form.DescriptionEn" />
                                </div>

                                @* Chinese *@
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇨🇳 Name (Zh)</label>
                                    <input class="form-control form-control-sm" readonly value="@_form.NameZh" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇨🇳 Description (Zh)</label>
                                    <input class="form-control form-control-sm" readonly value="@_form.DescriptionZh" />
                                </div>

                                @* Korean *@
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇰🇷 Name (Ko)</label>
                                    <input class="form-control form-control-sm" readonly value="@_form.NameKo" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇰🇷 Description (Ko)</label>
                                    <input class="form-control form-control-sm" readonly value="@_form.DescriptionKo" />
                                </div>

                                @* Japanese *@
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇯🇵 Name (Ja)</label>
                                    <input class="form-control form-control-sm" readonly value="@_form.NameJa" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇯🇵 Description (Ja)</label>
                                    <input class="form-control form-control-sm" readonly value="@_form.DescriptionJa" />
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseEditor">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmModal Visible="_confirmDeleteVisible"
              Title="Delete POI"
              Message="This action cannot be undone."
              OnConfirm="DeleteConfirmedAsync"
              OnCancel="CancelDelete" />

@code {
    private readonly List<POI> _pois = [];
    private bool _isLoading;
    private bool _isEditorOpen;
    private bool _isEditing;
    private bool _isTranslating;
    private bool _confirmDeleteVisible;
    private int? _deleteId;
    private PoiFormViewModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            _pois.Clear();
            _pois.AddRange(DataService.GetPois());
        }
        catch
        {
            Toasts.Error("Failed to load POI list.");
        }
        finally
        {
            _isLoading = false;
        }

        return Task.CompletedTask;
    }

    private void StartCreate()
    {
        _isEditing = false;
        _form = new PoiFormViewModel { IsActive = true, RadiusMeters = 15 };
        _isEditorOpen = true;
    }

    private void StartEdit(POI poi)
    {
        _isEditing = true;
        _form = new PoiFormViewModel
        {
            Id = poi.Id,
            Name = poi.Name,
            Description = poi.Description,
            Latitude = poi.Latitude,
            Longitude = poi.Longitude,
            AudioUrl = poi.AudioUrl,
            IsActive = poi.IsActive,
            RadiusMeters = poi.RadiusMeters,
            Type = poi.Type,
            // Translation fields
            NameVi = poi.NameVi,
            NameEn = poi.NameEn,
            NameZh = poi.NameZh,
            NameKo = poi.NameKo,
            NameJa = poi.NameJa,
            DescriptionVi = poi.DescriptionVi,
            DescriptionEn = poi.DescriptionEn,
            DescriptionZh = poi.DescriptionZh,
            DescriptionKo = poi.DescriptionKo,
            DescriptionJa = poi.DescriptionJa
        };
        _isEditorOpen = true;
    }

    private Task SaveAsync()
    {
        try
        {
            var poi = new POI
            {
                Id = _form.Id,
                Name = _form.Name,
                Description = _form.Description,
                Latitude = _form.Latitude,
                Longitude = _form.Longitude,
                AudioUrl = _form.AudioUrl,
                IsActive = _form.IsActive,
                RadiusMeters = _form.RadiusMeters,
                Type = _form.Type,
                // Preserve translation fields
                NameVi = _form.NameVi,
                NameEn = _form.NameEn,
                NameZh = _form.NameZh,
                NameKo = _form.NameKo,
                NameJa = _form.NameJa,
                DescriptionVi = _form.DescriptionVi,
                DescriptionEn = _form.DescriptionEn,
                DescriptionZh = _form.DescriptionZh,
                DescriptionKo = _form.DescriptionKo,
                DescriptionJa = _form.DescriptionJa
            };

            if (_isEditing)
            {
                DataService.UpdatePoi(poi);
                Toasts.Success("POI updated.");
            }
            else
            {
                DataService.AddPoi(poi);
                Toasts.Success("POI created.");
            }

            _isEditorOpen = false;
            LoadAsync();
        }
        catch
        {
            Toasts.Error("Save POI failed.");
        }

        return Task.CompletedTask;
    }

    private async Task TranslateAsync()
    {
        if (_form.Id <= 0)
        {
            Toasts.Error("Please save the POI first before translating.");
            return;
        }

        try
        {
            _isTranslating = true;
            StateHasChanged();

            var translated = await DataService.TranslatePoiAsync(_form.Id);
            if (translated != null)
            {
                _form.NameVi = translated.NameVi;
                _form.NameEn = translated.NameEn;
                _form.NameZh = translated.NameZh;
                _form.NameKo = translated.NameKo;
                _form.NameJa = translated.NameJa;
                _form.DescriptionVi = translated.DescriptionVi;
                _form.DescriptionEn = translated.DescriptionEn;
                _form.DescriptionZh = translated.DescriptionZh;
                _form.DescriptionKo = translated.DescriptionKo;
                _form.DescriptionJa = translated.DescriptionJa;

                // Also refresh the list to show badges
                _pois.Clear();
                _pois.AddRange(DataService.GetPois());

                Toasts.Success("Translation completed successfully!");
            }
            else
            {
                Toasts.Error("POI not found or translation failed.");
            }
        }
        catch (Exception ex)
        {
            Toasts.Error($"Translation failed: {ex.Message}");
        }
        finally
        {
            _isTranslating = false;
            StateHasChanged();
        }
    }

    private Task ToggleActiveAsync(POI poi, ChangeEventArgs args)
    {
        var value = args.Value is bool b && b;
        try
        {
            poi.IsActive = value;
            DataService.UpdatePoi(poi);
            Toasts.Success("POI status updated.");
        }
        catch
        {
            Toasts.Error("Cannot update POI status.");
        }

        return Task.CompletedTask;
    }

    private void AskDelete(POI poi)
    {
        _deleteId = poi.Id;
        _confirmDeleteVisible = true;
    }

    private Task DeleteConfirmedAsync()
    {
        if (_deleteId is null)
        {
            _confirmDeleteVisible = false;
            return Task.CompletedTask;
        }

        try
        {
            DataService.DeletePoi(_deleteId.Value);
            Toasts.Success("POI deleted.");
            LoadAsync();
        }
        catch
        {
            Toasts.Error("Delete POI failed.");
        }
        finally
        {
            _confirmDeleteVisible = false;
            _deleteId = null;
        }

        return Task.CompletedTask;
    }

    private Task CancelDelete()
    {
        _confirmDeleteVisible = false;
        _deleteId = null;
        return Task.CompletedTask;
    }

    private async Task TranslatePoiAsync(POI poi)
    {
        try
        {
            _isTranslating = true;
            var translated = await DataService.TranslatePoiAsync(poi.Id);
            if (translated is null)
            {
                Toasts.Error("POI not found or translation failed.");
                return;
            }

            Toasts.Success("POI translated.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toasts.Error($"Translation failed: {ex.Message}");
        }
        finally
        {
            _isTranslating = false;
        }
    }

    private static int GetTranslationCount(POI poi)
    {
        var translated = new[] { poi.NameVi, poi.NameEn, poi.NameZh, poi.NameKo, poi.NameJa }
            .Count(x => !string.IsNullOrWhiteSpace(x));
        return Math.Max(0, translated - 1);
    }

    private void CloseEditor() => _isEditorOpen = false;

}
