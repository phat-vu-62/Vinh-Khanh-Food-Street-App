@page "/poi"
@inject IAdminDataService DataService
@inject ToastService Toasts
@inject IJSRuntime JS
@inject IConfiguration Configuration
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@using System.IO

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="h3 fw-bold mb-1">Quản lý địa điểm</h1>
        <p class="text-muted mb-0">Quản lý nội dung, tọa độ và bản dịch đa ngôn ngữ của các điểm tham quan.</p>
    </div>
    <button class="btn btn-saas btn-saas-primary shadow-sm" @onclick="StartCreate">
        <i class="bi bi-plus-lg"></i> Thêm địa điểm mới
    </button>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-4 mb-5">
    <div class="input-group" style="max-width:480px;">
        <span class="input-group-text bg-white border-end-0 rounded-start-2 shadow-sm"><i class="bi bi-search text-muted"></i></span>
        <input class="form-control border-start-0 rounded-end-2 shadow-sm" 
               placeholder="Tìm kiếm theo tên hoặc mô tả..." 
               @bind="_searchTerm" 
               @bind:event="oninput" 
               @bind:after="() => { _currentPage = 1; }" />
    </div>
    <div class="d-flex align-items-center gap-3">
        <span class="text-muted small">Hiển thị @GetPagedPois().Count() trên @GetFilteredPois().Count() mục</span>
        <div class="btn-group shadow-sm rounded-2 overflow-hidden">
            <button class="btn btn-saas btn-saas-secondary py-1 px-3 active border-0"><i class="bi bi-grid-fill"></i></button>
            <button class="btn btn-saas btn-saas-secondary py-1 px-3 border-0"><i class="bi bi-list"></i></button>
        </div>
    </div>
</div>

<LoadingState IsLoading="_isLoading" Message="Đang tải danh sách..." />

@if (!_isLoading && _pois.Count == 0)
{
    <div class="saas-card p-5 text-center border-0 shadow-sm">
        <i class="bi bi-geo-alt text-muted" style="font-size: 3rem;"></i>
        <h5 class="fw-bold mt-3">Chưa có địa điểm nào</h5>
        <p class="text-muted small">Hãy bắt đầu hành trình của bạn bằng cách tạo địa điểm đầu tiên.</p>
        <button class="btn btn-saas btn-saas-primary mt-3" @onclick="StartCreate">Bắt đầu ngay</button>
    </div>
}
else if (!_isLoading)
{
    <div class="row g-4">
        @foreach (var poi in GetPagedPois())
        {
            <div class="col-md-6 col-xl-4">
                <div class="saas-card gallery-card h-100 d-flex flex-column">
                    <div class="position-relative">
                        <img class="gallery-card-img" 
                             src="@(string.IsNullOrEmpty(poi.ImageUrl) ? $"https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=600&q=80&sig={poi.Id}" : poi.ImageUrl)" 
                             alt="@poi.Name" />
                        <div class="position-absolute top-0 end-0 p-2">
                            <span class="saas-badge @(poi.IsActive ? "badge-active" : "badge-inactive") shadow-sm">
                                @(poi.IsActive ? "● Active" : "○ Hidden")
                            </span>
                        </div>
                    </div>
                    
                    <div class="p-4 flex-grow-1 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 80%;">@poi.Name</h6>
                            <div class="dropdown">
                                <button class="btn btn-link link-muted p-0" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0">
                                    <li><button class="dropdown-item" @onclick="() => StartEdit(poi)"><i class="bi bi-pencil me-2"></i> Chỉnh sửa</button></li>
                                    <li><button class="dropdown-item" @onclick="() => ShowQrCode(poi)"><i class="bi bi-qr-code me-2"></i> Xuất mã QR</button></li>
                                    <li><button class="dropdown-item text-danger" @onclick="() => AskDelete(poi)"><i class="bi bi-trash me-2"></i> Xóa bỏ</button></li>
                                </ul>
                            </div>
                        </div>
                        
                        <p class="text-muted small mb-4 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 3.2em;">
                            @poi.Description
                        </p>

                        <div class="map-placeholder mb-4">
                            <svg width="60" height="60" viewBox="0 0 100 100" class="opacity-50">
                                <circle cx="50" cy="50" r="45" fill="none" stroke="currentColor" stroke-dasharray="2 4" />
                                <circle cx="50" cy="50" r="5" fill="var(--primary-color)" />
                                <text x="50" y="75" text-anchor="middle" font-size="8" fill="currentColor">@poi.Latitude.ToString("0.00"), @poi.Longitude.ToString("0.00")</text>
                            </svg>
                        </div>

                        <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                            <div class="d-flex gap-2">
                                <span class="saas-badge badge-highlight">
                                    <i class="bi bi-translate me-1"></i>@GetTranslationCount(poi)
                                </span>
                                <span class="small text-muted py-1">Ngôn ngữ</span>
                            </div>
                            <span class="small text-muted">ID: #@poi.Id</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (GetTotalPoiPages() > 1)
    {
        <div class="d-flex justify-content-center align-items-center mt-5 gap-3">
            <button class="btn btn-saas btn-saas-secondary" disabled="@(_currentPage <= 1)" @onclick="() => _currentPage--">
                <i class="bi bi-chevron-left"></i>
            </button>
            <span class="small fw-bold text-muted">Trang @_currentPage / @GetTotalPoiPages()</span>
            <button class="btn btn-saas btn-saas-secondary" disabled="@(_currentPage >= GetTotalPoiPages())" @onclick="() => _currentPage++">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    }
}

@if (_qrModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-4 text-center">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="modal-title fw-bold m-0"><i class="bi bi-qr-code text-orange"></i> Mã QR Địa điểm</h4>
                    <button type="button" class="btn-close" @onclick="() => _qrModalVisible = false"></button>
                </div>
                <h5 class="fw-bold text-dark">@_selectedPoiForQr?.Name</h5>
                <p class="text-muted small px-3">Quét mã này để khách tham quan nghe âm thanh giới thiệu ngay lập tức tại quán.</p>
                
                <div class="bg-light d-inline-block p-4 rounded-5 mb-4 border border-light shadow-inner" style="background: white !important;">
                     <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=@(Uri.EscapeDataString($"foodstreet://poi?id={_selectedPoiForQr?.Id}&play=true&skipGps=true"))" 
                          alt="QR Code" width="200" height="200" class="img-fluid" />
                </div>
                
                <div class="d-grid">
                     <a class="btn btn-modern btn-primary-f&b" href="/qr/@_selectedPoiForQr?.Id" target="_blank">Xem Link trực tiếp</a>
                     <button class="btn btn-link text-muted mt-2 text-decoration-none" @onclick="() => _qrModalVisible = false">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_isEditorOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(12px);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" style="max-width: 900px;">
            <EditForm Model="_form" OnValidSubmit="SaveAsync" class="h-100 w-100">
                <audio id="tts-audio-element" hidden></audio>
                <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; height: auto; max-height: 90vh;">
                    <DataAnnotationsValidator />
                    
                    <!-- Header -->
                    <div class="modal-header px-5 py-4 border-bottom bg-white">
                        <div>
                            <h4 class="fw-bold text-dark m-0">@(_isEditing ? "🖊️ Chỉnh sửa địa điểm" : "✨ Thêm địa điểm mới")</h4>
                            <p class="text-muted small mb-0">Cập nhật thông tin chi tiết và nội dung đa ngôn ngữ.</p>
                        </div>
                        <button type="button" class="btn-close" @onclick="CloseEditor"></button>
                    </div>

                    <div class="modal-body px-5 py-4">
                        
                        <!-- Section 1: Basic Information -->
                        <div class="modal-section pt-0">
                            <div class="modal-section-title"><i class="bi bi-info-circle"></i> Thông tin cơ bản</div>
                            <div class="row g-4">
                                <div class="col-md-5">
                                    <label class="form-label-saas">Hình ảnh đại diện</label>
                                    <div class="saas-dropzone position-relative overflow-hidden" style="height: 160px; display: flex; align-items: center; justify-content: center; flex-direction: column;">
                                        <InputFile OnChange="HandleImageSelected" class="position-absolute w-100 h-100 opacity-0" style="cursor: pointer; z-index: 2;" accept="image/*" />
                                        @if (!string.IsNullOrEmpty(_form.ImageBase64))
                                        {
                                            <img src="@_form.ImageBase64" class="position-absolute w-100 h-100" style="object-fit: cover; z-index: 1;" />
                                        }
                                        else if (!string.IsNullOrEmpty(_form.ImageUrl))
                                        {
                                            <img src="@_form.ImageUrl" class="position-absolute w-100 h-100" style="object-fit: cover; z-index: 1;" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-cloud-arrow-up text-primary fs-2 mb-2 d-inline-block"></i>
                                            <p class="small text-muted mb-0">Nhấn để chọn ảnh</p>
                                            <p class="x-small text-light">PNG, JPG (Tối đa 5MB)</p>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-7">
                                    <div class="mb-4">
                                        <label class="form-label-saas">Tên địa điểm</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-tag text-muted"></i></span>
                                            <InputText class="form-control form-control-saas border-start-0" @bind-Value="_form.Name" placeholder="Ví dụ: Ốc Oanh Vinh Khánh" />
                                        </div>
                                        <ValidationMessage For="@(() => _form.Name)" class="text-danger small mt-1" />
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label-saas">Mô tả ngắn</label>
                                        <InputText class="form-control form-control-saas" @bind-Value="_form.Description" placeholder="Tóm tắt nét đặc sắc của địa điểm..." />
                                        <ValidationMessage For="@(() => _form.Description)" class="text-danger small mt-1" />
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3">
                                        <div>
                                            <div class="fw-bold small">Trạng thái hoạt động</div>
                                            <div class="text-muted x-small">Địa điểm sẽ hiển thị với khách du lịch</div>
                                        </div>
                                        <div class="form-check form-switch ps-0">
                                            <InputCheckbox class="form-check-input" style="width: 3em; height: 1.5em; cursor: pointer;" id="isActiveCheck" @bind-Value="_form.IsActive" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Section 2: Audio & Narration -->
                        <div class="modal-section">
                            <div class="modal-section-title"><i class="bi bi-mic"></i> Âm thanh & Thuyết minh</div>
                            <div class="mb-4">
                                <label class="form-label-saas">Nguồn âm thanh</label>
                                <div class="saas-toggle-group">
                                    <button type="button" class="saas-toggle-btn @(_form.AudioMode == AudioSourceMode.File ? "active" : "")" 
                                            @onclick="() => _form.AudioMode = AudioSourceMode.File">
                                        <i class="bi bi-file-earmark-music me-1"></i> Tải lên File
                                    </button>
                                    <button type="button" class="saas-toggle-btn @(_form.AudioMode == AudioSourceMode.TTS ? "active" : "")" 
                                            @onclick="() => _form.AudioMode = AudioSourceMode.TTS">
                                        <i class="bi bi-chat-text me-1"></i> Sử dụng AI (TTS)
                                    </button>
                                </div>
                            </div>

                            @if (_form.AudioMode == AudioSourceMode.File)
                            {
                                <div class="p-4 border rounded-3 bg-light">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="flex-grow-1">
                                            <label class="form-label small fw-bold text-muted mb-1">Đường dẫn file (URL)</label>
                                            <InputText class="form-control form-control-sm" @bind-Value="_form.AudioUrl" placeholder="https://storage.google.com/..." />
                                        </div>
                                        <div class="pt-3">
                                            <button type="button" class="btn btn-saas btn-saas-secondary btn-sm" title="Nghe thử"><i class="bi bi-play-fill"></i></button>
                                        </div>
                                    </div>
                                    <div class="mt-2 x-small text-muted"><i class="bi bi-info-circle me-1"></i> Hỗ trợ định dạng MP3, AAC, OGG.</div>
                                </div>
                            }
                            else
                            {
                                <div class="p-4 border rounded-3 bg-light">
                                    <label class="form-label small fw-bold text-muted mb-1">Nội dung thuyết minh (Tiếng Việt)</label>
                                    <InputTextArea id="narration-text" class="form-control form-control-sm" rows="3" @bind-Value="_form.TextContent" placeholder="Nhập nội dung để AI tự động chuyển thành giọng nói..." />
                                    <div class="mt-2 d-flex justify-content-between align-items-center">
                                        <div class="x-small text-muted"><i class="bi bi-stars me-1"></i> Giọng đọc: Nam/Nữ miền Nam</div>
                                        <button type="button" class="btn btn-link p-0 text-decoration-none x-small fw-bold" onclick="triggerPremiumTts()">Nghe thử với AI</button>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Section 3: Location & Map -->
                        <div class="modal-section">
                            <div class="modal-section-title"><i class="bi bi-geo-alt"></i> Vị trí & Tọa độ</div>
                            <div class="row g-4">
                                <div class="col-md-8">
                                    <div id="map-picker-container" class="shadow-inner rounded-3 border" style="height: 300px; z-index: 1;">
                                        <!-- Leaflet map will be initialized here -->
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label-saas">Vĩ độ (Latitude)</label>
                                        <div class="input-group">
                                            <InputNumber class="form-control form-control-saas bg-white" @bind-Value="_form.Latitude" step="any" @bind-Value:after="SyncManualCoordinatesToMap" />
                                            <button class="btn btn-outline-secondary btn-sm border-start-0" type="button" @onclick="SyncManualCoordinatesToMap" title="Cập nhật bản đồ"><i class="bi bi-arrow-repeat"></i></button>
                                        </div>
                                        <ValidationMessage For="@(() => _form.Latitude)" class="text-danger small mt-1" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label-saas">Kinh độ (Longitude)</label>
                                        <div class="input-group">
                                            <InputNumber class="form-control form-control-saas bg-white" @bind-Value="_form.Longitude" step="any" @bind-Value:after="SyncManualCoordinatesToMap" />
                                            <button class="btn btn-outline-secondary btn-sm border-start-0" type="button" @onclick="SyncManualCoordinatesToMap" title="Cập nhật bản đồ"><i class="bi bi-arrow-repeat"></i></button>
                                        </div>
                                        <ValidationMessage For="@(() => _form.Longitude)" class="text-danger small mt-1" />
                                    </div>
                                    <div class="p-3 bg-secondary bg-opacity-10 rounded-3">
                                        <p class="x-small text-muted mb-0"><b>Gợi ý:</b> Nhấp vào bản đồ để chọn tọa độ chính xác, hoặc nhập tay và nhấn biểu tượng xoay để đồng bộ.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Section 4: Translations -->
                        <div class="modal-section border-0">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="modal-section-title mb-0"><i class="bi bi-translate"></i> Bản dịch đa ngôn ngữ</div>
                                <button type="button" class="btn btn-saas btn-saas-secondary btn-sm" @onclick="TranslateInEditorAsync" disabled="@_isTranslating">
                                    @if (_isTranslating) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                    <i class="bi bi-stars"></i> Tự động dịch AI (Tất cả)
                                </button>
                            </div>

                            <div class="saas-tabs">
                                <button type="button" class="saas-tab-item @(_activeTab == "en" ? "active" : "")" @onclick='() => _activeTab = "en"'>🇺🇸 Tiếng Anh</button>
                                <button type="button" class="saas-tab-item @(_activeTab == "zh" ? "active" : "")" @onclick='() => _activeTab = "zh"'>🇨🇳 Tiếng Trung</button>
                                <button type="button" class="saas-tab-item @(_activeTab == "ko" ? "active" : "")" @onclick='() => _activeTab = "ko"'>🇰🇷 Tiếng Hàn</button>
                                <button type="button" class="saas-tab-item @(_activeTab == "ja" ? "active" : "")" @onclick='() => _activeTab = "ja"'>🇯🇵 Tiếng Nhật</button>
                            </div>

                            <div class="p-4 border rounded-4 bg-white shadow-sm">
                                @if (_activeTab == "en")
                                {
                                    <div class="mb-3">
                                        <label class="form-label-saas">Tên địa điểm (EN)</label>
                                        <InputText class="form-control form-control-saas" @bind-Value="_form.NameEn" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label-saas">Mô tả (EN)</label>
                                        <InputText class="form-control form-control-saas" @bind-Value="_form.DescriptionEn" />
                                    </div>
                                    <div>
                                        <label class="form-label-saas">Nội dung thuyết minh (EN)</label>
                                        <InputTextArea class="form-control form-control-saas" rows="2" @bind-Value="_form.TextContentEn" />
                                    </div>
                                }
                                else if (_activeTab == "zh")
                                {
                                    <div class="mb-3">
                                        <label class="form-label-saas">Tên địa điểm (ZH)</label>
                                        <InputText class="form-control form-control-saas" @bind-Value="_form.NameZh" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label-saas">Mô tả (ZH)</label>
                                        <InputText class="form-control form-control-saas" @bind-Value="_form.DescriptionZh" />
                                    </div>
                                    <div>
                                        <label class="form-label-saas">Nội dung thuyết minh (ZH)</label>
                                        <InputTextArea class="form-control form-control-saas" rows="2" @bind-Value="_form.TextContentZh" />
                                    </div>
                                }
                                else if (_activeTab == "ko")
                                {
                                    <div class="mb-3">
                                        <label class="form-label-saas">Tên địa điểm (KO)</label>
                                        <InputText class="form-control form-control-saas" @bind-Value="_form.NameKo" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label-saas">Mô tả (KO)</label>
                                        <InputText class="form-control form-control-saas" @bind-Value="_form.DescriptionKo" />
                                    </div>
                                    <div>
                                        <label class="form-label-saas">Nội dung thuyết minh (KO)</label>
                                        <InputTextArea class="form-control form-control-saas" rows="2" @bind-Value="_form.TextContentKo" />
                                    </div>
                                }
                                else
                                {
                                    <div class="mb-3">
                                        <label class="form-label-saas">Tên địa điểm (JA)</label>
                                        <InputText class="form-control form-control-saas" @bind-Value="_form.NameJa" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label-saas">Mô tả (JA)</label>
                                        <InputText class="form-control form-control-saas" @bind-Value="_form.DescriptionJa" />
                                    </div>
                                    <div>
                                        <label class="form-label-saas">Nội dung thuyết minh (JA)</label>
                                        <InputTextArea class="form-control form-control-saas" rows="2" @bind-Value="_form.TextContentJa" />
                                    </div>
                                }
                            </div>
                        </div>

                    </div>

                    <!-- Footer -->
                    <div class="modal-footer border-0 px-5 py-4 bg-light bg-opacity-50">
                        <button type="button" class="btn btn-saas btn-saas-secondary px-4 py-2" @onclick="CloseEditor">Hủy bỏ</button>
                        <button type="submit" class="btn btn-saas btn-saas-primary px-5 py-2 shadow-sm" disabled="@_isLoadingSave">
                            @if (_isLoadingSave) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            <i class="bi bi-check-lg"></i> Lưu địa điểm
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

<ConfirmModal Visible="_confirmDeleteVisible"
              Title="Xóa địa điểm"
              Message="Hành động này không thể hoàn tác. Bạn có chắc chắn muốn xóa vĩnh viễn địa điểm này?"
              OnConfirm="DeleteConfirmedAsync"
              OnCancel="CancelDelete" />

@code {
    private readonly List<POI> _pois = [];
    private bool _isLoading;
    private bool _isEditorOpen;
    private bool _isEditing;
    private bool _isTranslating;
    private bool _isLoadingSave;
    private string _activeTab = "en";
    private bool _confirmDeleteVisible;
    private bool _qrModalVisible;
    private POI? _selectedPoiForQr;
    private int? _deleteId;
    private PoiFormViewModel _form = new();
    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private bool _mapInitialized;

    private IEnumerable<POI> GetFilteredPois()
    {
        var q = _pois.OrderByDescending(x => x.Id).AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            q = q.Where(p => (p.Name ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)
                          || (p.Description ?? "").Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        return q;
    }

    private IEnumerable<POI> GetPagedPois() => GetFilteredPois().Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    private int GetTotalPoiPages() => (int)Math.Ceiling((double)GetFilteredPois().Count() / _pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var apiKey = Environment.GetEnvironmentVariable("GEMINI_API_KEY") 
                         ?? Configuration["Gemini:ApiKey"];
            await JS.InvokeVoidAsync("eval", $"window.CMS_CONFIG = {{ apiKey: '{apiKey}' }};");
        }

        if (_isEditorOpen && !_mapInitialized)
        {
            _mapInitialized = true;
            await Task.Delay(500); // Wait for modal animation
            await JS.InvokeVoidAsync("initMapPicker", DotNetObjectReference.Create(this), _form.Latitude, _form.Longitude);
        }
    }

    private Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            _pois.Clear();
            _pois.AddRange(DataService.GetPois());
        }
        catch
        {
            Toasts.Error("Không thể tải danh sách địa điểm.");
        }
        finally
        {
            _isLoading = false;
        }

        return Task.CompletedTask;
    }

    private void StartCreate()
    {
        _isEditing = false;
        _activeTab = "en";
        _mapInitialized = false;
        _form = new PoiFormViewModel 
        { 
            IsActive = true, 
            RadiusMeters = 15,
            AudioMode = AudioSourceMode.File
        };
        _isEditorOpen = true;
    }

    private void StartEdit(POI poi)
    {
        _isEditing = true;
        _activeTab = "en";
        _mapInitialized = false;
        _form = new PoiFormViewModel
        {
            Id = poi.Id,
            Name = poi.Name,
            Description = poi.Description,
            Latitude = poi.Latitude,
            Longitude = poi.Longitude,
            AudioUrl = poi.AudioUrl,
            IsActive = poi.IsActive,
            RadiusMeters = poi.RadiusMeters,
            Type = poi.Type,
            AudioMode = string.IsNullOrEmpty(poi.AudioUrl) && !string.IsNullOrEmpty(poi.TextContent) 
                         ? AudioSourceMode.TTS : AudioSourceMode.File,
            ImageUrl = poi.ImageUrl,
            // Translation fields
            NameVi = poi.NameVi,
            NameEn = poi.NameEn,
            NameZh = poi.NameZh,
            NameKo = poi.NameKo,
            NameJa = poi.NameJa,
            DescriptionVi = poi.DescriptionVi,
            DescriptionEn = poi.DescriptionEn,
            DescriptionZh = poi.DescriptionZh,
            DescriptionKo = poi.DescriptionKo,
            DescriptionJa = poi.DescriptionJa,
            TextContent = poi.TextContent,
            TextContentVi = poi.TextContentVi,
            TextContentEn = poi.TextContentEn,
            TextContentZh = poi.TextContentZh,
            TextContentKo = poi.TextContentKo,
            TextContentJa = poi.TextContentJa
        };
        _isEditorOpen = true;
    }

    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            try 
            {
                var format = "image/png";
                // Resize to 300x300 to reduce memory and SignalR traffic
                var resizedImage = await file.RequestImageFileAsync(format, 300, 300);
                
                using var ms = new MemoryStream();
                await resizedImage.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5).CopyToAsync(ms);
                var buffer = ms.ToArray();
                
                _form.ImageBase64 = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
                Toasts.Success("Đã tải ảnh lên thành công! ✨");
            }
            catch (Exception ex)
            {
                Toasts.Error("Lỗi khi xử lý ảnh. Vui lòng thử lại.");
                Console.WriteLine(ex.Message);
            }
        }
    }

    private async Task PreviewTtsAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.TextContent))
        {
            Toasts.Info("Vui lòng nhập nội dung để nghe thử.");
            return;
        }

        Toasts.Info("Đang khởi tạo giọng đọc AI (Standard-A)... 🎙️");
        
        var apiKey = Environment.GetEnvironmentVariable("GEMINI_API_KEY") 
                     ?? Configuration["Gemini:ApiKey"];

        // Final Premium Fix: Official Google Cloud TTS with Intelligent Fallback
        await JS.InvokeVoidAsync("playPremiumTts", _form.TextContent, "vi-VN-Standard-A", apiKey);
    }

