@page "/poi"
@inject IAdminDataService DataService
@inject ToastService Toasts

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="h3 fw-bold mb-1">Quản lý địa điểm</h1>
        <p class="text-muted mb-0">Quản lý nội dung, tọa độ và bản dịch đa ngôn ngữ của các điểm tham quan.</p>
    </div>
    <button class="btn btn-saas btn-saas-primary shadow-sm" @onclick="StartCreate">
        <i class="bi bi-plus-lg"></i> Thêm địa điểm mới
    </button>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-4 mb-5">
    <div class="input-group" style="max-width:480px;">
        <span class="input-group-text bg-white border-end-0 rounded-start-2 shadow-sm"><i class="bi bi-search text-muted"></i></span>
        <input class="form-control border-start-0 rounded-end-2 shadow-sm" 
               placeholder="Tìm kiếm theo tên hoặc mô tả..." 
               @bind="_searchTerm" 
               @bind:event="oninput" 
               @bind:after="() => { _currentPage = 1; }" />
    </div>
    <div class="d-flex align-items-center gap-3">
        <span class="text-muted small">Hiển thị @GetPagedPois().Count() trên @GetFilteredPois().Count() mục</span>
        <div class="btn-group shadow-sm rounded-2 overflow-hidden">
            <button class="btn btn-saas btn-saas-secondary py-1 px-3 active border-0"><i class="bi bi-grid-fill"></i></button>
            <button class="btn btn-saas btn-saas-secondary py-1 px-3 border-0"><i class="bi bi-list"></i></button>
        </div>
    </div>
</div>

<LoadingState IsLoading="_isLoading" Message="Đang tải danh sách..." />

@if (!_isLoading && _pois.Count == 0)
{
    <div class="saas-card p-5 text-center border-0 shadow-sm">
        <i class="bi bi-geo-alt text-muted" style="font-size: 3rem;"></i>
        <h5 class="fw-bold mt-3">Chưa có địa điểm nào</h5>
        <p class="text-muted small">Hãy bắt đầu hành trình của bạn bằng cách tạo địa điểm đầu tiên.</p>
        <button class="btn btn-saas btn-saas-primary mt-3" @onclick="StartCreate">Bắt đầu ngay</button>
    </div>
}
else if (!_isLoading)
{
    <div class="row g-4">
        @foreach (var poi in GetPagedPois())
        {
            <div class="col-md-6 col-xl-4">
                <div class="saas-card gallery-card h-100 d-flex flex-column">
                    <div class="position-relative">
                        <img class="gallery-card-img" 
                             src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=600&q=80&sig=@poi.Id" 
                             alt="@poi.Name" />
                        <div class="position-absolute top-0 end-0 p-2">
                            <span class="saas-badge @(poi.IsActive ? "badge-active" : "badge-inactive") shadow-sm">
                                @(poi.IsActive ? "● Active" : "○ Hidden")
                            </span>
                        </div>
                    </div>
                    
                    <div class="p-4 flex-grow-1 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 80%;">@poi.Name</h6>
                            <div class="dropdown">
                                <button class="btn btn-link link-muted p-0" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0">
                                    <li><button class="dropdown-item" @onclick="() => StartEdit(poi)"><i class="bi bi-pencil me-2"></i> Chỉnh sửa</button></li>
                                    <li><button class="dropdown-item" @onclick="() => ShowQrCode(poi)"><i class="bi bi-qr-code me-2"></i> Xuất mã QR</button></li>
                                    <li><button class="dropdown-item text-danger" @onclick="() => AskDelete(poi)"><i class="bi bi-trash me-2"></i> Xóa bỏ</button></li>
                                </ul>
                            </div>
                        </div>
                        
                        <p class="text-muted small mb-4 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 3.2em;">
                            @poi.Description
                        </p>

                        <div class="map-placeholder mb-4">
                            <svg width="60" height="60" viewBox="0 0 100 100" class="opacity-50">
                                <circle cx="50" cy="50" r="45" fill="none" stroke="currentColor" stroke-dasharray="2 4" />
                                <circle cx="50" cy="50" r="5" fill="var(--primary-color)" />
                                <text x="50" y="75" text-anchor="middle" font-size="8" fill="currentColor">@poi.Latitude.ToString("0.00"), @poi.Longitude.ToString("0.00")</text>
                            </svg>
                        </div>

                        <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                            <div class="d-flex gap-2">
                                <span class="saas-badge badge-highlight">
                                    <i class="bi bi-translate me-1"></i>@GetTranslationCount(poi)
                                </span>
                                <span class="small text-muted py-1">Ngôn ngữ</span>
                            </div>
                            <span class="small text-muted">ID: #@poi.Id</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (GetTotalPoiPages() > 1)
    {
        <div class="d-flex justify-content-center align-items-center mt-5 gap-3">
            <button class="btn btn-saas btn-saas-secondary" disabled="@(_currentPage <= 1)" @onclick="() => _currentPage--">
                <i class="bi bi-chevron-left"></i>
            </button>
            <span class="small fw-bold text-muted">Trang @_currentPage / @GetTotalPoiPages()</span>
            <button class="btn btn-saas btn-saas-secondary" disabled="@(_currentPage >= GetTotalPoiPages())" @onclick="() => _currentPage++">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    }
}

@if (_qrModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-4 text-center">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="modal-title fw-bold m-0"><i class="bi bi-qr-code text-orange"></i> Mã QR Địa điểm</h4>
                    <button type="button" class="btn-close" @onclick="() => _qrModalVisible = false"></button>
                </div>
                <h5 class="fw-bold text-dark">@_selectedPoiForQr?.Name</h5>
                <p class="text-muted small px-3">Quét mã này để khách tham quan nghe âm thanh giới thiệu ngay lập tức tại quán.</p>
                
                <div class="bg-light d-inline-block p-4 rounded-5 mb-4 border border-light shadow-inner" style="background: white !important;">
                     <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=@(Uri.EscapeDataString($"foodstreet://poi?id={_selectedPoiForQr?.Id}&play=true&skipGps=true"))" 
                          alt="QR Code" width="200" height="200" class="img-fluid" />
                </div>
                
                <div class="d-grid">
                     <a class="btn btn-modern btn-primary-f&b" href="/qr/@_selectedPoiForQr?.Id" target="_blank">Xem Link trực tiếp</a>
                     <button class="btn btn-link text-muted mt-2 text-decoration-none" @onclick="() => _qrModalVisible = false">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_isEditorOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8px);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content overflow-hidden">
                <EditForm Model="_form" OnValidSubmit="SaveAsync">
                    <div class="modal-header bg-light border-0 py-3 px-4">
                        <h4 class="modal-title fw-bold text-dark">@(_isEditing ? "🖊️ Chỉnh sửa địa điểm" : "✨ Thêm địa điểm mới")</h4>
                        <button type="button" class="btn-close" @onclick="CloseEditor"></button>
                    </div>
                    <div class="modal-body p-4">
                        <DataAnnotationsValidator />
                        <div class="alert alert-info border-0 rounded-4 d-flex align-items-center gap-3 mb-4">
                            <i class="bi bi-info-circle-fill fs-4 text-primary"></i>
                            <div class="small">
                                <b>Lưu ý:</b> Nhập thông tin tiếng Việt ở phần nội dung chính, sau đó dùng công cụ <b>Dịch tự động</b> để hỗ trợ các ngôn ngữ khách du lịch.
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Tên địa điểm (Tiếng Việt)</label>
                                <InputText class="form-control" @bind-Value="_form.Name" placeholder="Ví dụ: Ốc Oanh, Lẩu bò..." />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Link Âm thanh (Audio URL)</label>
                                <InputText class="form-control" @bind-Value="_form.AudioUrl" placeholder="https://..." />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Mô tả ngắn gọn</label>
                                <InputText class="form-control" @bind-Value="_form.Description" placeholder="Mẹo: Viết ngắn gọn về đặc sản của quán..." />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Nội dung thuyết minh (TTS)</label>
                                <InputTextArea class="form-control" rows="3" @bind-Value="_form.TextContent" placeholder="Nội dung này sẽ được AI đọc lên cho khách nghe..." />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold"><i class="bi bi-pin-map me-1"></i>Vĩ độ (Latitude)</label>
                                <InputNumber class="form-control" @bind-Value="_form.Latitude" step="any" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold"><i class="bi bi-pin-map-fill me-1"></i>Kinh độ (Longitude)</label>
                                <InputNumber class="form-control" @bind-Value="_form.Longitude" step="any" />
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch mt-2">
                                    <InputCheckbox class="form-check-input" id="isActiveCheck" @bind-Value="_form.IsActive" />
                                    <label class="form-check-label fw-bold" for="isActiveCheck">Trạng thái hoạt động</label>
                                </div>
                            </div>
                        </div>

                        @if (_isEditing)
                        {
                            <div class="mt-5 p-4 rounded-4 border bg-light">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h5 class="fw-bold mb-0 text-orange">
                                        <i class="bi bi-translate"></i> Bản dịch đa ngôn ngữ
                                    </h5>
                                    <button type="button" class="btn btn-modern btn-outline-primary bg-white shadow-sm" disabled="@_isTranslating" @onclick="TranslateInEditorAsync">
                                        @if (_isTranslating)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            <span>Đang dịch AI...</span>
                                        }
                                        else
                                        {
                                            <span><i class="bi bi-stars me-1 text-warning"></i> AI Dịch tự động</span>
                                        }
                                    </button>
                                </div>

                                <div class="row g-4">
                                    <!-- English -->
                                    <div class="col-12 border-bottom pb-3">
                                        <div class="row g-3">
                                            <div class="col-md-4"><label class="form-label small text-muted">🇺🇸 Tên (English)</label><InputText class="form-control form-control-sm" @bind-Value="_form.NameEn" /></div>
                                            <div class="col-md-8"><label class="form-label small text-muted">🇺🇸 Mô tả (English)</label><InputText class="form-control form-control-sm" @bind-Value="_form.DescriptionEn" /></div>
                                            <div class="col-12"><label class="form-label small text-muted">🇺🇸 Nội dung thuyết minh (English)</label><InputTextArea class="form-control form-control-sm" rows="1" @bind-Value="_form.TextContentEn" /></div>
                                        </div>
                                    </div>
                                    <!-- Chinese -->
                                    <div class="col-12 border-bottom pb-3">
                                        <div class="row g-3">
                                            <div class="col-md-4"><label class="form-label small text-muted">🇨🇳 Tên (Chinese)</label><InputText class="form-control form-control-sm" @bind-Value="_form.NameZh" /></div>
                                            <div class="col-md-8"><label class="form-label small text-muted">🇨🇳 Mô tả (Chinese)</label><InputText class="form-control form-control-sm" @bind-Value="_form.DescriptionZh" /></div>
                                        </div>
                                    </div>
                                    <!-- Korean -->
                                    <div class="col-12 border-bottom pb-3">
                                        <div class="row g-3">
                                            <div class="col-md-4"><label class="form-label small text-muted">🇰🇷 Tên (Korean)</label><InputText class="form-control form-control-sm" @bind-Value="_form.NameKo" /></div>
                                            <div class="col-md-8"><label class="form-label small text-muted">🇰🇷 Mô tả (Korean)</label><InputText class="form-control form-control-sm" @bind-Value="_form.DescriptionKo" /></div>
                                        </div>
                                    </div>
                                    <!-- Japanese -->
                                    <div class="col-12">
                                        <div class="row g-3">
                                            <div class="col-md-4"><label class="form-label small text-muted">🇯🇵 Tên (Japanese)</label><InputText class="form-control form-control-sm" @bind-Value="_form.NameJa" /></div>
                                            <div class="col-md-8"><label class="form-label small text-muted">🇯🇵 Mô tả (Japanese)</label><InputText class="form-control form-control-sm" @bind-Value="_form.DescriptionJa" /></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer border-0 p-4 pt-0">
                        <button type="button" class="btn btn-modern btn-light" @onclick="CloseEditor">Hủy bỏ</button>
                        <button type="submit" class="btn btn-modern btn-primary-f&b px-4">Lưu địa điểm</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmModal Visible="_confirmDeleteVisible"
              Title="Xóa địa điểm"
              Message="Hành động này không thể hoàn tác. Bạn có chắc chắn muốn xóa vĩnh viễn địa điểm này?"
              OnConfirm="DeleteConfirmedAsync"
              OnCancel="CancelDelete" />

@code {
    private readonly List<POI> _pois = [];
    private bool _isLoading;
    private bool _isEditorOpen;
    private bool _isEditing;
    private bool _isTranslating;
    private bool _confirmDeleteVisible;
    private bool _qrModalVisible;
    private POI? _selectedPoiForQr;
    private int? _deleteId;
    private PoiFormViewModel _form = new();
    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 10;

    private IEnumerable<POI> GetFilteredPois()
    {
        var q = _pois.OrderByDescending(x => x.Id).AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            q = q.Where(p => (p.Name ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)
                          || (p.Description ?? "").Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        return q;
    }

    private IEnumerable<POI> GetPagedPois() => GetFilteredPois().Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    private int GetTotalPoiPages() => (int)Math.Ceiling((double)GetFilteredPois().Count() / _pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            _pois.Clear();
            _pois.AddRange(DataService.GetPois());
        }
        catch
        {
            Toasts.Error("Failed to load POI list.");
        }
        finally
        {
            _isLoading = false;
        }

        return Task.CompletedTask;
    }

    private void StartCreate()
    {
        _isEditing = false;
        _form = new PoiFormViewModel { IsActive = true, RadiusMeters = 15 };
        _isEditorOpen = true;
    }

    private void StartEdit(POI poi)
    {
        _isEditing = true;
        _form = new PoiFormViewModel
        {
            Id = poi.Id,
            Name = poi.Name,
            Description = poi.Description,
            Latitude = poi.Latitude,
            Longitude = poi.Longitude,
            AudioUrl = poi.AudioUrl,
            IsActive = poi.IsActive,
            RadiusMeters = poi.RadiusMeters,
            Type = poi.Type,
            // Translation fields
            NameVi = poi.NameVi,
            NameEn = poi.NameEn,
            NameZh = poi.NameZh,
            NameKo = poi.NameKo,
            NameJa = poi.NameJa,
            DescriptionVi = poi.DescriptionVi,
            DescriptionEn = poi.DescriptionEn,
            DescriptionZh = poi.DescriptionZh,
            DescriptionKo = poi.DescriptionKo,
            DescriptionJa = poi.DescriptionJa,
            TextContent = poi.TextContent,
            TextContentVi = poi.TextContentVi,
            TextContentEn = poi.TextContentEn,
            TextContentZh = poi.TextContentZh,
            TextContentKo = poi.TextContentKo,
            TextContentJa = poi.TextContentJa
        };
        _isEditorOpen = true;
    }

    private void ShowQrCode(POI poi)
    {
        _selectedPoiForQr = poi;
        _qrModalVisible = true;
    }

    private Task SaveAsync()
    {
        try
        {
            var poi = new POI
            {
                Id = _form.Id,
                Name = _form.Name,
                Description = _form.Description,
                Latitude = _form.Latitude,
                Longitude = _form.Longitude,
                AudioUrl = _form.AudioUrl,
                IsActive = _form.IsActive,
                RadiusMeters = _form.RadiusMeters,
                Type = _form.Type,
                // Preserve translation fields
                NameVi = _form.NameVi,
                NameEn = _form.NameEn,
                NameZh = _form.NameZh,
                NameKo = _form.NameKo,
                NameJa = _form.NameJa,
                DescriptionVi = _form.DescriptionVi,
                DescriptionEn = _form.DescriptionEn,
                DescriptionZh = _form.DescriptionZh,
                DescriptionKo = _form.DescriptionKo,
                DescriptionJa = _form.DescriptionJa,
                TextContent = _form.TextContent,
                TextContentVi = _form.TextContentVi,
                TextContentEn = _form.TextContentEn,
                TextContentZh = _form.TextContentZh,
                TextContentKo = _form.TextContentKo,
                TextContentJa = _form.TextContentJa
            };

            if (_isEditing)
            {
                DataService.UpdatePoi(poi);
                Toasts.Success("POI updated.");
            }
            else
            {
                DataService.AddPoi(poi);
                Toasts.Success("POI created.");
            }

            _isEditorOpen = false;
            LoadAsync();
        }
        catch
        {
            Toasts.Error("Save POI failed.");
        }

        return Task.CompletedTask;
    }

    private async Task TranslateInEditorAsync()
    {
        if (_form.Id <= 0)
        {
            Toasts.Error("Please save the POI first before translating.");
            return;
        }

        try
        {
            _isTranslating = true;
            StateHasChanged();

            var translated = await DataService.TranslatePoiAsync(_form.Id);
            if (translated != null)
            {
                _form.NameVi = translated.NameVi;
                _form.NameEn = translated.NameEn;
                _form.NameZh = translated.NameZh;
                _form.NameKo = translated.NameKo;
                _form.NameJa = translated.NameJa;
                _form.DescriptionVi = translated.DescriptionVi;
                _form.DescriptionEn = translated.DescriptionEn;
                _form.DescriptionZh = translated.DescriptionZh;
                _form.DescriptionKo = translated.DescriptionKo;
                _form.DescriptionJa = translated.DescriptionJa;
                
                _form.TextContentVi = translated.TextContentVi;
                _form.TextContentEn = translated.TextContentEn;
                _form.TextContentZh = translated.TextContentZh;
                _form.TextContentKo = translated.TextContentKo;
                _form.TextContentJa = translated.TextContentJa;

                Toasts.Success("Dịch tự động thành công!");
                _pois.Clear();
                _pois.AddRange(DataService.GetPois());
            }
            // Error toast is handled by the service
        }
        finally
        {
            _isTranslating = false;
            StateHasChanged();
        }
    }

    private Task ToggleActiveAsync(POI poi, ChangeEventArgs args)
    {
        var value = args.Value is bool b && b;
        try
        {
            poi.IsActive = value;
            DataService.UpdatePoi(poi);
            Toasts.Success("POI status updated.");
        }
        catch
        {
            Toasts.Error("Cannot update POI status.");
        }

        return Task.CompletedTask;
    }

    private void AskDelete(POI poi)
    {
        _deleteId = poi.Id;
        _confirmDeleteVisible = true;
    }

    private Task DeleteConfirmedAsync()
    {
        if (_deleteId is null)
        {
            _confirmDeleteVisible = false;
            return Task.CompletedTask;
        }

        try
        {
            DataService.DeletePoi(_deleteId.Value);
            Toasts.Success("POI deleted.");
            LoadAsync();
        }
        catch
        {
            Toasts.Error("Delete POI failed.");
        }
        finally
        {
            _confirmDeleteVisible = false;
            _deleteId = null;
        }

        return Task.CompletedTask;
    }

    private Task CancelDelete()
    {
        _confirmDeleteVisible = false;
        _deleteId = null;
        return Task.CompletedTask;
    }

    private async Task TranslatePoiSingleAsync(POI poi)
    {
        try
        {
            _isTranslating = true;
            var translated = await DataService.TranslatePoiAsync(poi.Id);
            if (translated != null)
            {
                Toasts.Success("Dịch tự động thành công!");
                await LoadAsync();
            }
            // Error toast is already triggered by GeminiTranslationService
        }
        finally
        {
            _isTranslating = false;
        }
    }

    private static int GetTranslationCount(POI poi)
    {
        var translated = new[] { poi.NameVi, poi.NameEn, poi.NameZh, poi.NameKo, poi.NameJa }
            .Count(x => !string.IsNullOrWhiteSpace(x));
        return Math.Max(0, translated - 1);
    }

    private void CloseEditor() => _isEditorOpen = false;

}
