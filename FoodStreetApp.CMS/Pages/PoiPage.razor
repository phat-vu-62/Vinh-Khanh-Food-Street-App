    private async Task SaveAsync()
    {
        try
        {
            _isLoadingSave = true;
            await Task.Delay(800); // Simulate network lag for smoother SaaS UX

            var poi = new POI
            {
                Id = _form.Id,
                Name = _form.Name,
                Description = _form.Description,
                Latitude = _form.Latitude,
                Longitude = _form.Longitude,
                AudioUrl = _form.AudioMode == AudioSourceMode.File ? _form.AudioUrl : null,
                IsActive = _form.IsActive,
                RadiusMeters = _form.RadiusMeters,
                Type = _form.Type,
                TextContent = _form.TextContent,
                // Preserve translation fields
                NameVi = _form.NameVi,
                NameEn = _form.NameEn,
                NameZh = _form.NameZh,
                NameKo = _form.NameKo,
                NameJa = _form.NameJa,
                DescriptionVi = _form.DescriptionVi,
                DescriptionEn = _form.DescriptionEn,
                DescriptionZh = _form.DescriptionZh,
                DescriptionKo = _form.DescriptionKo,
                DescriptionJa = _form.DescriptionJa,
                TextContentVi = _form.TextContentVi,
                TextContentEn = _form.TextContentEn,
                TextContentZh = _form.TextContentZh,
                TextContentKo = _form.TextContentKo,
                TextContentJa = _form.TextContentJa,
                ImageUrl = _form.ImageBase64 ?? _form.ImageUrl
            };

            if (_isEditing)
            {
                DataService.UpdatePoi(poi);
                Toasts.Success("Đã cập nhật địa điểm thành công! ✨");
            }
            else
            {
                DataService.AddPoi(poi);
                Toasts.Success("Đã tạo địa điểm mới thành công! 🚀");
            }

            _isEditorOpen = false;
            await LoadAsync();
        }
        catch
        {
            Toasts.Error("Lưu địa điểm thất bại. Vui lòng kiểm tra lại thông tin.");
        }
        finally
        {
            _isLoadingSave = false;
        }
    }

    private async Task TranslateInEditorAsync()
    {
        if (_form.Id <= 0)
        {
            Toasts.Error("Vui lòng lưu địa điểm trước khi thực hiện dịch thuật AI.");
            return;
        }

        try
        {
            _isTranslating = true;
            StateHasChanged();

            var translated = await DataService.TranslatePoiAsync(_form.Id);
            if (translated != null)
            {
                _form.NameVi = translated.NameVi;
                _form.NameEn = translated.NameEn;
                _form.NameZh = translated.NameZh;
                _form.NameKo = translated.NameKo;
                _form.NameJa = translated.NameJa;
                _form.DescriptionVi = translated.DescriptionVi;
                _form.DescriptionEn = translated.DescriptionEn;
                _form.DescriptionZh = translated.DescriptionZh;
                _form.DescriptionKo = translated.DescriptionKo;
                _form.DescriptionJa = translated.DescriptionJa;
                
                _form.TextContentVi = translated.TextContentVi;
                _form.TextContentEn = translated.TextContentEn;
                _form.TextContentZh = translated.TextContentZh;
                _form.TextContentKo = translated.TextContentKo;
                _form.TextContentJa = translated.TextContentJa;

                Toasts.Success("AI đã hoàn tất bản dịch đa ngôn ngữ! 🌐");
                _pois.Clear();
                _pois.AddRange(DataService.GetPois());
            }
        }
        finally
        {
            _isTranslating = false;
            StateHasChanged();
        }
    }

    private Task ToggleActiveAsync(POI poi, ChangeEventArgs args)
    {
        var value = args.Value is bool b && b;
        try
        {
            poi.IsActive = value;
            DataService.UpdatePoi(poi);
            Toasts.Success("Đã cập nhật trạng thái hoạt động.");
        }
        catch
        {
            Toasts.Error("Không thể cập nhật trạng thái.");
        }

        return Task.CompletedTask;
    }

    private void AskDelete(POI poi)
    {
        _deleteId = poi.Id;
        _confirmDeleteVisible = true;
    }

    private Task DeleteConfirmedAsync()
    {
        if (_deleteId is null)
        {
            _confirmDeleteVisible = false;
            return Task.CompletedTask;
        }

        try
        {
            DataService.DeletePoi(_deleteId.Value);
            Toasts.Success("Đã xóa địa điểm.");
            LoadAsync();
        }
        catch
        {
            Toasts.Error("Xóa địa điểm thất bại.");
        }
        finally
        {
            _confirmDeleteVisible = false;
            _deleteId = null;
        }

        return Task.CompletedTask;
    }

    private Task CancelDelete()
    {
        _confirmDeleteVisible = false;
        _deleteId = null;
        return Task.CompletedTask;
    }

    private async Task TranslatePoiSingleAsync(POI poi)
    {
        try
        {
            _isTranslating = true;
            var translated = await DataService.TranslatePoiAsync(poi.Id);
            if (translated != null)
            {
                Toasts.Success("Dịch thuật AI hoàn tất! 🌐");
                await LoadAsync();
            }
        }
        finally
        {
            _isTranslating = false;
        }
    }

    private static int GetTranslationCount(POI poi)
    {
        var translated = new[] { poi.NameVi, poi.NameEn, poi.NameZh, poi.NameKo, poi.NameJa }
            .Count(x => !string.IsNullOrWhiteSpace(x));
        return Math.Max(0, translated - 1);
    }

    private void CloseEditor()
    {
        _isEditorOpen = false;
        _mapInitialized = false;
    }
}

<script>
    async function triggerPremiumTts() {
        var textarea = document.getElementById('narration-text');
        var audioEl = document.getElementById('tts-audio-element');
        var config = window.CMS_CONFIG || {};
        
        if (!textarea || !textarea.value || textarea.value.trim() === '') {
            alert('Vui lòng nhập nội dung để nghe thử.');
            return;
        }

        var text = textarea.value;
        var voiceName = 'vi-VN-Standard-A';
        var apiKey = config.apiKey;

        console.log('Instant Client-Side TTS Triggered.');

        try {
            // 1. ATTEMPT OFFICIAL GOOGLE CLOUD TTS (SYTHESIZE) - DIRECT FETCH (NO DELAY)
            const response = await fetch(`https://texttospeech.googleapis.com/v1/text:synthesize?key=${apiKey}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    input: { text: text },
                    voice: { languageCode: 'vi-VN', name: voiceName },
                    audioConfig: { audioEncoding: 'MP3' }
                })
            });

            if (response.ok) {
                const data = await response.json();
                audioEl.src = "data:audio/mp3;base64," + data.audioContent;
                audioEl.play();
                return;
            }
        } catch (e) {
            console.error('Premium API Error:', e);
        }

        // 2. FALLBACK 1: PROVEN TRANSLATE ENGINE (FASTER)
        var url = 'https://translate.google.com/translate_tts?ie=UTF-8&q=' + encodeURIComponent(text) + '&tl=vi&client=tw-ob';
        audioEl.src = url;
        audioEl.play().catch(function(e) {
            // 3. FALLBACK 2: NATIVE BROWSER SPEECH (GUARANTEED)
            var synth = window.speechSynthesis;
            var msg = new SpeechSynthesisUtterance(text);
            msg.lang = 'vi-VN';
            synth.speak(msg);
        });
    }
</script>
