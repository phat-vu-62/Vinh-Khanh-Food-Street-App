@page "/poi"
@inject IAdminDataService DataService
@inject ToastService Toasts

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Quản lý điểm tham quan</h1>
        <small class="text-muted">Tạo mới, chỉnh sửa, kính hoạt và xóa các điểm tham quan (POI)</small>
    </div>
    <button class="btn btn-primary" @onclick="StartCreate">+ Thêm điểm mới</button>
</div>

<div class="module-panel">
    

    @if (!_isLoading && _pois.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-geo-alt empty-icon"></i>
            <div class="empty-title">Không tìm thấy điểm tham quan nào</div>
            <div class="empty-description">Chưa có điểm tham quan nào được cấu hình. Hãy tạo điểm đầu tiên để bắt đầu xây dựng bản đồ.</div>
            <button class="btn btn-primary mt-2" @onclick="StartCreate"><i class="bi bi-plus-lg"></i> Tạo điểm đầu tiên</button>
        </div>
    }
    else if (!_isLoading)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="input-group" style="max-width:320px;">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input class="form-control" placeholder="Tìm kiếm điểm..." @bind="_searchTerm" @bind:event="oninput" @bind:after="() => { _currentPage = 1; }" />
            </div>
            <small class="text-muted">@GetFilteredPois().Count() mục</small>
        </div>

        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th>Tên điểm</th>
                        <th>Mô tả</th>
                        <th>Tọa độ</th>
                        <th>Bản dịch</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var poi in GetPagedPois())
                    {
                        <tr>
                            <td class="fw-semibold">@poi.Name</td>
                            <td class="text-muted" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@poi.Description</td>
                            <td><code>@poi.Latitude.ToString("0.00000"), @poi.Longitude.ToString("0.00000")</code></td>
                            <td>
                                @if (GetTranslationCount(poi) > 0)
                                {
                                    <span class="badge text-bg-primary">@GetTranslationCount(poi) ngôn ngữ</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                @if (poi.IsActive)
                                {
                                    <span class="badge bg-active" @onclick="(args) => ToggleActiveAsync(poi, new ChangeEventArgs { Value = false })" style="cursor:pointer;">Đang bật</span>
                                }
                                else
                                {
                                    <span class="badge bg-inactive" @onclick="(args) => ToggleActiveAsync(poi, new ChangeEventArgs { Value = true })" style="cursor:pointer;">Đang tắt</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-info me-1" @onclick="() => ShowQrCode(poi)" title="QR Code">
                                    <i class="bi bi-qr-code"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => TranslatePoiAsync(poi)" disabled="@_isTranslating" title="Translate">
                                    <i class="bi bi-translate"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => StartEdit(poi)" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(poi)" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (GetTotalPoiPages() > 1)
        {
            <div class="d-flex justify-content-between align-items-center mt-3">
                <small class="text-muted">Trang @_currentPage / @GetTotalPoiPages()</small>
                <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(_currentPage <= 1)" @onclick="() => _currentPage--">
                        <i class="bi bi-chevron-left"></i> Trước
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(_currentPage >= GetTotalPoiPages())" @onclick="() => _currentPage++">
                        Sau <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    }
</div>

@if (_qrModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="modal-title m-0"><i class="bi bi-qr-code"></i> Mã QR của điểm tham quan</h5>
                    <button type="button" class="btn-close" @onclick="() => _qrModalVisible = false"></button>
                </div>
                <h5>@_selectedPoiForQr?.Name</h5>
                <p class="text-muted small">Quét mã để mở ứng dụng và phát âm thanh ngay lập tức (bỏ qua GPS)</p>
                <div class="bg-light d-inline-block p-4 rounded mb-3 border">
                     <!-- Dummy QR Image using a public API. In prod, use local generator like QRCoder -->
                     <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=@($"foodstreet://poi?id={_selectedPoiForQr?.Id}&play=true&skipGps=true")" alt="QR Code" width="200" height="200" />
                </div>
                <div>
                     <a class="btn btn-outline-primary btn-sm" href="/qr/@_selectedPoiForQr?.Id" target="_blank">Kiểm tra Link Redirect</a>
                </div>
            </div>
        </div>
    </div>
}

@if (_isEditorOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5)">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content form-card">
                <EditForm Model="_form" OnValidSubmit="SaveAsync">
                    <div class="modal-header">
                        <h5 class="modal-title">@(_isEditing ? "Chỉnh sửa điểm tham quan" : "Tạo điểm tham quan mới")</h5>
                        <button type="button" class="btn-close" @onclick="CloseEditor"></button>
                    </div>
                    <div class="modal-body" style="max-height: 75vh; overflow-y: auto;">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Tên điểm</label>
                                <InputText class="form-control" @bind-Value="_form.Name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Đường dẫn Âm thanh (URL)</label>
                                <InputText class="form-control" @bind-Value="_form.AudioUrl" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Mô tả</label>
                                <InputText class="form-control" @bind-Value="_form.Description" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Nội dung văn bản (TTS)</label>
                                <InputTextArea class="form-control" rows="3" @bind-Value="_form.TextContent" placeholder="Nội dung dùng để đọc tự động (TTS) nếu không có Audio URL" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Vĩ độ (Latitude)</label>
                                <InputNumber class="form-control" @bind-Value="_form.Latitude" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Kinh độ (Longitude)</label>
                                <InputNumber class="form-control" @bind-Value="_form.Longitude" />
                            </div>
                        </div>

                        @* ── Translation Section ── *@
                        @if (_isEditing)
                        {
                            <hr class="my-4" />
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="mb-0">
                                    <i class="bi bi-translate"></i> Quản lý bản dịch
                                </h6>
                                <button type="button"
                                        class="btn btn-outline-primary btn-sm"
                                        disabled="@_isTranslating"
                                        @onclick="TranslateAsync">
                                    @if (_isTranslating)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                        <span>Đang dịch...</span>
                                    }
                                    else
                                    {
                                        <span>🌐 Dịch tự động</span>
                                    }
                                </button>
                            </div>

                            <div class="row g-3">
                                @* Vietnamese *@
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇻🇳 Tên (Vi)</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="_form.NameVi" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇻🇳 Mô tả (Vi)</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="_form.DescriptionVi" />
                                </div>

                                @* English *@
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇺🇸 Tên (En)</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="_form.NameEn" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇺🇸 Mô tả (En)</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="_form.DescriptionEn" />
                                </div>

                                @* Chinese *@
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇨🇳 Tên (Zh)</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="_form.NameZh" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇨🇳 Mô tả (Zh)</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="_form.DescriptionZh" />
                                </div>

                                @* Korean *@
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇰🇷 Tên (Ko)</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="_form.NameKo" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇰🇷 Mô tả (Ko)</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="_form.DescriptionKo" />
                                </div>

                                @* Japanese *@
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇯🇵 Tên (Ja)</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="_form.NameJa" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇯🇵 Mô tả (Ja)</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="_form.DescriptionJa" />
                                </div>
                                
                                <h6 class="mb-0 mt-4"><i class="bi bi-volume-up"></i> Bản dịch nội dung TTS</h6>
                                
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇻🇳 Văn bản TTS (Vi)</label>
                                    <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="_form.TextContentVi" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇺🇸 Văn bản TTS (En)</label>
                                    <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="_form.TextContentEn" />
                                </div>
                                
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇨🇳 Văn bản TTS (Zh)</label>
                                    <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="_form.TextContentZh" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇰🇷 Văn bản TTS (Ko)</label>
                                    <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="_form.TextContentKo" />
                                </div>
                                
                                <div class="col-md-6">
                                    <label class="form-label text-muted">🇯🇵 Văn bản TTS (Ja)</label>
                                    <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="_form.TextContentJa" />
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseEditor">Hủy</button>
                        <button type="submit" class="btn btn-primary">Lưu</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmModal Visible="_confirmDeleteVisible"
              Title="Xóa điểm tham quan"
              Message="Hành động này không thể hoàn tác. Bạn có chắc chắn muốn xóa?"
              OnConfirm="DeleteConfirmedAsync"
              OnCancel="CancelDelete" />

@code {
    private readonly List<POI> _pois = [];
    private bool _isLoading;
    private bool _isEditorOpen;
    private bool _isEditing;
    private bool _isTranslating;
    private bool _confirmDeleteVisible;
    private bool _qrModalVisible;
    private POI? _selectedPoiForQr;
    private int? _deleteId;
    private PoiFormViewModel _form = new();
    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 10;

    private IEnumerable<POI> GetFilteredPois()
    {
        var q = _pois.OrderByDescending(x => x.Id).AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            q = q.Where(p => (p.Name ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)
                          || (p.Description ?? "").Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        return q;
    }

    private IEnumerable<POI> GetPagedPois() => GetFilteredPois().Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    private int GetTotalPoiPages() => (int)Math.Ceiling((double)GetFilteredPois().Count() / _pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            _pois.Clear();
            _pois.AddRange(DataService.GetPois());
        }
        catch
        {
            Toasts.Error("Failed to load POI list.");
        }
        finally
        {
            _isLoading = false;
        }

        return Task.CompletedTask;
    }

    private void StartCreate()
    {
        _isEditing = false;
        _form = new PoiFormViewModel { IsActive = true, RadiusMeters = 15 };
        _isEditorOpen = true;
    }

    private void StartEdit(POI poi)
    {
        _isEditing = true;
        _form = new PoiFormViewModel
        {
            Id = poi.Id,
            Name = poi.Name,
            Description = poi.Description,
            Latitude = poi.Latitude,
            Longitude = poi.Longitude,
            AudioUrl = poi.AudioUrl,
            IsActive = poi.IsActive,
            RadiusMeters = poi.RadiusMeters,
            Type = poi.Type,
            // Translation fields
            NameVi = poi.NameVi,
            NameEn = poi.NameEn,
            NameZh = poi.NameZh,
            NameKo = poi.NameKo,
            NameJa = poi.NameJa,
            DescriptionVi = poi.DescriptionVi,
            DescriptionEn = poi.DescriptionEn,
            DescriptionZh = poi.DescriptionZh,
            DescriptionKo = poi.DescriptionKo,
            DescriptionJa = poi.DescriptionJa,
            TextContent = poi.TextContent,
            TextContentVi = poi.TextContentVi,
            TextContentEn = poi.TextContentEn,
            TextContentZh = poi.TextContentZh,
            TextContentKo = poi.TextContentKo,
            TextContentJa = poi.TextContentJa
        };
        _isEditorOpen = true;
    }

    private void ShowQrCode(POI poi)
    {
        _selectedPoiForQr = poi;
        _qrModalVisible = true;
    }

    private Task SaveAsync()
    {
        try
        {
            var poi = new POI
            {
                Id = _form.Id,
                Name = _form.Name,
                Description = _form.Description,
                Latitude = _form.Latitude,
                Longitude = _form.Longitude,
                AudioUrl = _form.AudioUrl,
                IsActive = _form.IsActive,
                RadiusMeters = _form.RadiusMeters,
                Type = _form.Type,
                // Preserve translation fields
                NameVi = _form.NameVi,
                NameEn = _form.NameEn,
                NameZh = _form.NameZh,
                NameKo = _form.NameKo,
                NameJa = _form.NameJa,
                DescriptionVi = _form.DescriptionVi,
                DescriptionEn = _form.DescriptionEn,
                DescriptionZh = _form.DescriptionZh,
                DescriptionKo = _form.DescriptionKo,
                DescriptionJa = _form.DescriptionJa,
                TextContent = _form.TextContent,
                TextContentVi = _form.TextContentVi,
                TextContentEn = _form.TextContentEn,
                TextContentZh = _form.TextContentZh,
                TextContentKo = _form.TextContentKo,
                TextContentJa = _form.TextContentJa
            };

            if (_isEditing)
            {
                DataService.UpdatePoi(poi);
                Toasts.Success("POI updated.");
            }
            else
            {
                DataService.AddPoi(poi);
                Toasts.Success("POI created.");
            }

            _isEditorOpen = false;
            LoadAsync();
        }
        catch
        {
            Toasts.Error("Save POI failed.");
        }

        return Task.CompletedTask;
    }

    private async Task TranslateAsync()
    {
        if (_form.Id <= 0)
        {
            Toasts.Error("Please save the POI first before translating.");
            return;
        }

        try
        {
            _isTranslating = true;
            StateHasChanged();

            var translated = await DataService.TranslatePoiAsync(_form.Id);
            if (translated != null)
            {
                _form.NameVi = translated.NameVi;
                _form.NameEn = translated.NameEn;
                _form.NameZh = translated.NameZh;
                _form.NameKo = translated.NameKo;
                _form.NameJa = translated.NameJa;
                _form.DescriptionVi = translated.DescriptionVi;
                _form.DescriptionEn = translated.DescriptionEn;
                _form.DescriptionZh = translated.DescriptionZh;
                _form.DescriptionKo = translated.DescriptionKo;
                _form.DescriptionJa = translated.DescriptionJa;
                
                _form.TextContentVi = translated.TextContentVi;
                _form.TextContentEn = translated.TextContentEn;
                _form.TextContentZh = translated.TextContentZh;
                _form.TextContentKo = translated.TextContentKo;
                _form.TextContentJa = translated.TextContentJa;

                // Also refresh the list to show badges
                _pois.Clear();
                _pois.AddRange(DataService.GetPois());

                Toasts.Success("Translation completed successfully!");
            }
            else
            {
                Toasts.Error("POI not found or translation failed.");
            }
        }
        catch (Exception ex)
        {
            Toasts.Error($"Translation failed: {ex.Message}");
        }
        finally
        {
            _isTranslating = false;
            StateHasChanged();
        }
    }

    private Task ToggleActiveAsync(POI poi, ChangeEventArgs args)
    {
        var value = args.Value is bool b && b;
        try
        {
            poi.IsActive = value;
            DataService.UpdatePoi(poi);
            Toasts.Success("POI status updated.");
        }
        catch
        {
            Toasts.Error("Cannot update POI status.");
        }

        return Task.CompletedTask;
    }

    private void AskDelete(POI poi)
    {
        _deleteId = poi.Id;
        _confirmDeleteVisible = true;
    }

    private Task DeleteConfirmedAsync()
    {
        if (_deleteId is null)
        {
            _confirmDeleteVisible = false;
            return Task.CompletedTask;
        }

        try
        {
            DataService.DeletePoi(_deleteId.Value);
            Toasts.Success("POI deleted.");
            LoadAsync();
        }
        catch
        {
            Toasts.Error("Delete POI failed.");
        }
        finally
        {
            _confirmDeleteVisible = false;
            _deleteId = null;
        }

        return Task.CompletedTask;
    }

    private Task CancelDelete()
    {
        _confirmDeleteVisible = false;
        _deleteId = null;
        return Task.CompletedTask;
    }

    private async Task TranslatePoiAsync(POI poi)
    {
        try
        {
            _isTranslating = true;
            var translated = await DataService.TranslatePoiAsync(poi.Id);
            if (translated is null)
            {
                Toasts.Error("POI not found or translation failed.");
                return;
            }

            Toasts.Success("POI translated.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toasts.Error($"Translation failed: {ex.Message}");
        }
        finally
        {
            _isTranslating = false;
        }
    }

    private static int GetTranslationCount(POI poi)
    {
        var translated = new[] { poi.NameVi, poi.NameEn, poi.NameZh, poi.NameKo, poi.NameJa }
            .Count(x => !string.IsNullOrWhiteSpace(x));
        return Math.Max(0, translated - 1);
    }

    private void CloseEditor() => _isEditorOpen = false;

}
