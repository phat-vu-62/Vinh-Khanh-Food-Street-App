@page "/owner"
@using FoodStreetApp.Shared.Entities
@using FoodStreetApp.CMS.Interfaces
@using FoodStreetApp.CMS.ViewModels
@using FoodStreetApp.CMS.Models
@using FoodStreetApp.CMS.Components
@inject IAdminDataService DataService
@inject IJSRuntime JSRuntime
@inject ToastService Toasts
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Owner")]

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="h3 fw-bold mb-1">Quản trị viên Cửa hàng</h1>
        <p class="text-muted mb-0">Quản lý các địa điểm và theo dõi hiệu suất của bạn.</p>
    </div>
    @if (_activeTab == "locations")
    {
        <button class="btn btn-saas btn-saas-primary shadow-sm" @onclick="StartCreate">
            <i class="bi bi-plus-lg"></i> Thêm địa điểm mới
        </button>
    }
</div>

<!-- Navigation Tabs -->
<div class="mb-5">
    <div class="nav nav-pills gap-2 p-1 bg-light rounded-pill d-inline-flex shadow-sm">
        <button class="nav-link rounded-pill px-4 @(_activeTab == "overview" ? "active bg-primary text-white" : "text-muted")" @onclick='() => _activeTab = "overview"'>
            <i class="bi bi-grid-1x2-fill me-2"></i> Tổng quan
        </button>
        <button class="nav-link rounded-pill px-4 @(_activeTab == "locations" ? "active bg-primary text-white" : "text-muted")" @onclick='() => _activeTab = "locations"'>
            <i class="bi bi-geo-alt-fill me-2"></i> Địa điểm của tôi
        </button>
    </div>
</div>

<LoadingState IsLoading="_isLoading" Message="Đang cập nhật dữ liệu..." />

@if (!_isLoading)
{
    @if (_activeTab == "overview")
    {
        <!-- Statistics Section -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="saas-card stats-card border-primary h-100">
                    <span class="stats-label">Tổng địa điểm</span>
                    <div class="d-flex align-items-baseline justify-content-between">
                        <span class="stats-value">@_myPois.Count</span>
                        <i class="bi bi-geo-alt text-primary"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="saas-card stats-card border-success h-100">
                    <span class="stats-label">Đã duyệt</span>
                    <div class="d-flex align-items-baseline justify-content-between">
                        <span class="stats-value">@_myPois.Count(p => p.IsApproved)</span>
                        <i class="bi bi-check-circle text-success"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="saas-card stats-card border-danger h-100 @(_summary.PendingApprovals > 0 ? "border-2 shadow-sm" : "opacity-75")">
                    <span class="stats-label">Chờ duyệt</span>
                    <div class="d-flex align-items-baseline justify-content-between">
                        <span class="stats-value @(_summary.PendingApprovals > 0 ? "animate__animated animate__headShake animate__infinite d-inline-block" : "")">@_summary.PendingApprovals</span>
                        <i class="bi bi-shield-lock @(_summary.PendingApprovals > 0 ? "text-danger" : "text-muted")"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-lg-8">
                <div class="saas-card p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold m-0">Xu hướng tương tác</h5>
                        <div class="badge bg-light text-muted p-2 rounded-2 border">7 ngày qua</div>
                    </div>
                    
                    <div class="activity-chart-placeholder d-flex align-items-center justify-content-center bg-light rounded-4" style="height: 300px;">
                        @if (_summary.DailyTrends.Any())
                        {
                            <div class="text-center">
                                <i class="bi bi-graph-up-arrow text-primary opacity-25" style="font-size: 4rem;"></i>
                                <p class="text-muted small mt-2">Dữ liệu đang được phân tích...</p>
                            </div>
                        }
                        else
                        {
                            <div class="text-center p-5">
                                <i class="bi bi-bar-chart text-muted opacity-25" style="font-size: 3rem;"></i>
                                <p class="text-muted small mt-2">Chưa có đủ dữ liệu hoạt động</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="saas-card p-4 h-100">
                    <h5 class="fw-bold mb-4">Hiệu suất tổng quát</h5>
                    <div class="d-flex flex-column gap-4">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary bg-opacity-10 p-2 rounded-3 text-primary"><i class="bi bi-eye"></i></div>
                                <div>
                                    <div class="fw-bold small">Lượt xem địa điểm</div>
                                    <div class="text-muted x-small">Tất cả bài viết</div>
                                </div>
                            </div>
                            <div class="fw-bold">@_summary.TotalPoiViewed</div>
                        </div>
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-success bg-opacity-10 p-2 rounded-3 text-success"><i class="bi bi-play-circle"></i></div>
                                <div>
                                    <div class="fw-bold small">Lượt nghe âm thanh</div>
                                    <div class="text-muted x-small">Tổng thời lượng</div>
                                </div>
                            </div>
                            <div class="fw-bold">@_summary.TotalAudioPlayed</div>
                        </div>
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-warning bg-opacity-10 p-2 rounded-3 text-warning"><i class="bi bi-clock-history"></i></div>
                                <div>
                                    <div class="fw-bold small">Nghe trung bình</div>
                                    <div class="text-muted x-small">Mỗi lượt nghe</div>
                                </div>
                            </div>
                            <div class="fw-bold">@_summary.AvgDurationSeconds.ToString("0.0")s</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Locations Management Section -->
        @if (_myPois.Count == 0)
        {
            <div class="saas-card p-5 text-center border-0 shadow-sm mt-4">
                <i class="bi bi-geo-alt text-muted" style="font-size: 3rem;"></i>
                <h5 class="fw-bold mt-3">Chưa có địa điểm nào</h5>
                <p class="text-muted small">Hãy bắt đầu bằng cách tạo địa điểm đầu tiên cho cửa hàng của bạn.</p>
                <button class="btn btn-saas btn-saas-primary mt-3" @onclick="StartCreate">Bắt đầu ngay</button>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var poi in _myPois)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="saas-card gallery-card h-100 d-flex flex-column">
                            <div class="position-relative">
                                <img class="gallery-card-img" 
                                     src="@(string.IsNullOrEmpty(poi.ImageUrl) ? "https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=600&q=80" : poi.ImageUrl)" 
                                     alt="@poi.Name" />
                                <div class="position-absolute top-0 end-0 p-2 d-flex flex-column gap-1 align-items-end">
                                    <span class="saas-badge @(poi.IsActive ? "badge-active" : "badge-inactive") shadow-sm">
                                        @(poi.IsActive ? "● Hiển thị" : "○ Đã ẩn")
                                    </span>
                                    @if (!poi.IsApproved)
                                    {
                                        <span class="badge bg-danger shadow-sm py-1 px-2" style="font-size: 0.65rem;">
                                            <i class="bi bi-clock-history me-1"></i> CHỜ DUYỆT
                                        </span>
                                    }
                                </div>
                            </div>
                            
                            <div class="p-4 flex-grow-1 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h6 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 80%;">@poi.Name</h6>
                                    <div class="dropdown">
                                        <button class="btn btn-link link-muted p-0" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0">
                                            <li><button class="dropdown-item" @onclick="() => StartEdit(poi)"><i class="bi bi-pencil me-2"></i> Chỉnh sửa</button></li>
                                            <li><button class="dropdown-item text-danger" @onclick="() => AskDelete(poi.Id)"><i class="bi bi-trash me-2"></i> Xóa bỏ</button></li>
                                        </ul>
                                    </div>
                                </div>
                                <p class="x-small text-muted mb-4 line-clamp-2" style="height: 2.5rem;">@poi.Description</p>
                                
                                <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                    <div class="d-flex gap-1">
                                        <i class="bi bi-geo-alt text-muted small"></i>
                                        <span class="x-small text-muted">@poi.Latitude.ToString("F4"), @poi.Longitude.ToString("F4")</span>
                                    </div>
                                    <span class="badge bg-light text-dark fw-normal x-small border">@poi.Type.ToString()</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
}

<!-- Editor Modal -->
@if (_isEditorOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8px);">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <EditForm Model="_form" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />
                    
                    <div class="modal-header bg-white border-bottom p-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-primary bg-opacity-10 p-3 rounded-4 text-primary">
                                <i class="bi bi-geo-alt-fill fs-4"></i>
                            </div>
                            <div>
                                <h4 class="modal-title fw-bold m-0">@(_isEditing ? "Chỉnh sửa địa điểm" : "Thêm địa điểm mới")</h4>
                                <p class="text-muted small m-0">Vui lòng điền đầy đủ thông tin bên dưới.</p>
                            </div>
                        </div>
                        <button type="button" class="btn-close" @onclick="CloseEditor"></button>
                    </div>
                    
                    <div class="modal-body p-0">
                        <div class="row g-0">
                            <!-- Left: Main Info -->
                            <div class="col-lg-7 p-4 bg-light bg-opacity-50">
                                <div class="saas-card bg-white p-4 border-0 shadow-sm h-100">
                                    <div class="mb-4">
                                        <label class="form-label fw-bold small text-uppercase tracking-wider">Tên địa điểm (Tiếng Việt)</label>
                                        <InputText @bind-Value="_form.Name" class="form-control form-control-lg border-2 shadow-sm fs-6" placeholder="Bún bò Huế Bà Nghị..." />
                                        <ValidationMessage For="@(() => _form.Name)" />
                                    </div>
                                    
                                    <div class="mb-4">
                                        <label class="form-label fw-bold small text-uppercase tracking-wider">Mô tả ngắn</label>
                                        <InputTextArea @bind-Value="_form.Description" class="form-control border-2 shadow-sm" style="min-height: 120px;" placeholder="Giới thiệu về hương vị và lịch sử..." />
                                        <ValidationMessage For="@(() => _form.Description)" />
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold small text-uppercase d-block mb-2">Loại địa điểm</label>
                                            <InputSelect @bind-Value="_form.Type" class="form-select border-2 shadow-sm">
                                                @foreach (var type in Enum.GetValues<FoodStreetApp.Shared.Enums.POIType>())
                                                {
                                                    <option value="@type">@type.ToString()</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold small text-uppercase d-block mb-2">Bán kính quét (m)</label>
                                            <InputNumber @bind-Value="_form.RadiusMeters" class="form-control border-2 shadow-sm" />
                                        </div>
                                    </div>
                                    
                                    <div class="mt-4 p-3 bg-light rounded-3">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div>
                                                <h6 class="fw-bold m-0">Trạng thái hoạt động</h6>
                                                <p class="text-muted x-small m-0">Cho phép người dùng nhìn thấy trên bản đồ.</p>
                                            </div>
                                            <div class="form-check form-switch ps-5">
                                                <InputCheckbox @bind-Value="_form.IsActive" class="form-check-input scale-120" />
                                            </div>
                                        </div>
                                    </div>
                                    
                                    @if (_isEditing && !_form.IsApproved)
                                    {
                                        <div class="mt-3 p-3 bg-danger bg-opacity-10 rounded-3 border border-danger border-opacity-25">
                                            <div class="d-flex align-items-center gap-2 text-danger fw-bold small">
                                                <i class="bi bi-shield-lock"></i> Đang chờ Admin duyệt
                                            </div>
                                            <p class="text-muted x-small m-1">Bài viết của bạn sẽ hiển thị công khai sau khi Admin phê duyệt.</p>
                                        </div>
                                    }
                                </div>
                            </div>
                            
                            <!-- Right: Media & Coordinates -->
                            <div class="col-lg-5 p-4">
                                <div class="mb-4">
                                    <label class="form-label fw-bold small text-uppercase tracking-wider">Hình ảnh đại diện</label>
                                    <div class="image-upload-box border-2 border-dashed rounded-4 p-3 text-center position-relative overflow-hidden mb-2" style="height: 160px;">
                                        @if (!string.IsNullOrEmpty(_form.ImageUrl))
                                        {
                                            <img src="@_form.ImageUrl" class="h-100 w-100 object-fit-cover rounded-3" />
                                            <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2" @onclick='() => _form.ImageUrl = ""'>
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column align-items-center justify-content-center h-100 py-3">
                                                <i class="bi bi-cloud-upload fs-2 text-muted mb-2"></i>
                                                <p class="text-muted x-small m-0">Dán URL hình ảnh vào bên dưới</p>
                                            </div>
                                        }
                                    </div>
                                    <InputText @bind-Value="_form.ImageUrl" class="form-control form-control-sm border-2" placeholder="https://image-url.com/photo.jpg" />
                                </div>
                                
                                <div class="mb-4">
                                    <label class="form-label fw-bold small text-uppercase tracking-wider">Tọa độ địa lý</label>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-light x-small">LAT</span>
                                                <InputNumber @bind-Value="_form.Latitude" class="form-control" step="0.000001" />
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-light x-small">LNG</span>
                                                <InputNumber @bind-Value="_form.Longitude" class="form-control" step="0.000001" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-2 text-end">
                                        <button type="button" class="btn btn-link x-small text-primary p-0 text-decoration-none" @onclick="SyncCoordsFromMap">
                                            <i class="bi bi-geo-alt-fill me-1"></i> Lấy tọa độ từ bản đồ
                                        </button>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold small text-uppercase tracking-wider">Đường dẫn Âm thanh</label>
                                    <InputText @bind-Value="_form.AudioUrl" class="form-control form-control-sm border-2" placeholder="https://hosting.com/audio.mp3" />
                                    <p class="text-muted x-small mt-1 m-0"><i class="bi bi-info-circle me-1"></i> Tải lên đám mây và dán URL vào đây.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="modal-footer bg-light border-top p-4 d-flex justify-content-between">
                        <button type="button" class="btn btn-saas btn-saas-secondary px-4" @onclick="CloseEditor">Hủy bỏ</button>
                        <button type="submit" class="btn btn-saas btn-saas-primary px-5 fw-bold shadow" disabled="@_isLoadingSave">
                            @if (_isLoadingSave)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span> <span>ĐANG LƯU...</span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle me-2"></i> @(_isEditing ? "LƯU THAY ĐỔI" : "TẠO ĐỊA ĐIỂM")
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Confirm Delete Modal -->
<ConfirmModal Visible="_confirmDeleteVisible" 
              Title="Xóa địa điểm" 
              Message="Bạn có chắc chắn muốn xóa địa điểm này không? Hành động này không thể hoàn tác." 
              OnConfirm="DeleteConfirmedAsync" 
              OnCancel="() => _confirmDeleteVisible = false" />

@code {
    private string _activeTab = "overview";
    private AnalyticsSummary _summary = new();
    private List<POI> _myPois = new();
    private bool _isLoading = true;
    private bool _isLoadingSave = false;
    private bool _isEditorOpen = false;
    private bool _isEditing = false;
    private bool _confirmDeleteVisible = false;
    private int? _deleteId;
    private Guid _currentUserId;

    private PoiFormViewModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst("userId")?.Value;
        
        if (Guid.TryParse(userIdClaim, out var id))
        {
            _currentUserId = id;
            await LoadAsync();
        }
        else
        {
            _isLoading = false;
            Toasts.Error("Không thể xác định thông tin người dùng. Vui lòng đăng nhập lại.");

        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _myPois = DataService.GetPoisByOwnerId(_currentUserId).ToList();
            _summary = await DataService.GetAnalyticsSummaryAsync(null, null, _currentUserId);
        }
        catch (Exception ex)
        {
            Toasts.Error("Lỗi khi tải dữ liệu: " + ex.Message);

        }
        finally
        {
            _isLoading = false;
        }
    }

    private void StartCreate()
    {
        _form = new PoiFormViewModel { OwnerId = _currentUserId, IsApproved = false, IsActive = false };
        _isEditing = false;
        _isEditorOpen = true;
    }

    private void StartEdit(POI poi)
    {
        _form = new PoiFormViewModel
        {
            Id = poi.Id,
            Name = poi.Name,
            Description = poi.Description,
            Latitude = poi.Latitude,
            Longitude = poi.Longitude,
            RadiusMeters = poi.RadiusMeters,
            IsActive = poi.IsActive,
            IsApproved = poi.IsApproved,
            Type = poi.Type,
            ImageUrl = poi.ImageUrl,
            AudioUrl = poi.AudioUrl,
            OwnerId = poi.OwnerId ?? _currentUserId
        };
        _isEditing = true;
        _isEditorOpen = true;
    }

    private async Task SaveAsync()
    {
        _isLoadingSave = true;
        try
        {
            var poi = new POI
            {
                Id = _form.Id,
                Name = _form.Name,
                Description = _form.Description,
                Latitude = _form.Latitude,
                Longitude = _form.Longitude,
                RadiusMeters = _form.RadiusMeters,
                IsActive = _form.IsActive,
                IsApproved = _form.IsApproved, // Standard: Owner can't self-approve
                Type = _form.Type,
                ImageUrl = _form.ImageUrl,
                AudioUrl = _form.AudioUrl,
                OwnerId = _form.OwnerId 
            };

            if (_isEditing)
            {
                DataService.UpdatePoi(poi);
                Toasts.Success("Đã cập nhật địa điểm thành công.");

            }
            else
            {
                // New POIs from owners are never pre-approved
                poi.IsApproved = false;
                DataService.AddPoi(poi);
                Toasts.Success("Đã tạo địa điểm! Vui lòng chờ Admin duyệt.");

            }

            _isEditorOpen = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toasts.Error("Lỗi khi lưu: " + ex.Message);

        }
        finally
        {
            _isLoadingSave = false;
        }
    }

    private void CloseEditor() => _isEditorOpen = false;

    private void AskDelete(int id)
    {
        _deleteId = id;
        _confirmDeleteVisible = true;
    }

    private async Task DeleteConfirmedAsync()
    {
        if (_deleteId.HasValue)
        {
            DataService.DeletePoi(_deleteId.Value);
            _confirmDeleteVisible = false;
            await LoadAsync();
            Toasts.Success("Đã xóa địa điểm.");

        }
    }

    private void SyncCoordsFromMap()
    {
        // Placeholder for map integration
         Toasts.Info("Tính năng chọn tọa độ từ bản đồ đang được phát triển.");

    }
}
