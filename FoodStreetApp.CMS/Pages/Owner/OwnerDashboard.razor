@page "/owner"
@using FoodStreetApp.Shared.Entities
@using FoodStreetApp.CMS.Interfaces
@inject IAdminDataService AdminDataService
@inject IJSRuntime JSRuntime
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Owner")]
@inject AuthenticationStateProvider AuthStateProvider

<div class="dashboard-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Owner Dashboard</h1>
            <p class="text-muted">Manage your points of interest (POIs)</p>
        </div>
        <button class="btn btn-primary" @onclick="OpenAddModal">
            <i class="bi bi-plus-lg"></i> Add New POI
        </button>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (myPois == null || !myPois.Any())
    {
        <div class="empty-state text-center p-5">
            <i class="bi bi-geo-alt shadow-sm"></i>
            <h3>No POIs found</h3>
            <p>You haven't added any POIs yet. Start by adding your first one!</p>
            <button class="btn btn-outline-primary mt-2" @onclick="OpenAddModal">Add First POI</button>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var poi in myPois)
            {
                <div class="col">
                    <div class="poi-card">
                        @if (!string.IsNullOrEmpty(poi.ImageUrl))
                        {
                            <div class="poi-image" style="background-image: url('@poi.ImageUrl')"></div>
                        }
                        else
                        {
                            <div class="poi-image placeholder-image">
                                <i class="bi bi-image"></i>
                            </div>
                        }
                        <div class="poi-body">
                            <h5 class="poi-title">@poi.Name</h5>
                            <p class="poi-desc">@(poi.Description?.Length > 100 ? poi.Description.Substring(0, 97) + "..." : poi.Description)</p>
                            <div class="poi-footer d-flex justify-content-between align-items-center">
                                <span class="badge @(poi.IsActive ? "bg-success" : "bg-secondary")">
                                    @(poi.IsActive ? "Active" : "Inactive")
                                </span>
                                <div class="poi-actions">
                                    <button class="btn btn-sm btn-outline-info" @onclick="() => EditPoi(poi)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePoi(poi.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .dashboard-container {
        padding: 20px;
    }

    h1 {
        font-weight: 700;
        color: #1a1a2e;
    }

    .poi-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        transition: transform 0.3s, box-shadow 0.3s;
        border: 1px solid rgba(0,0,0,0.05);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .poi-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    .poi-image {
        height: 180px;
        background-size: cover;
        background-position: center;
    }

    .placeholder-image {
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        color: #dee2e6;
    }

    .poi-body {
        padding: 20px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .poi-title {
        font-weight: 600;
        margin-bottom: 10px;
        color: #16213e;
    }

    .poi-desc {
        font-size: 0.9rem;
        color: #6c757d;
        margin-bottom: 20px;
        flex-grow: 1;
    }

    .empty-state i {
        font-size: 4rem;
        color: #dee2e6;
        margin-bottom: 20px;
        display: block;
    }

    .btn-primary {
        background: linear-gradient(45deg, #00d2ff, #3a7bd5);
        border: none;
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: 600;
    }
</style>

@code {
    private List<POI> myPois = new();
    private bool isLoading = true;
    private Guid currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst("userId")?.Value;
        
        if (Guid.TryParse(userIdClaim, out var id))
        {
            currentUserId = id;
            await LoadMyPois();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task LoadMyPois()
    {
        isLoading = true;
        // In a real app, I'd have a specific method in AdminDataService to get by owner.
        // For now, I'll filter in memory or mock the service call if needed.
        // Actually, the requirement says "Owner chỉ thấy dữ liệu của chính họ".
        
        var allPois = AdminDataService.GetPois();
        myPois = allPois.Where(p => p.OwnerId == currentUserId).ToList();
        
        isLoading = false;
        StateHasChanged();
    }

    private void OpenAddModal()
    {
        // Simple mock for now
        Console.WriteLine("Open Add Modal");
    }

    private void EditPoi(POI poi)
    {
        Console.WriteLine($"Edit POI: {poi.Name}");
    }

    private async Task DeletePoi(int id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this POI?"))
        {
            AdminDataService.DeletePoi(id);
            await LoadMyPois();
        }
    }
}
