@page "/owner"
@using FoodStreetApp.Shared.Entities
@using FoodStreetApp.CMS.Interfaces
@using FoodStreetApp.CMS.Models
@using FoodStreetApp.CMS.Components
@using System.Text.Json
@inject IAdminDataService DataService
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject ToastService Toasts
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Owner")]

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="h3 fw-bold mb-1">Tổng quan Cửa hàng</h1>
        <p class="text-muted mb-0">Theo dõi hiệu suất và tương tác tại các địa điểm của bạn.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-saas btn-saas-secondary" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise me-1"></i> Làm mới</button>
    </div>
</div>

<LoadingState IsLoading="_isLoading" Message="Đang cập nhật dữ liệu..." />

@if (!_isLoading)
{
    <!-- Statistics Section -->
    <div class="row g-4 mb-5">
        <div class="col-xl col-md-4">
            <div class="saas-card stats-card border-primary h-100">
                <span class="stats-label">Tổng địa điểm</span>
                <div class="d-flex align-items-baseline justify-content-between">
                    <span class="stats-value">@_myPoiCount</span>
                    <i class="bi bi-geo-alt text-primary"></i>
                </div>
                <div class="progress mt-3" style="height: 4px;">
                    <div class="progress-bar bg-primary" style="width: 100%;"></div>
                </div>
            </div>
        </div>
        <div class="col-xl col-md-4">
            <div class="saas-card stats-card border-success h-100">
                <span class="stats-label">Đã duyệt</span>
                <div class="d-flex align-items-baseline justify-content-between">
                    <span class="stats-value">@(_myPoiCount - _summary.PendingApprovals)</span>
                    <i class="bi bi-check-circle text-success"></i>
                </div>
                <div class="progress mt-3" style="height: 4px;">
                    <div class="progress-bar bg-success" style="width: 100%;"></div>
                </div>
            </div>
        </div>
        <div class="col-xl col-md-4">
            <div class="saas-card stats-card border-danger h-100 @(_summary.PendingApprovals > 0 ? "border-2 shadow-sm" : "opacity-75")">
                <span class="stats-label">Đang chờ duyệt</span>
                <div class="d-flex align-items-baseline justify-content-between">
                    <span class="stats-value @(_summary.PendingApprovals > 0 ? "animate__animated animate__headShake animate__infinite d-inline-block" : "")">@_summary.PendingApprovals</span>
                    <i class="bi bi-shield-lock @(_summary.PendingApprovals > 0 ? "text-danger" : "text-muted")"></i>
                </div>
                <div class="mt-3">
                    @if (_summary.PendingApprovals > 0)
                    {
                        <a href="/owner/poi" class="btn btn-sm btn-outline-danger w-100 border-0 bg-danger bg-opacity-10 py-1" style="font-size: 0.7rem;">Xem danh sách <i class="bi bi-arrow-right"></i></a>
                    }
                    else
                    {
                        <span class="text-muted x-small">Đã duyệt tất cả</span>
                    }
                </div>
            </div>
        </div>
    </div>


    <div class="row g-4 mb-5">
        <div class="col-lg-8">
            <div class="saas-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h6 class="fw-bold mb-0">Biểu đồ hoạt động (7 ngày qua)</h6>
                        <small class="text-muted">Cập nhật lúc: @DateTime.UtcNow.AddHours(7).ToString("HH:mm:ss")</small>
                    </div>
                </div>
                
                <div class="chart-container py-3" style="height: 250px;">
                    <svg width="100%" height="200" viewBox="0 0 1000 200" preserveAspectRatio="none">
                        <line x1="0" y1="50" x2="1000" y2="50" stroke="#f1f5f9" />
                        <line x1="0" y1="100" x2="1000" y2="100" stroke="#f1f5f9" />
                        <line x1="0" y1="150" x2="1000" y2="150" stroke="#f1f5f9" />
                        
                        <polyline points="@GenerateTrendPoints(true)" fill="none" stroke="var(--primary-color)" stroke-width="3" />
                        <path d="M 0 200 L @GenerateTrendPoints(true) L 1000 200 Z" fill="var(--primary-color)" opacity="0.05" />
                    </svg>
                    <div class="d-flex justify-content-between mt-3 px-1 x-small text-muted">
                        @foreach (var t in _summary.DailyTrends) { <span>@t.Date.ToString("dd/MM")</span> }
                    </div>
                </div>
            </div>
        </div>
        <!-- SVG Bar Chart: Top Locations -->
        <div class="col-lg-4">
            <div class="saas-card p-4 h-100">
                <h6 class="fw-bold mb-4">Top địa điểm phổ biến</h6>
                <div class="d-flex flex-column gap-4">
                    @if (!_summary.TopPois.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox mb-2" style="font-size: 2rem;"></i>
                            <p class="small">Chưa có dữ liệu</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var p in _summary.TopPois)
                        {
                            <div>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-semibold">@p.PoiName</span>
                                    <span class="text-muted">@p.Count lượt</span>
                                </div>
                                <div class="progress" style="height: 12px; border-radius: 6px;">
                                    <div class="progress-bar bg-primary" 
                                         style="width: @(Math.Min(100, (p.Count * 100 / (_summary.TopPois.First().Count))))%;"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private AnalyticsSummary _summary = new();
    private int _myPoiCount = 0;
    private bool _isLoading = true;
    private Guid _currentUserId;
    private DateTime _lastUpdated = DateTime.Now;
    private decimal _listenRevenue = 0;
    private int _listenPayCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthAndLoad();
    }

    private async Task CheckAuthAndLoad()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst("userId")?.Value;
        
        if (Guid.TryParse(userIdClaim, out var id))
        {
            if (_currentUserId != id)
            {
                _currentUserId = id;
                await LoadAsync();
            }
        }
        else
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Re-check after render because JS runtime is now available to retrieve token from localStorage
            await CheckAuthAndLoad();
            StateHasChanged();
        }
    }


    private bool _isRefreshing;

    private async Task LoadAsync()
    {
        if (_isRefreshing) return;
        _isRefreshing = true;
        _isLoading = true;
        _lastUpdated = DateTime.Now;
        try
        {
            _myPoiCount = DataService.GetPoisByOwnerId(_currentUserId).Count;
            _summary = await DataService.GetAnalyticsSummaryAsync(null, null, _currentUserId);

            // Load real listen revenue for owner's POIs
            try
            {
                var resp = await Http.GetAsync($"api/auth/owner-revenue/{_currentUserId}");
                if (resp.IsSuccessStatusCode)
                {
                    var json = await resp.Content.ReadAsStringAsync();
                    var rev = JsonSerializer.Deserialize<JsonElement>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    _listenRevenue = rev.TryGetProperty("listenRevenue", out var lr) ? lr.GetDecimal() : 0;
                    _listenPayCount = rev.TryGetProperty("listenCount", out var lc) ? lc.GetInt32() : 0;
                }
            }
            catch { /* revenue fetch failed */ }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Owner dashboard load error (ignored): {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            _isRefreshing = false;
        }
    }

    private string GenerateTrendPoints(bool isListen)
    {
        if (!_summary.DailyTrends.Any()) return "0,200 1000,200";
        var points = new List<string>();
        var maxVal = Math.Max(1, _summary.DailyTrends.Max(t => Math.Max(t.Views, t.Listens)));
        for (int i = 0; i < _summary.DailyTrends.Count; i++)
        {
            var x = i * 1000 / Math.Max(1, _summary.DailyTrends.Count - 1);
            var val = isListen ? _summary.DailyTrends[i].Listens : _summary.DailyTrends[i].Views;
            var y = 180 - (val * 160 / maxVal);
            points.Add($"{x},{y}");
        }
        return string.Join(" ", points);
    }
}
