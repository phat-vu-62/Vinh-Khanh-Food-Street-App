@page
@model FoodStreetApp.CMS.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderModel
{
    Title = "Dashboard",
    Subtitle = "Overview of POIs, tours, and audio assets"
})

<div class="row g-3 mb-3">
    <div class="col-md-4">
        @await Html.PartialAsync("_StatCard", new StatCardModel { Title = "Total POIs", Value = Model.TotalPois.ToString(), Icon = "bi-geo-alt", CardClass = "text-bg-primary" })
    </div>
    <div class="col-md-4">
        @await Html.PartialAsync("_StatCard", new StatCardModel { Title = "Total Tours", Value = Model.TotalTours.ToString(), Icon = "bi-map", CardClass = "text-bg-success" })
    </div>
    <div class="col-md-4">
        @await Html.PartialAsync("_StatCard", new StatCardModel { Title = "Total Audios", Value = Model.TotalAudios.ToString(), Icon = "bi-mic", CardClass = "text-bg-info" })
    </div>
</div>

<div class="module-panel">
    <h3 class="h5">Analytics</h3>
    <p class="text-secondary mb-0">Chart widgets will be added here in the next iteration.</p>
</div>
