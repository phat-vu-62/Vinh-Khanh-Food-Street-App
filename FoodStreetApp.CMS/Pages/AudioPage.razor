@page "/audio"
@inject IAdminDataService DataService
@inject ToastService Toasts

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Audio Management</h1>
        <small class="text-muted">Assign audio track to POIs and preview playback</small>
    </div>
    <button class="btn btn-primary" @onclick="StartCreate">+ New Audio</button>
</div>

<section class="module-panel">
    <LoadingState IsLoading="_isLoading" Message="Loading audio library..." />

    @if (!_isLoading && _audios.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-file-earmark-music empty-icon"></i>
            <div class="empty-title">No audio records found</div>
            <div class="empty-description">Upload audio files or generate TTS clips to accompany your Points of Interest.</div>
            <button class="btn btn-primary mt-2" @onclick="StartCreate"><i class="bi bi-plus-lg"></i> Add first audio</button>
        </div>
    }
    else if (!_isLoading)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="input-group" style="max-width:320px;">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input class="form-control" placeholder="Search audio..." @bind="_searchTerm" @bind:event="oninput" @bind:after="() => { _currentPage = 1; }" />
            </div>
            <small class="text-muted">@GetFilteredAudios().Count() items</small>
        </div>

        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>POI</th>
                        <th>Duration</th>
                        <th>Status</th>
                        <th>Preview</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var audio in GetPagedAudios())
                    {
                        <tr>
                            <td class="fw-semibold">@audio.Title</td>
                            <td>@FindPoiName(audio.PoiId)</td>
                            <td>@audio.DurationSeconds s</td>
                            <td>
                                @if (audio.IsActive)
                                {
                                    <span class="badge bg-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-inactive">Inactive</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(audio.Url))
                                {
                                    <audio controls preload="none" style="height: 2rem; width: 200px;">
                                        <source src="@audio.Url" />
                                    </audio>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => StartEdit(audio)" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(audio.Id)" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (GetTotalAudioPages() > 1)
        {
            <div class="d-flex justify-content-between align-items-center mt-3">
                <small class="text-muted">Page @_currentPage of @GetTotalAudioPages()</small>
                <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(_currentPage <= 1)" @onclick="() => _currentPage--">
                        <i class="bi bi-chevron-left"></i> Prev
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(_currentPage >= GetTotalAudioPages())" @onclick="() => _currentPage++">
                        Next <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    }
</section>

@if (_editorOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5)">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content form-card">
                <EditForm Model="_form" OnValidSubmit="SaveAsync">
                    <div class="modal-header">
                        <h5 class="modal-title">@(_isEditing ? "Edit Audio" : "Create Audio")</h5>
                        <button type="button" class="btn-close" @onclick="CloseEditor"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Title</label>
                                <InputText class="form-control" @bind-Value="_form.Title" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">POI</label>
                                <InputSelect class="form-select" @bind-Value="_form.PoiId">
                                    @foreach (var poi in _pois.OrderBy(x => x.Name))
                                    {
                                        <option value="@poi.Id">@poi.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Duration (seconds)</label>
                                <InputNumber class="form-control" @bind-Value="_form.DurationSeconds" />
                            </div>
                            <div class="col-md-12 mb-3">
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="audioMode" id="modeUpload" autocomplete="off" checked="@(_audioMode == "Upload")" @onchange="@(() => _audioMode = "Upload")">
                                    <label class="btn btn-outline-primary" for="modeUpload"><i class="bi bi-upload"></i> Upload File</label>

                                    <input type="radio" class="btn-check" name="audioMode" id="modeTTS" autocomplete="off" checked="@(_audioMode == "TTS")" @onchange="@(() => _audioMode = "TTS")">
                                    <label class="btn btn-outline-primary" for="modeTTS"><i class="bi bi-mic"></i> Text-to-Speech (TTS)</label>
                                </div>
                            </div>

                            @if (_audioMode == "TTS")
                            {
                                <div class="col-md-12">
                                    <div class="card border-0 bg-light">
                                        <div class="card-body py-3">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <label class="form-label mb-0">Generate TTS</label>
                                                <button type="button" class="btn btn-sm btn-primary" @onclick="GenerateTtsUrl">
                                                    Generate Audio
                                                </button>
                                            </div>
                                            <div class="row g-2">
                                                <div class="col-md-3">
                                                    <InputSelect class="form-select" @bind-Value="_ttsLanguage">
                                                        <option value="vi">vi</option>
                                                        <option value="en">en</option>
                                                        <option value="zh-CN">zh</option>
                                                        <option value="ko">ko</option>
                                                        <option value="ja">ja</option>
                                                    </InputSelect>
                                                </div>
                                                <div class="col-md-9">
                                                    <InputTextArea class="form-control" @bind-Value="_ttsText" rows="2" placeholder="Enter text to synthesize" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (_audioMode == "Upload")
                            {
                                <div class="col-12">
                                    <label class="form-label">Upload audio file</label>
                                    <InputFile class="form-control" OnChange="OnAudioSelected" accept="audio/*" />
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(_form.Url) || !string.IsNullOrWhiteSpace(_uploadedPreviewUrl))
                            {
                                <div class="col-12 mt-3 text-center">
                                    <small class="text-muted d-block mb-1">Audio Preview</small>
                                    <audio controls class="w-100" style="max-height: 40px;">
                                        <source src="@(!string.IsNullOrWhiteSpace(_uploadedPreviewUrl) ? _uploadedPreviewUrl : _form.Url)" />
                                    </audio>
                                </div>
                            }

                            <div class="col-md-4 mt-3">
                                <label class="form-label">Status</label>
                                <div class="form-check form-switch mt-2">
                                    <InputCheckbox class="form-check-input" @bind-Value="_form.IsActive" />
                                    <label class="form-check-label">Active</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseEditor">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<Audio> _audios = [];
    private readonly List<POI> _pois = [];
    private bool _isLoading;
    private bool _editorOpen;
    private bool _isEditing;
    private string _audioMode = "Upload";
    private string? _uploadedPreviewUrl;
    private string _ttsText = string.Empty;
    private string _ttsLanguage = "vi";
    private AudioFormViewModel _form = new();
    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 10;

    private IEnumerable<Audio> GetFilteredAudios()
    {
        var q = _audios.OrderByDescending(x => x.Id).AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            q = q.Where(a => (a.Title ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)
                          || FindPoiName(a.PoiId).Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        return q;
    }

    private IEnumerable<Audio> GetPagedAudios() => GetFilteredAudios().Skip((_currentPage - 1) * _pageSize).Take(_pageSize);
    private int GetTotalAudioPages() => (int)Math.Ceiling((double)GetFilteredAudios().Count() / _pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            _audios.Clear();
            _pois.Clear();
            _audios.AddRange(DataService.GetAudios());
            _pois.AddRange(DataService.GetPois());
        }
        catch
        {
            Toasts.Error("Failed to load audio data.");
        }
        finally
        {
            _isLoading = false;
        }

        return Task.CompletedTask;
    }

    private void StartCreate()
    {
        _isEditing = false;
        _form = new AudioFormViewModel { PoiId = _pois.FirstOrDefault()?.Id ?? 0, DurationSeconds = 30, IsActive = true };
        _uploadedPreviewUrl = null;
        _ttsText = string.Empty;
        _ttsLanguage = "vi";
        _audioMode = "Upload";
        _editorOpen = true;
    }

    private void StartEdit(Audio audio)
    {
        _isEditing = true;
        _form = new AudioFormViewModel
        {
            Id = audio.Id,
            PoiId = audio.PoiId,
            Title = audio.Title,
            Url = audio.Url,
            DurationSeconds = audio.DurationSeconds,
            IsActive = audio.IsActive
        };
        _uploadedPreviewUrl = null;
        _ttsText = string.Empty;
        _ttsLanguage = "vi";
        _audioMode = string.IsNullOrEmpty(audio.Url) ? "Upload" : (audio.Url.Contains("translate.google.com") ? "TTS" : "Upload");
        _editorOpen = true;
    }

    private Task SaveAsync()
    {
        try
        {
            var payload = new Audio
            {
                Id = _form.Id,
                PoiId = _form.PoiId,
                Title = _form.Title,
                Url = _form.Url,
                DurationSeconds = _form.DurationSeconds,
                IsActive = _form.IsActive
            };

            if (_isEditing)
            {
                DataService.UpdateAudio(payload);
                Toasts.Success("Audio updated.");
            }
            else
            {
                DataService.AddAudio(payload);
                Toasts.Success("Audio created.");
            }

            _editorOpen = false;
            LoadAsync();
        }
        catch
        {
            Toasts.Error("Save audio failed.");
        }

        return Task.CompletedTask;
    }

    private Task DeleteAsync(int id)
    {
        try
        {
            DataService.DeleteAudio(id);
            Toasts.Success("Audio deleted.");
            LoadAsync();
        }
        catch
        {
            Toasts.Error("Delete audio failed.");
        }

        return Task.CompletedTask;
    }

    private async Task OnAudioSelected(InputFileChangeEventArgs eventArgs)
    {
        var file = eventArgs.File;
        await using var stream = file.OpenReadStream(10 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var bytes = ms.ToArray();
        _uploadedPreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
        _form.Url = _uploadedPreviewUrl;
        if (string.IsNullOrWhiteSpace(_form.Title))
        {
            _form.Title = Path.GetFileNameWithoutExtension(file.Name);
        }
        Toasts.Success("Audio file uploaded to form.");
    }

    private void GenerateTtsUrl()
    {
        if (string.IsNullOrWhiteSpace(_ttsText))
        {
            Toasts.Error("Enter text before generating TTS.");
            return;
        }

        _form.Url = $"https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl={_ttsLanguage}&q={Uri.EscapeDataString(_ttsText)}";
        _form.DurationSeconds = Math.Max(5, _ttsText.Length / 8);
        if (string.IsNullOrWhiteSpace(_form.Title))
        {
            _form.Title = $"TTS {_ttsLanguage.ToUpperInvariant()}";
        }
        Toasts.Success("TTS URL generated.");
    }

    private string FindPoiName(int poiId) => _pois.FirstOrDefault(x => x.Id == poiId)?.Name ?? $"POI #{poiId}";

    private void CloseEditor() => _editorOpen = false;

}
