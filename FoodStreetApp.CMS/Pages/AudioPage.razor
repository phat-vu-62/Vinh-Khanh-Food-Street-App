@page "/audio"
@inject IAdminDataService DataService
@inject ToastService Toasts

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="h3 fw-bold mb-1">Âm thanh thuyết minh</h1>
        <p class="text-muted mb-0">Quản lý các bản ghi âm và thuyết minh AI cho từng địa điểm.</p>
    </div>
    <button class="btn btn-saas btn-saas-primary shadow-sm" @onclick="StartCreate">
        <i class="bi bi-cloud-upload"></i> Tải âm thanh mới
    </button>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-4 mb-4">
    <div class="input-group" style="max-width:400px;">
        <span class="input-group-text bg-white border-end-0 rounded-start-2 shadow-sm"><i class="bi bi-search text-muted"></i></span>
        <input class="form-control border-start-0 rounded-end-2 shadow-sm" placeholder="Tìm tên file hoặc địa điểm..." @bind="_searchTerm" @bind:event="oninput" @bind:after="() => { _currentPage = 1; }" />
    </div>
    <span class="text-muted small">@GetFilteredAudios().Count() bản ghi tìm thấy</span>
</div>

<LoadingState IsLoading="_isLoading" Message="Đang xử lý âm thanh..." />

@if (!_isLoading && _audios.Count == 0)
{
    <div class="saas-card p-5 text-center">
        <div class="py-4">
            <i class="bi bi-music-note-beamed text-muted" style="font-size: 3rem; opacity: 0.3;"></i>
            <h5 class="fw-bold mt-4">Chưa có tập tin âm thanh</h5>
            <p class="text-muted small">Tải lên các bản ghi âm .mp3 để khách tham quan có thể nghe thuyết minh.</p>
            <button class="btn btn-saas btn-saas-primary mt-3" @onclick="StartCreate">Bắt đầu tải lên</button>
        </div>
    </div>
}
else if (!_isLoading)
{
    <div class="saas-card overflow-hidden">
        <div class="table-responsive">
            <table class="saas-table">
                <thead>
                    <tr>
                        <th style="width: 300px;">Tập tin & Tiêu đề</th>
                        <th>Địa điểm</th>
                        <th>Thời lượng</th>
                        <th style="width: 250px;">Nghe thử</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in GetPagedAudios())
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-primary p-2 rounded-2 text-white d-flex" style="background-color: var(--primary-color);">
                                        <i class="bi bi-play-fill fs-5"></i>
                                    </div>
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold text-dark text-truncate" style="max-width: 200px;">@item.Title</span>
                                        <small class="text-muted">#@item.Id</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="saas-badge badge-inactive">@FindPoiName(item.PoiId)</span>
                            </td>
                            <td class="small fw-semibold">@item.DurationSeconds giây</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Url))
                                {
                                    <audio controls class="w-100" style="height: 32px; filter: grayscale(1) invert(0.1);">
                                        <source src="@item.Url" />
                                    </audio>
                                }
                                else
                                {
                                    <span class="text-muted small">No URL</span>
                                }
                            </td>
                            <td>
                                <span class="saas-badge @(item.IsActive ? "badge-active" : "badge-inactive")">
                                    @(item.IsActive ? "Online" : "Draft")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-link link-primary p-0" title="Sửa" @onclick="() => StartEdit(item)"><i class="bi bi-pencil-square fs-5"></i></button>
                                    <button class="btn btn-link link-danger p-0" title="Xóa" @onclick="() => DeleteAsync(item.Id)"><i class="bi bi-trash fs-5"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (GetTotalAudioPages() > 1)
    {
        <div class="d-flex justify-content-center align-items-center mt-4 gap-3">
            <button class="btn btn-saas btn-saas-secondary btn-sm" disabled="@(_currentPage <= 1)" @onclick="() => _currentPage--">
                <i class="bi bi-chevron-left"></i>
            </button>
            <span class="small fw-bold">@_currentPage / @GetTotalAudioPages()</span>
            <button class="btn btn-saas btn-saas-secondary btn-sm" disabled="@(_currentPage >= GetTotalAudioPages())" @onclick="() => _currentPage++">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    }
}

@if (_editorOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8px);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content overflow-hidden">
                <EditForm Model="_form" OnValidSubmit="SaveAsync">
                    <div class="modal-header border-0 bg-light py-3 px-4">
                        <h5 class="modal-title fw-bold">@(_isEditing ? "🖊️ Cập nhật âm thanh" : "✨ Thêm âm thanh mới")</h5>
                        <button type="button" class="btn-close" @onclick="CloseEditor"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="row g-4">
                            <div class="col-md-7">
                                <label class="form-label fw-bold">Tiêu đề hiển thị</label>
                                <InputText class="form-control" @bind-Value="_form.Title" placeholder="Ví dụ: Giới thiệu Quán Ốc Oanh" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-bold">Gán cho địa điểm</label>
                                <InputSelect class="form-select" @bind-Value="_form.PoiId">
                                    @foreach (var poi in _pois.OrderBy(x => x.Name))
                                    {
                                        <option value="@poi.Id">@poi.Name</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-12 mt-4">
                                <label class="form-label fw-bold d-block mb-3">Phương thức nhập âm thanh</label>
                                <div class="btn-group w-100 p-1 bg-light rounded-4" role="group">
                                    <input type="radio" class="btn-check" name="audioMode" id="modeUpload" autocomplete="off" checked="@(_audioMode == "Upload")" @onchange="@(() => _audioMode = "Upload")">
                                    <label class="btn btn-saas @(_audioMode == "Upload" ? "btn-saas-primary shadow-sm" : "btn-light border-0") w-50" for="modeUpload">
                                        <i class="bi bi-upload me-2"></i> Tải file lên (.mp3, .wav)
                                    </label>

                                    <input type="radio" class="btn-check" name="audioMode" id="modeTTS" autocomplete="off" checked="@(_audioMode == "TTS")" @onchange="@(() => _audioMode = "TTS")">
                                    <label class="btn btn-saas @(_audioMode == "TTS" ? "btn-saas-primary shadow-sm" : "btn-light border-0") w-50" for="modeTTS">
                                        <i class="bi bi-mic me-2"></i> Chuyển văn bản thành giọng nói (TTS)
                                    </label>
                                </div>
                            </div>

                            @if (_audioMode == "TTS")
                            {
                                <div class="col-12">
                                    <div class="p-3 rounded-4 border" style="background-color: #fffaf0;">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <span class="badge badge-pill bg-primary bg-opacity-10 text-primary"><i class="bi bi-stars me-1"></i> AI Voice Generator</span>
                                            <button type="button" class="btn btn-sm btn-saas btn-saas-primary px-3" @onclick="GenerateTtsUrl">
                                                Tạo bản nghe thử
                                            </button>
                                        </div>
                                        <div class="row g-3">
                                            <div class="col-md-3">
                                                <label class="form-label small fw-bold">Ngôn ngữ</label>
                                                <InputSelect class="form-select form-select-sm" @bind-Value="_ttsLanguage">
                                                    <option value="vi">Tiếng Việt 🇻🇳</option>
                                                    <option value="en">English 🇺🇸</option>
                                                    <option value="zh-CN">Chinese 🇨🇳</option>
                                                    <option value="ko">Korean 🇰🇷</option>
                                                    <option value="ja">Japanese 🇯🇵</option>
                                                </InputSelect>
                                            </div>
                                            <div class="col-md-9">
                                                <label class="form-label small fw-bold">Nội dung thuyết minh</label>
                                                <InputTextArea class="form-control form-control-sm" @bind-Value="_ttsText" rows="3" placeholder="Nhập văn bản quán ăn muốn thuyết minh..." />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (_audioMode == "Upload")
                            {
                                <div class="col-12">
                                    <div class="p-4 border-dashed rounded-4 text-center bg-light border-2">
                                        <i class="bi bi-cloud-upload text-muted fs-1 d-block mb-2"></i>
                                        <label class="form-label d-block fw-bold">Chọn tệp âm thanh từ máy tính</label>
                                        <InputFile class="form-control mt-2" OnChange="OnAudioSelected" accept="audio/*" />
                                        <small class="text-muted mt-2 d-block">Dung lượng tối đa: 10MB</small>
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(_form.Url) || !string.IsNullOrWhiteSpace(_uploadedPreviewUrl))
                            {
                                <div class="col-12 mt-3">
                                    <div class="saas-card p-3 bg-white border border-primary border-opacity-25 rounded-4 shadow-sm text-center">
                                        <small class="text-primary fw-bold d-block mb-2"><i class="bi bi-play-circle me-1"></i> Trình phát thử nghiệm</small>
                                        <audio controls class="w-100 rounded-pill">
                                            <source src="@(!string.IsNullOrWhiteSpace(_uploadedPreviewUrl) ? _uploadedPreviewUrl : _form.Url)" />
                                        </audio>
                                    </div>
                                </div>
                            }

                            <div class="col-md-6 mt-4">
                                <div class="form-check form-switch custom-switch">
                                    <InputCheckbox class="form-check-input" id="audioActive" @bind-Value="_form.IsActive" />
                                    <label class="form-check-label fw-bold" for="audioActive">Sẵn sàng phát (Hoạt động)</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 p-4 pt-0">
                        <button type="button" class="btn btn-saas btn-saas-secondary" @onclick="CloseEditor">Hủy</button>
                        <button type="submit" class="btn btn-saas btn-saas-primary px-4">Lưu âm thanh</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<Audio> _audios = [];
    private readonly List<POI> _pois = [];
    private bool _isLoading;
    private bool _editorOpen;
    private bool _isEditing;
    private string _audioMode = "Upload";
    private string? _uploadedPreviewUrl;
    private string _ttsText = string.Empty;
    private string _ttsLanguage = "vi";
    private AudioFormViewModel _form = new();
    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 10;

    private IEnumerable<Audio> GetFilteredAudios()
    {
        var q = _audios.OrderByDescending(x => x.Id).AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            q = q.Where(a => (a.Title ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)
                          || FindPoiName(a.PoiId).Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        return q;
    }

    private IEnumerable<Audio> GetPagedAudios() => GetFilteredAudios().Skip((_currentPage - 1) * _pageSize).Take(_pageSize);
    private int GetTotalAudioPages() => (int)Math.Ceiling((double)GetFilteredAudios().Count() / _pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            _audios.Clear();
            _pois.Clear();
            _audios.AddRange(DataService.GetAudios());
            _pois.AddRange(DataService.GetPois());
        }
        catch
        {
            Toasts.Error("Failed to load audio data.");
        }
        finally
        {
            _isLoading = false;
        }

        return Task.CompletedTask;
    }

    private void StartCreate()
    {
        _isEditing = false;
        _form = new AudioFormViewModel { PoiId = _pois.FirstOrDefault()?.Id ?? 0, DurationSeconds = 30, IsActive = true };
        _uploadedPreviewUrl = null;
        _ttsText = string.Empty;
        _ttsLanguage = "vi";
        _audioMode = "Upload";
        _editorOpen = true;
    }

    private void StartEdit(Audio audio)
    {
        _isEditing = true;
        _form = new AudioFormViewModel
        {
            Id = audio.Id,
            PoiId = audio.PoiId,
            Title = audio.Title,
            Url = audio.Url,
            DurationSeconds = audio.DurationSeconds,
            IsActive = audio.IsActive
        };
        _uploadedPreviewUrl = null;
        _ttsText = string.Empty;
        _ttsLanguage = "vi";
        _audioMode = string.IsNullOrEmpty(audio.Url) ? "Upload" : (audio.Url.Contains("translate.google.com") ? "TTS" : "Upload");
        _editorOpen = true;
    }

    private Task SaveAsync()
    {
        try
        {
            var payload = new Audio
            {
                Id = _form.Id,
                PoiId = _form.PoiId,
                Title = _form.Title,
                Url = _form.Url,
                DurationSeconds = _form.DurationSeconds,
                IsActive = _form.IsActive
            };

            if (_isEditing)
            {
                DataService.UpdateAudio(payload);
                Toasts.Success("Audio updated.");
            }
            else
            {
                DataService.AddAudio(payload);
                Toasts.Success("Audio created.");
            }

            _editorOpen = false;
            LoadAsync();
        }
        catch
        {
            Toasts.Error("Save audio failed.");
        }

        return Task.CompletedTask;
    }

    private Task DeleteAsync(int id)
    {
        try
        {
            DataService.DeleteAudio(id);
            Toasts.Success("Audio deleted.");
            LoadAsync();
        }
        catch
        {
            Toasts.Error("Delete audio failed.");
        }

        return Task.CompletedTask;
    }

    private async Task OnAudioSelected(InputFileChangeEventArgs eventArgs)
    {
        var file = eventArgs.File;
        await using var stream = file.OpenReadStream(10 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var bytes = ms.ToArray();
        _uploadedPreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
        _form.Url = _uploadedPreviewUrl;
        if (string.IsNullOrWhiteSpace(_form.Title))
        {
            _form.Title = Path.GetFileNameWithoutExtension(file.Name);
        }
        Toasts.Success("Audio file uploaded to form.");
    }

    private void GenerateTtsUrl()
    {
        if (string.IsNullOrWhiteSpace(_ttsText))
        {
            Toasts.Error("Enter text before generating TTS.");
            return;
        }

        _form.Url = $"https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl={_ttsLanguage}&q={Uri.EscapeDataString(_ttsText)}";
        _form.DurationSeconds = Math.Max(5, _ttsText.Length / 8);
        if (string.IsNullOrWhiteSpace(_form.Title))
        {
            _form.Title = $"TTS {_ttsLanguage.ToUpperInvariant()}";
        }
        Toasts.Success("TTS URL generated.");
    }

    private string FindPoiName(int poiId) => _pois.FirstOrDefault(x => x.Id == poiId)?.Name ?? $"POI #{poiId}";

    private void CloseEditor() => _editorOpen = false;

}
