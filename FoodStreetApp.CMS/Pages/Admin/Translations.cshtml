@page
@model FoodStreetApp.CMS.Pages.Admin.TranslationsModel
@{
    ViewData["Title"] = "Translation Management";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderModel
{
    Title = "Translation Management",
    Subtitle = "Manage multi-language content per POI"
})

<div class="module-panel">
    <div class="table-toolbar">
        <input type="search" class="form-control" placeholder="Search translations..." data-table-search="translationTable" />
        <button type="button" class="btn btn-primary"
                data-modal-target="translationModal"
                data-mode="create"
                data-id="0"
                data-entityname="POI"
                data-entityid=""
                data-fieldname=""
                data-value=""
                data-language="Vi">
            <i class="bi bi-plus-circle me-1"></i>Create Translation
        </button>
    </div>

    <div class="table-responsive">
        <table id="translationTable" class="table table-hover align-middle mb-0" data-enhance-table="true" data-page-size="8">
            <thead class="table-light">
                <tr>
                    <th>Entity</th>
                    <th>Language</th>
                    <th>Field</th>
                    <th>Value</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                var deleteFormId = $"delete-translation-{item.Id}";
                <tr>
                    <td>@item.EntityName #@item.EntityId</td>
                    <td><span class="badge text-bg-light">@item.Language</span></td>
                    <td>@item.FieldName</td>
                    <td>@item.Value</td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-modal-target="translationModal"
                                    data-mode="edit"
                                    data-id="@item.Id"
                                    data-entityname="@item.EntityName"
                                    data-entityid="@item.EntityId"
                                    data-fieldname="@item.FieldName"
                                    data-value="@item.Value"
                                    data-language="@item.Language">
                                Edit
                            </button>
                            <form method="post" asp-page-handler="Delete" id="@deleteFormId">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="button" class="btn btn-sm btn-outline-danger js-delete-btn" data-delete-form="@deleteFormId">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="table-pagination" data-table-pagination="translationTable"></div>
</div>

<div class="modal fade" id="translationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" data-role="modal-title">Create Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" class="loading-form">
                <div class="modal-body">
                    <input type="hidden" asp-for="Input.Id" data-input="id" />
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label">Entity</label><input class="form-control" asp-for="Input.EntityName" data-input="entityname" /></div>
                        <div class="col-md-6">
                            <label class="form-label">POI</label>
                            <select class="form-select" asp-for="Input.EntityId" data-input="entityid">
                                @foreach (var poi in Model.Pois)
                                {
                                    <option value="@poi.Id">@poi.Id - @poi.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6"><label class="form-label">Field Name</label><input class="form-control" asp-for="Input.FieldName" data-input="fieldname" /></div>
                        <div class="col-md-6">
                            <label class="form-label">Language</label>
                            <select class="form-select" asp-for="Input.Language" asp-items="Html.GetEnumSelectList<Language>()" data-input="language"></select>
                        </div>
                        <div class="col-12"><label class="form-label">Translated Value</label><textarea class="form-control" asp-for="Input.Value" data-input="value"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" data-role="create-submit" formaction="?handler=Add">Create</button>
                    <button type="submit" class="btn btn-primary d-none" data-role="edit-submit" formaction="?handler=Edit">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
