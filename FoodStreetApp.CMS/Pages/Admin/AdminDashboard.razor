@page "/admin/dashboard"
@using FoodStreetApp.Shared.Entities
@using FoodStreetApp.CMS.Interfaces
@inject IAdminDataService AdminDataService
@inject IJSRuntime JSRuntime
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "admin")]

<div class="dashboard-container">
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-primary-soft">
                    <i class="bi bi-geo-alt-fill text-primary"></i>
                </div>
                <div class="stat-details">
                    <h3>@pois.Count</h3>
                    <p>Total POIs</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-success-soft">
                    <i class="bi bi-people-fill text-success"></i>
                </div>
                <div class="stat-details">
                    <h3>@ownerCount</h3>
                    <p>Total Owners</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-warning-soft">
                    <i class="bi bi-clock-history text-warning"></i>
                </div>
                <div class="stat-details">
                    <h3>@pendingPois</h3>
                    <p>Pending Approval</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-info-soft">
                    <i class="bi bi-graph-up text-info"></i>
                </div>
                <div class="stat-details">
                    <h3>1.2k</h3>
                    <p>Daily Scans</p>
                </div>
            </div>
        </div>
    </div>

    <div class="admin-table-container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Recent Activities</h4>
            <div class="d-flex gap-2">
                <input type="text" class="form-control form-control-sm" placeholder="Search POIs..." @bind="searchQuery" @bind:event="oninput" />
                <button class="btn btn-sm btn-primary">Export CSV</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Owner</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var poi in FilteredPois)
                    {
                        <tr>
                            <td>#@poi.Id</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="poi-thumb" style="background-image: url('@poi.ImageUrl')"></div>
                                    <span class="fw-bold">@poi.Name</span>
                                </div>
                            </td>
                            <td>@(poi.OwnerId == null ? "System" : $"Owner #{poi.OwnerId}")</td>
                            <td>
                                <span class="badge @(poi.IsActive ? "bg-success" : "bg-danger")">
                                    @(poi.IsActive ? "Active" : "Disabled")
                                </span>
                            </td>
                            <td>
                                <button class="btn btn-icon text-primary"><i class="bi bi-eye"></i></button>
                                <button class="btn btn-icon text-info"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-icon text-danger" @onclick="() => DeletePoi(poi.Id)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .dashboard-container {
        padding: 20px;
    }

    .stat-card {
        background: white;
        border-radius: 15px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 20px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        border: 1px solid rgba(0,0,0,0.05);
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .bg-primary-soft { background: rgba(58, 123, 213, 0.1); }
    .bg-success-soft { background: rgba(40, 167, 69, 0.1); }
    .bg-warning-soft { background: rgba(255, 193, 7, 0.1); }
    .bg-info-soft { background: rgba(23, 162, 184, 0.1); }

    .stat-details h3 {
        margin-bottom: 0px;
        font-weight: 700;
        color: #1a1a2e;
    }

    .stat-details p {
        margin-bottom: 0;
        font-size: 0.85rem;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .admin-table-container {
        background: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        border: 1px solid rgba(0,0,0,0.05);
    }

    .poi-thumb {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        background-color: #f8f9fa;
        background-size: cover;
        background-position: center;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .btn-icon {
        padding: 4px;
        background: none;
        border: none;
        font-size: 1.1rem;
        transition: transform 0.2s;
    }

    .btn-icon:hover {
        transform: scale(1.2);
    }

    .table thead th {
        border-top: none;
        background: #f8f9fa;
        font-size: 0.8rem;
        text-transform: uppercase;
        color: #6c757d;
        font-weight: 600;
        padding: 12px;
    }

    .table tbody td {
        padding: 15px 12px;
        color: #495057;
    }
</style>

@code {
    private List<POI> pois = new();
    private int ownerCount = 5; // Placeholder
    private int pendingPois = 3; // Placeholder
    private string searchQuery = "";

    protected override void OnInitialized()
    {
        pois = AdminDataService.GetPois().ToList();
    }

    private IEnumerable<POI> FilteredPois => 
        string.IsNullOrWhiteSpace(searchQuery) 
            ? pois 
            : pois.Where(p => p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private void DeletePoi(int id)
    {
        // Mock delete
        pois.RemoveAll(p => p.Id == id);
    }
}
