@page
@model FoodStreetApp.CMS.Pages.Admin.POIModel
@{
    ViewData["Title"] = "POI Management";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderModel
{
    Title = "POI Management",
    Subtitle = "Manage places of interest used by the mobile app"
})

<div class="module-panel">
    <div class="table-toolbar">
        <input type="search" class="form-control" placeholder="Search POIs..." data-table-search="poiTable" />
        <button type="button" class="btn btn-primary"
                data-modal-target="poiModal"
                data-mode="create"
                data-id="0"
                data-name=""
                data-description=""
                data-latitude=""
                data-longitude=""
                data-audiourl="">
            <i class="bi bi-plus-circle me-1"></i>Create New POI
        </button>
    </div>

    <div class="table-responsive">
        <table id="poiTable" class="table table-hover align-middle mb-0" data-enhance-table="true" data-page-size="8">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Latitude</th>
                    <th>Longitude</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                var deleteFormId = $"delete-poi-{item.Id}";
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Latitude</td>
                    <td>@item.Longitude</td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-modal-target="poiModal"
                                    data-mode="edit"
                                    data-id="@item.Id"
                                    data-name="@item.Name"
                                    data-description="@item.Description"
                                    data-latitude="@item.Latitude"
                                    data-longitude="@item.Longitude"
                                    data-audiourl="@item.AudioUrl">
                                Edit
                            </button>
                            <form method="post" asp-page-handler="Delete" id="@deleteFormId">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="button" class="btn btn-sm btn-outline-danger js-delete-btn" data-delete-form="@deleteFormId">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="table-pagination" data-table-pagination="poiTable"></div>
</div>

<div class="modal fade" id="poiModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" data-role="modal-title">Create Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" class="loading-form">
                <div class="modal-body">
                    <input type="hidden" asp-for="Input.Id" data-input="id" />
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label">Name</label><input class="form-control" asp-for="Input.Name" data-input="name" /></div>
                        <div class="col-md-6"><label class="form-label">Audio URL</label><input class="form-control" asp-for="Input.AudioUrl" data-input="audiourl" /></div>
                        <div class="col-12"><label class="form-label">Description</label><textarea class="form-control" asp-for="Input.Description" data-input="description"></textarea></div>
                        <div class="col-md-6"><label class="form-label">Latitude</label><input class="form-control" asp-for="Input.Latitude" data-input="latitude" /></div>
                        <div class="col-md-6"><label class="form-label">Longitude</label><input class="form-control" asp-for="Input.Longitude" data-input="longitude" /></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" data-role="create-submit" formaction="?handler=Add">Create</button>
                    <button type="submit" class="btn btn-primary d-none" data-role="edit-submit" formaction="?handler=Edit">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
