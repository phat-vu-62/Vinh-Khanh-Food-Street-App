@page
@model FoodStreetApp.CMS.Pages.Admin.AudioModel
@{
    ViewData["Title"] = "Audio Management";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderModel
{
    Title = "Audio Management",
    Subtitle = "Manage narration and audio files"
})

<div class="module-panel">
    <div class="table-toolbar">
        <input type="search" class="form-control" placeholder="Search audio records..." data-table-search="audioTable" />
        <button type="button" class="btn btn-primary"
                data-modal-target="audioModal"
                data-mode="create"
                data-id="0"
                data-poiid=""
                data-title=""
                data-url=""
                data-durationseconds="">
            <i class="bi bi-plus-circle me-1"></i>Create Audio
        </button>
    </div>

    <div class="table-responsive">
        <table id="audioTable" class="table table-hover align-middle mb-0" data-enhance-table="true" data-page-size="8">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>POI ID</th>
                    <th>Duration</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                var deleteFormId = $"delete-audio-{item.Id}";
                <tr>
                    <td>@item.Title</td>
                    <td>@item.PoiId</td>
                    <td>@item.DurationSeconds s</td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-modal-target="audioModal"
                                    data-mode="edit"
                                    data-id="@item.Id"
                                    data-poiid="@item.PoiId"
                                    data-title="@item.Title"
                                    data-url="@item.Url"
                                    data-durationseconds="@item.DurationSeconds">
                                Edit
                            </button>
                            <form method="post" asp-page-handler="Delete" id="@deleteFormId">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="button" class="btn btn-sm btn-outline-danger js-delete-btn" data-delete-form="@deleteFormId">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="table-pagination" data-table-pagination="audioTable"></div>
</div>

<div class="modal fade" id="audioModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" data-role="modal-title">Create Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" class="loading-form">
                <div class="modal-body">
                    <input type="hidden" asp-for="Input.Id" data-input="id" />
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label">POI ID</label><input class="form-control" asp-for="Input.PoiId" data-input="poiid" /></div>
                        <div class="col-md-6"><label class="form-label">Duration (seconds)</label><input class="form-control" asp-for="Input.DurationSeconds" data-input="durationseconds" /></div>
                        <div class="col-12"><label class="form-label">Title</label><input class="form-control" asp-for="Input.Title" data-input="title" /></div>
                        <div class="col-12"><label class="form-label">URL</label><input class="form-control" asp-for="Input.Url" data-input="url" /></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" data-role="create-submit" formaction="?handler=Add">Create</button>
                    <button type="submit" class="btn btn-primary d-none" data-role="edit-submit" formaction="?handler=Edit">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
