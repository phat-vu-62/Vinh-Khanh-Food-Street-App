@page "/"
@inject IAdminDataService DataService
@inject ToastService Toasts

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Dashboard</h1>
        <small class="text-muted">Overview of live FoodStreet content</small>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary d-flex align-items-center gap-2" @onclick="TranslateAllPois" disabled="@_isTranslating">
            @if (_isTranslating)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span>Translating...</span>
            }
            else
            {
                <span>🌐 Translate All POIs</span>
            }
        </button>
        <button class="btn btn-outline-primary" @onclick="LoadAsync" disabled="@_isTranslating">Refresh</button>
    </div>
</div>

<LoadingState IsLoading="_isLoading" Message="Loading dashboard data..." />

@if (!_isLoading)
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card stats-card">
                <div class="card-body">
                    <div class="stats-title">POIs</div>
                    <div class="stats-value">@Pois.Count</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stats-card">
                <div class="card-body">
                    <div class="stats-title">Audios</div>
                    <div class="stats-value">@Audios.Count</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stats-card">
                <div class="card-body">
                    <div class="stats-title">Tours</div>
                    <div class="stats-value">@Tours.Count</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stats-card">
                <div class="card-body">
                    <div class="stats-title">Active POIs</div>
                    <div class="stats-value">@Pois.Count(x => x.IsActive)</div>
                </div>
            </div>
        </div>
    </div>

    <section class="module-panel">
        <h2 class="h6 mb-3">Recent POIs</h2>
        @if (Pois.Count == 0)
        {
            <div class="empty-state">No POIs available yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Location</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var poi in Pois.Take(8))
                        {
                            <tr>
                                <td>@poi.Name</td>
                                <td>@poi.Latitude.ToString("0.00000"), @poi.Longitude.ToString("0.00000")</td>
                                <td>
                                    <span class="badge @(poi.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                        @(poi.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    private IReadOnlyCollection<POI> Pois = [];
    private IReadOnlyCollection<Audio> Audios = [];
    private IReadOnlyCollection<Tour> Tours = [];
    private bool _isLoading;
    private bool _isTranslating;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            Pois = DataService.GetPois();
            Audios = DataService.GetAudios();
            Tours = DataService.GetTours();
        }
        catch
        {
            Toasts.Error("Cannot load dashboard data.");
        }
        finally
        {
            _isLoading = false;
        }

        return Task.CompletedTask;
    }

    private async Task TranslateAllPois()
    {
        if (_isTranslating) return;

        try
        {
            _isTranslating = true;
            int count = await DataService.TranslateAllPoisAsync();
            Toasts.Success($"✔ Translated {count} POIs successfully");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toasts.Error($"Failed to translate POIs: {ex.Message}");
        }
        finally
        {
            _isTranslating = false;
        }
    }
}
