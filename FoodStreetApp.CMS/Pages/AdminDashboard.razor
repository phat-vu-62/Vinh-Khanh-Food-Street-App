@page "/"
@page "/dashboard"
@using FoodStreetApp.CMS.Models
@using FoodStreetApp.CMS.Components
@inject IAdminDataService DataService
@inject ToastService Toasts
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="h3 fw-bold mb-1">Tổng quan hệ thống</h1>
        <p class="text-muted mb-0">Hoạt động thời gian thực tại Phố ẩm thực Vinh Khánh.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-saas btn-saas-secondary" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise me-1"></i> Làm mới</button>
    </div>
</div>

@if (_isLoading)
{
    <div class="row g-4 mb-5">
        @for (int i = 0; i < 4; i++) {
            <div class="col-md-3">
                <div class="saas-card stats-card">
                    <SkeletonLoader Height="20px" Width="60%" Class="mb-3" />
                    <SkeletonLoader Height="32px" Width="80%" />
                </div>
            </div>
        }
    </div>
    <div class="row g-4 mb-5">
        <div class="col-lg-8"><div class="saas-card p-4"><SkeletonLoader Height="250px" /></div></div>
        <div class="col-lg-4"><div class="saas-card p-4"><SkeletonLoader Height="250px" /></div></div>
    </div>
}
else
{
    <!-- 4 Summary Cards -->
    <div class="row g-4 mb-5">
        <div class="col-xl col-md-6 col-lg-4">
            <div class="saas-card stats-card border-primary h-100">
                <span class="stats-label">Tổng địa điểm</span>
                <div class="d-flex align-items-baseline justify-content-between">
                    <span class="stats-value">@_poiCount.ToString("N0")</span>
                    <i class="bi bi-geo-alt text-primary"></i>
                </div>
                <div class="progress mt-3" style="height: 4px;">
                    <div class="progress-bar bg-primary" style="width: 100%;"></div>
                </div>
            </div>
        </div>
        <div class="col-xl col-md-6 col-lg-4">
            <div class="saas-card stats-card border-success h-100">
                <span class="stats-label">Tệp âm thanh</span>
                <div class="d-flex align-items-baseline justify-content-between">
                    <span class="stats-value">@_audioCount.ToString("N0")</span>
                    <i class="bi bi-file-music text-success"></i>
                </div>
                <div class="progress mt-3" style="height: 4px;">
                    <div class="progress-bar bg-success" style="width: 100%;"></div>
                </div>
            </div>
        </div>
        <div class="col-xl col-md-6 col-lg-4">
            <div class="saas-card stats-card border-danger h-100 @(_summary.PendingApprovals > 0 ? "border-2 shadow-sm" : "opacity-75")">
                <span class="stats-label">Địa điểm chờ duyệt</span>
                <div class="d-flex align-items-baseline justify-content-between">
                    <span class="stats-value @(_summary.PendingApprovals > 0 ? "animate__animated animate__headShake animate__infinite d-inline-block" : "")">@_summary.PendingApprovals</span>
                    <i class="bi bi-shield-lock @(_summary.PendingApprovals > 0 ? "text-danger" : "text-muted")"></i>
                </div>
                <div class="mt-3">
                    @if (_summary.PendingApprovals > 0)
                    {
                        <a href="/poi?filter=pending" class="btn btn-sm btn-outline-danger w-100 border-0 bg-danger bg-opacity-10 py-1" style="font-size: 0.7rem;">Duyệt ngay <i class="bi bi-arrow-right"></i></a>
                    }
                    else
                    {
                        <span class="text-muted x-small">Đã duyệt tất cả</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-xl col-md-6 col-lg-6">
            <div class="saas-card stats-card border-info h-100">
                <span class="stats-label">Lượt tương tác</span>
                <div class="d-flex align-items-baseline justify-content-between">
                    <span class="stats-value">@_summary.TotalPoiViewed.ToString("N0")</span>
                    <span class="small text-info fw-bold">Live</span>
                </div>
                <div class="progress mt-3" style="height: 4px;">
                    <div class="progress-bar bg-info" style="width: 100%;"></div>
                </div>
            </div>
        </div>
        <div class="col-xl col-md-6 col-lg-6">
            <div class="saas-card stats-card border-warning h-100">
                <span class="stats-label">Nghe trung bình</span>
                <div class="d-flex align-items-baseline justify-content-between">
                    <span class="stats-value">@_summary.AvgDurationSeconds.ToString("0.0")s</span>
                    <i class="bi bi-clock-history text-warning"></i>
                </div>
                <div class="progress mt-3" style="height: 4px;">
                    <div class="progress-bar bg-warning" style="width: 100%;"></div>
                </div>
            </div>
        </div>
    </div>



    <div class="row g-4 mb-5">
        <!-- SVG Line Chart: Activity -->
        <div class="col-lg-8">
            <div class="saas-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h6 class="fw-bold mb-0">Biểu đồ hoạt động (7 ngày qua)</h6>
                        <small class="text-muted">Cập nhật lúc: @_lastUpdated.ToString("HH:mm:ss")</small>
                    </div>
                </div>
                
                <div class="chart-container py-3" style="height: 250px;">
                    <svg width="100%" height="200" viewBox="0 0 1000 200" preserveAspectRatio="none">
                        <line x1="0" y1="50" x2="1000" y2="50" stroke="#f1f5f9" />
                        <line x1="0" y1="100" x2="1000" y2="100" stroke="#f1f5f9" />
                        <line x1="0" y1="150" x2="1000" y2="150" stroke="#f1f5f9" />
                        
                        <polyline points="@GenerateTrendPoints(true)" fill="none" stroke="var(--primary-color)" stroke-width="3" />
                        <path d="M 0 200 L @GenerateTrendPoints(true) L 1000 200 Z" fill="var(--primary-color)" opacity="0.05" />
                    </svg>
                    <div class="d-flex justify-content-between mt-3 px-1 x-small text-muted">
                        @foreach (var t in _summary.DailyTrends) { <span>@t.Date.ToString("dd/MM")</span> }
                    </div>
                </div>
            </div>
        </div>

        <!-- SVG Bar Chart: Top Locations -->
        <div class="col-lg-4">
            <div class="saas-card p-4 h-100">
                <h6 class="fw-bold mb-4">Top địa điểm phổ biến</h6>
                <div class="d-flex flex-column gap-4">
                    @if (!_summary.TopPois.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox mb-2" style="font-size: 2rem;"></i>
                            <p class="small">Chưa có dữ liệu</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var p in _summary.TopPois)
                        {
                            <div>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-semibold">@p.PoiName</span>
                                    <span class="text-muted">@p.Count lượt</span>
                                </div>
                                <div class="d-flex gap-1 align-items-center mb-1">
                                    <span class="badge @(string.IsNullOrWhiteSpace(p.NameVi) || p.NameVi == p.PoiName ? "bg-light text-muted" : "bg-success-subtle text-success") border x-small px-1" title="Vietnamese">VI</span>
                                    <span class="badge @(string.IsNullOrWhiteSpace(p.NameEn) ? "bg-light text-muted" : "bg-success-subtle text-success") border x-small px-1" title="English">EN</span>
                                    <span class="badge @(string.IsNullOrWhiteSpace(p.NameZh) ? "bg-light text-muted" : "bg-success-subtle text-success") border x-small px-1" title="Chinese">ZH</span>
                                    <span class="badge @(string.IsNullOrWhiteSpace(p.NameKo) ? "bg-light text-muted" : "bg-success-subtle text-success") border x-small px-1" title="Korean">KO</span>
                                    <span class="badge @(string.IsNullOrWhiteSpace(p.NameJa) ? "bg-light text-muted" : "bg-success-subtle text-success") border x-small px-1" title="Japanese">JA</span>
                                </div>
                                <div class="progress" style="height: 12px; border-radius: 6px;">
                                    <div class="progress-bar bg-primary" 
                                         style="width: @(Math.Min(100, (p.Count * 100 / (_summary.TopPois.First().Count))))%;"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private AnalyticsSummary _summary = new();
    private int _poiCount;
    private int _audioCount;
    private DateTime _lastUpdated;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _lastUpdated = DateTime.Now;
        
        try
        {
            // Move fast queries to a separate block if needed, but for now we defer everything heavy
            _poiCount = DataService.GetPois().Count(p => p.IsApproved);
            _audioCount = DataService.GetAudios().Count;
            
            _summary = await DataService.GetAnalyticsSummaryAsync();
        }
        catch (Exception ex)
        {
            Toasts.Error($"Lỗi khi tải dữ liệu dashboard: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GenerateTrendPoints(bool isListen)
    {
        if (!_summary.DailyTrends.Any()) return "0,200 1000,200";
        var points = new List<string>();
        var maxVal = Math.Max(1, _summary.DailyTrends.Max(t => Math.Max(t.Views, t.Listens)));
        for (int i = 0; i < _summary.DailyTrends.Count; i++)
        {
            var x = i * 1000 / Math.Max(1, _summary.DailyTrends.Count - 1);
            var val = isListen ? _summary.DailyTrends[i].Listens : _summary.DailyTrends[i].Views;
            var y = 180 - (val * 160 / maxVal);
            points.Add($"{x},{y}");
        }
        return string.Join(" ", points);
    }
}
