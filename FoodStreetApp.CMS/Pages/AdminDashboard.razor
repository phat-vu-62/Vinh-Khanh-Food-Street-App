@page "/"
@page "/dashboard"
@using FoodStreetApp.CMS.Models
@using FoodStreetApp.CMS.Components
@using System.Text.Json
@inject IAdminDataService DataService
@inject HttpClient Http
@inject ToastService Toasts
@inject IJSRuntime JSRuntime
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@implements IDisposable

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="h3 fw-bold mb-1">Quản trị hệ thống</h1>
        <p class="text-muted mb-0">Phân tích hoạt động thời gian thực tại Phố ẩm thực Vĩnh Khánh.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-saas btn-saas-secondary" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise me-1"></i> Làm mới</button>
    </div>
</div>

@if (_isLoading)
{
    <div class="row g-4 mb-5">
        @for (int i = 0; i < 5; i++) {
            <div class="col">
                <div class="saas-card stats-card">
                    <SkeletonLoader Height="20px" Width="60%" Class="mb-3" />
                    <SkeletonLoader Height="32px" Width="80%" />
                </div>
            </div>
        }
    </div>
    <div class="row g-4 mb-5">
        <div class="col-lg-8"><div class="saas-card p-4"><SkeletonLoader Height="300px" /></div></div>
        <div class="col-lg-4"><div class="saas-card p-4"><SkeletonLoader Height="300px" /></div></div>
    </div>
}
else
{
    @* ═══════════════════════════════════════════════════
       ROW 1: KPI CARDS
    ═══════════════════════════════════════════════════ *@
    <div class="row g-4 mb-4">
        <div class="col-xl col-md-4">
            <div class="saas-card stats-card border-primary h-100">
                <span class="stats-label">Tổng địa điểm</span>
                <div class="d-flex align-items-baseline justify-content-between">
                    <span class="stats-value">@_data.TotalPois</span>
                    <i class="bi bi-geo-alt text-primary"></i>
                </div>
                <div class="progress mt-3" style="height: 4px;"><div class="progress-bar bg-primary" style="width: 100%;"></div></div>
            </div>
        </div>

        <div class="col-xl col-md-6">
            <div class="saas-card stats-card border-warning h-100">
                <span class="stats-label">Tổng doanh thu</span>
                <div class="d-flex align-items-baseline justify-content-between">
                    <span class="stats-value" style="font-size: 1.1rem;">@_data.TotalRevenue.ToString("N0")₫</span>
                    <i class="bi bi-cash-stack text-warning"></i>
                </div>
                @if (_data.RevenueRefund > 0)
                {
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger mt-2" style="font-size: 0.65rem;">
                        <i class="bi bi-arrow-return-left me-1"></i>Hoàn: -@_data.RevenueRefund.ToString("N0")₫
                    </span>
                }
                else
                {
                    <div class="progress mt-3" style="height: 4px;"><div class="progress-bar bg-warning" style="width: 100%;"></div></div>
                }
            </div>
        </div>
        <div class="col-xl col-md-6">
            <div class="saas-card stats-card h-100 @((_data.ActiveUsersNow + _data.ActiveQrUsersNow) > 0 ? "border-2 shadow-sm" : "opacity-75")" style="border-left: 3px solid #10b981;">
                <span class="stats-label">Đang trực tuyến</span>
                <div class="d-flex align-items-baseline justify-content-between">
                    <span class="stats-value @((_data.ActiveUsersNow + _data.ActiveQrUsersNow) > 0 ? "animate__animated animate__flash animate__infinite animate__slow" : "")">@(_data.ActiveUsersNow + _data.ActiveQrUsersNow)</span>
                    <span class="small fw-bold" style="color: #10b981;">
                        @if ((_data.ActiveUsersNow + _data.ActiveQrUsersNow) > 0) { <span>● Online</span> } else { <span class="text-muted">Offline</span> }
                    </span>
                </div>
                @if ((_data.ActiveUsersNow + _data.ActiveQrUsersNow) > 0)
                {
                    <div class="d-flex gap-2 mt-2">
                        @if (_data.ActiveUsersNow > 0) { <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle" style="font-size: 0.65rem;"><i class="bi bi-phone me-1"></i>App: @_data.ActiveUsersNow</span> }
                        @if (_data.ActiveQrUsersNow > 0) { <span class="badge bg-info bg-opacity-10 text-info border border-info-subtle" style="font-size: 0.65rem;"><i class="bi bi-qr-code me-1"></i>QR: @_data.ActiveQrUsersNow</span> }
                    </div>
                }
            </div>
        </div>
    </div>

    @* ═══════════════════════════════════════════════════
       ROW 2: ACTIVITY LINE CHART + TOP 10 POIs BAR
    ═══════════════════════════════════════════════════ *@
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="saas-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h6 class="fw-bold mb-0"><i class="bi bi-graph-up me-2 text-primary"></i>Hoạt động 30 ngày qua</h6>
                        <small class="text-muted">Cập nhật lúc: @_lastUpdated.ToString("HH:mm:ss")</small>
                    </div>
                </div>
                <div style="height: 280px;"><canvas id="chartActivity"></canvas></div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="saas-card p-4 h-100">
                <h6 class="fw-bold mb-3"><i class="bi bi-trophy me-2 text-warning"></i>Top 10 địa điểm</h6>
                <div style="height: 280px;"><canvas id="chartTop10"></canvas></div>
            </div>
        </div>
    </div>

    @* ═══════════════════════════════════════════════════
       ROW 3: REVENUE LINE + REVENUE DOUGHNUT
    ═══════════════════════════════════════════════════ *@
    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <div class="saas-card p-4 h-100">
                <h6 class="fw-bold mb-3"><i class="bi bi-currency-dollar me-2 text-success"></i>Doanh thu theo ngày (30 ngày)</h6>
                <div style="height: 260px;"><canvas id="chartRevenue"></canvas></div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="saas-card p-4 h-100">
                <h6 class="fw-bold mb-3"><i class="bi bi-pie-chart me-2 text-info"></i>Phân bổ doanh thu theo POI</h6>
                @if (_data.RevenueByPoi.Any())
                {
                    <div style="height: 260px;"><canvas id="chartRevPie"></canvas></div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox mb-2" style="font-size: 2rem;"></i>
                        <p class="small">Chưa có dữ liệu doanh thu</p>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ═══════════════════════════════════════════════════
       ROW 4: PEAK HOURS + USER BEHAVIOR
    ═══════════════════════════════════════════════════ *@
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="saas-card p-4 h-100">
                <h6 class="fw-bold mb-3"><i class="bi bi-clock me-2 text-danger"></i>Giờ cao điểm (UTC+7)</h6>
                <div style="height: 240px;"><canvas id="chartPeakHours"></canvas></div>
            </div>
        </div>
    </div>

    @* ═══════════════════════════════════════════════════
       ROW 5: HEATMAP
    ═══════════════════════════════════════════════════ *@
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="saas-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h6 class="fw-bold mb-0"><i class="bi bi-fire text-danger me-2"></i>Bản đồ nhiệt tương tác (Heatmap)</h6>
                        <small class="text-muted">Mật độ tương tác thực tế tại các khu vực (30 ngày)</small>
                    </div>
                </div>
                <div id="admin-heatmap" style="height: 400px; border-radius: 16px; z-index: 1;"></div>
            </div>
        </div>
    </div>


}

@code {
    private AdminDashboardData _data = new();
    private bool _isLoading = true;
    private DateTime _lastUpdated = DateTime.UtcNow.AddHours(7);
    private System.Timers.Timer? _refreshTimer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();

            // Auto-refresh every 5 seconds (less aggressive than 2s for heavier dashboard)
            _refreshTimer = new System.Timers.Timer(5000);
            _refreshTimer.Elapsed += async (sender, e) => await InvokeAsync(SilentRefreshAsync);
            _refreshTimer.Start();
        }

        // Render charts after data is ready
        if (!_isLoading && _chartsNeedRender)
        {
            _chartsNeedRender = false;
            await RenderAllChartsAsync();
            await RenderHeatmapAsync();
        }
    }

    private bool _chartsNeedRender;

    private async Task SilentRefreshAsync()
    {
        try
        {
            var (activeUsers, activeQr, totalScans, uniqueUsers) = await DataService.GetLiveMetricsAsync();
            _data.ActiveUsersNow = activeUsers;
            _data.ActiveQrUsersNow = activeQr;
            _data.TotalQrScans = totalScans;
            _data.TotalUniqueUsers = uniqueUsers;
            _lastUpdated = DateTime.UtcNow.AddHours(7);
            StateHasChanged();
        }
        catch { /* ignore silent refresh errors */ }
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    private bool _isRefreshing;

    private async Task LoadAsync()
    {
        if (_isRefreshing) return;
        _isRefreshing = true;
        _isLoading = true;
        _lastUpdated = DateTime.UtcNow.AddHours(7);

        try
        {
            _data = await DataService.GetAdminDashboardAsync();

            _chartsNeedRender = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dashboard LoadAsync error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            _isRefreshing = false;
        }
    }

    private async Task RenderAllChartsAsync()
    {
        try
        {
            // 1. Activity Line Chart (30d)
            if (_data.DailyActivity.Any())
            {
                var labels = _data.DailyActivity.Select(d => d.Date.ToString("dd/MM")).ToArray();
                var datasets = new object[] {
                    new { label = "Xem địa điểm", data = _data.DailyActivity.Select(d => d.Views).ToArray(), color = "#4f46e5" },
                    new { label = "Nghe âm thanh", data = _data.DailyActivity.Select(d => d.Listens).ToArray(), color = "#10b981" }
                };
                await JSRuntime.InvokeVoidAsync("chartHelper.renderLineChart", "chartActivity", labels, datasets);
            }

            // 2. Top 10 POIs Stacked Bar (Xem + Nghe)
            if (_data.Top10Pois.Any())
            {
                var labels = _data.Top10Pois.Select(p => p.PoiName).Reverse().ToArray();
                var datasets = new object[] {
                    new { label = "Lượt xem", data = _data.Top10Pois.Select(p => p.ViewCount).Reverse().ToArray(), color = "#3b82f6" },
                    new { label = "Lượt nghe", data = _data.Top10Pois.Select(p => p.ListenCount).Reverse().ToArray(), color = "#10b981" }
                };
                await JSRuntime.InvokeVoidAsync("chartHelper.renderStackedBarChart", "chartTop10", labels, datasets, true);
            }

            // 3. Revenue Line Chart
            if (_data.RevenueByDay.Any())
            {
                var labels = _data.RevenueByDay.Select(d => d.Date.ToString("dd/MM")).ToArray();
                var datasets = new object[] {
                    new { label = "Doanh thu (₫)", data = _data.RevenueByDay.Select(d => (double)d.Amount).ToArray(), color = "#10b981" }
                };
                await JSRuntime.InvokeVoidAsync("chartHelper.renderLineChart", "chartRevenue", labels, datasets);
            }

            // 4. Revenue Doughnut
            if (_data.RevenueByPoi.Any())
            {
                var labels = _data.RevenueByPoi.Select(p => p.PoiName).ToArray();
                var data = _data.RevenueByPoi.Select(p => (double)p.Revenue).ToArray();
                await JSRuntime.InvokeVoidAsync("chartHelper.renderDoughnutChart", "chartRevPie", labels, data, (object?)null);
            }

            // 5. Peak Hours Bar
            if (_data.PeakHours.Any())
            {
                // Reorder by Vietnam time (UTC+7) so chart reads 0h-23h VN
                var vnOrdered = _data.PeakHours
                    .Select(h => new { VnHour = (h.Hour + 7) % 24, h.Count })
                    .OrderBy(h => h.VnHour)
                    .ToList();
                var labels = vnOrdered.Select(h => $"{h.VnHour}h").ToArray();
                var data = vnOrdered.Select(h => h.Count).ToArray();
                var maxCount = vnOrdered.Max(x => x.Count);
                var colors = vnOrdered.Select(h => h.Count == maxCount && maxCount > 0 ? "#ef4444" : "#94a3b8").ToArray();
                await JSRuntime.InvokeVoidAsync("chartHelper.renderBarChart", "chartPeakHours", labels, data, colors, false);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Chart render error: {ex.Message}");
        }
    }

    private async Task RenderHeatmapAsync()
    {
        try
        {
            var data = await DataService.GetHeatmapDataAsync(null);
            var heatData = new List<double[]>();

            // Build heat layer from interaction data
            if (data.Any())
            {
                var maxCount = data.Max(x => x.ScanCount);
                foreach (var item in data)
                {
                    double intensity = maxCount > 0 ? (double)item.ScanCount / maxCount : 0.5;
                    heatData.Add(new double[] { item.Lat, item.Lng, Math.Max(0.2, intensity) });
                }
            }

            // Get ALL approved POIs for pins (not just those with data)
            var allPois = DataService.GetPois().Where(p => p.IsApproved && p.Latitude != 0 && p.Longitude != 0).ToList();
            var dataDict = data.ToDictionary(x => x.PoiId, x => x.ScanCount);
            var poiLabels = allPois.Select(p => new {
                lat = p.Latitude,
                lng = p.Longitude,
                name = p.Name,
                count = dataDict.GetValueOrDefault(p.Id, 0)
            }).ToList<object>();

            await JSRuntime.InvokeVoidAsync("renderHeatmap", "admin-heatmap", heatData, poiLabels);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Heatmap Render Error: {ex.Message}");
        }
    }
}
