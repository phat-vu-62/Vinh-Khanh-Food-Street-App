@page "/translations"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin, Owner")]
@inject IAdminDataService DataService
@inject ToastService Toasts
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="h3 fw-bold mb-1">Thư viện bản dịch</h1>
        <p class="text-muted mb-0">Quản lý và cập nhật nội dung đa ngôn ngữ hỗ trợ bởi AI.</p>
    </div>
    <div class="d-flex gap-2">
        <div class="dropdown">
            <button class="btn btn-saas btn-saas-secondary dropdown-toggle shadow-sm" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-translate me-1"></i> @_selectedLanguage.ToUpper()
            </button>
            <ul class="dropdown-menu border-0 shadow-lg">
                @foreach (var language in _languages)
                {
                    <li><button class="dropdown-item" @onclick='() => { _selectedLanguage = language; StateHasChanged(); }'>
                        @(language == "vi" ? "Tiếng Việt 🇻🇳" : language == "en" ? "English 🇺🇸" : language == "zh" ? "Chinese 🇨🇳" : language == "ko" ? "Korean 🇰🇷" : "Japanese 🇯🇵")
                    </button></li>
                }
            </ul>
        </div>
        <AuthorizeView Roles="Admin">
            <button class="btn btn-saas btn-saas-primary shadow-sm" @onclick="TranslateAllAsync" disabled="@_isTranslatingAll">
                @if (_isTranslatingAll)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                <i class="bi bi-stars"></i> Dịch AI toàn bộ
            </button>
        </AuthorizeView>
    </div>
</div>

<LoadingState IsLoading="_isLoading" Message="Đang xử lý ngôn ngữ..." />

@if (!_isLoading)
{
    @if (_pois.Count == 0)
    {
        <div class="saas-card p-5 text-center">
            <i class="bi bi-globe-americas text-light" style="font-size: 3rem;"></i>
            <h5 class="fw-bold mt-3">Chưa có nội dung cần dịch</h5>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var poi in _pois.OrderBy(x => x.Name))
            {
                <div class="saas-card border-0 shadow-sm overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-primary-soft text-primary p-2 rounded-3">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>
                            <h5 class="fw-bold m-0 text-dark">@poi.Name</h5>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (IsFullyTranslated(poi))
                            {
                                <span class="saas-badge badge-active"><i class="bi bi-check-circle-fill me-1"></i> Đã hoàn tất</span>
                            }
                            else
                            {
                                <span class="saas-badge badge-highlight"><i class="bi bi-exclamation-circle-fill me-1"></i> Cần bổ sung</span>
                            }
                            <button class="btn btn-saas btn-saas-primary btn-sm ms-3" @onclick="() => SavePoiAsync(poi)">
                                <i class="bi bi-save me-1"></i> Lưu bản dịch
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <!-- Cột Gốc (Tiếng Việt) -->
                            <div class="col-lg-5">
                                <div class="p-3 bg-light rounded-4 h-100">
                                    <div class="small text-uppercase fw-bold text-muted mb-3"><i class="bi bi-chat-left-dots me-1"></i> Nội dung gốc (VI)</div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-dark opacity-50">Tên hiển thị</label>
                                        <div class="p-2 bg-white border rounded-2 small">@poi.Name</div>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-dark opacity-50">Mô tả ngắn</label>
                                        <div class="p-2 bg-white border rounded-2 small">@poi.Description</div>
                                    </div>

                                    <div>
                                        <label class="form-label small fw-bold text-dark opacity-50">Bài thuyết minh (Narrator Script)</label>
                                        <div class="p-2 bg-white border rounded-2 small" style="min-height: 80px; white-space: pre-wrap;">@poi.TextContent</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Mũi tên chuyển đổi -->
                            <div class="col-lg-1 d-none d-lg-flex align-items-center justify-content-center">
                                <i class="bi bi-arrow-right-circle-fill text-primary" style="font-size: 1.5rem;"></i>
                            </div>

                            <!-- Cột Bản dịch -->
                            <div class="col-lg-6">
                                <div class="p-3 border border-primary-soft rounded-4 h-100 bg-white shadow-inner-sm">
                                    <div class="small text-uppercase fw-bold text-primary mb-3"><i class="bi bi-translate me-1"></i> Bản dịch (@_selectedLanguage.ToUpper())</div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label-saas small">Tên địa điểm</label>
                                        <input type="text" class="form-control form-control-saas" 
                                               placeholder="Nhập tên..."
                                               value="@GetNameTranslation(poi, _selectedLanguage)" 
                                               @onchange="@(e => SetNameTranslation(poi, _selectedLanguage, e.Value?.ToString()))" />
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label-saas small">Mô tả du lịch</label>
                                        <textarea class="form-control form-control-saas" rows="2"
                                               placeholder="Nhập mô tả..."
                                               value="@GetDescriptionTranslation(poi, _selectedLanguage)" 
                                               @onchange="@(e => SetDescriptionTranslation(poi, _selectedLanguage, e.Value?.ToString()))"></textarea>
                                    </div>

                                    <div>
                                        <label class="form-label-saas small">Bài thuyết minh (Narrator Script)</label>
                                        <textarea class="form-control form-control-saas" rows="3"
                                               placeholder="Dịch bài thuyết minh..."
                                               value="@GetTextContentTranslation(poi, _selectedLanguage)" 
                                               @onchange="@(e => SetTextContentTranslation(poi, _selectedLanguage, e.Value?.ToString()))"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private readonly List<POI> _pois = [];
    private readonly string[] _languages = ["en", "zh", "ko", "ja"];
    private string _selectedLanguage = "en";
    private bool _isLoading;
    private bool _isTranslatingAll;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            _pois.Clear();
            var data = DataService.GetPois();
            if (data != null)
            {
                var authState = await AuthProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                var isOwner = user.IsInRole("Owner");
                var userIdStr = user.Claims.FirstOrDefault(c => c.Type == "userId")?.Value;

                var query = data.Where(x => x.IsApproved);
                if (isOwner && Guid.TryParse(userIdStr, out var uId))
                {
                    query = query.Where(x => x.OwnerId == uId);
                }

                _pois.AddRange(query);
            }
        }
        catch (Exception ex)
        {
            Toasts.Error("Không thể tải danh sách bản dịch.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SavePoiAsync(POI poi)
    {
        try
        {
            DataService.UpdatePoi(poi);
            Toasts.Success($"Đã lưu bản dịch cho {poi.Name} thành công!");
        }
        catch
        {
            Toasts.Error("Không thể lưu bản dịch.");
        }
    }

    private bool IsFullyTranslated(POI poi)
    {
        return !string.IsNullOrEmpty(GetNameTranslation(poi, _selectedLanguage)) &&
               !string.IsNullOrEmpty(GetDescriptionTranslation(poi, _selectedLanguage)) &&
               !string.IsNullOrEmpty(GetTextContentTranslation(poi, _selectedLanguage));
    }

    private async Task TranslateAllAsync()
    {
        try
        {
            _isTranslatingAll = true;
            var translatedCount = await DataService.TranslateAllPoisAsync();
            if (translatedCount > 0)
            {
                Toasts.Success($"✔ Đã dịch thành công {translatedCount} POI.");
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            Toasts.Error($"❌ Tự động dịch thất bại: {ex.Message}");
        }
        finally
        {
            _isTranslatingAll = false;
        }
    }

    private static string? GetNameTranslation(POI poi, string language) => language switch
    {
        "vi" => poi.NameVi,
        "en" => poi.NameEn,
        "zh" => poi.NameZh,
        "ko" => poi.NameKo,
        "ja" => poi.NameJa,
        _ => poi.NameEn
    };

    private static string? GetDescriptionTranslation(POI poi, string language) => language switch
    {
        "vi" => poi.DescriptionVi,
        "en" => poi.DescriptionEn,
        "zh" => poi.DescriptionZh,
        "ko" => poi.DescriptionKo,
        "ja" => poi.DescriptionJa,
        _ => poi.DescriptionEn
    };

    private static string? GetTextContentTranslation(POI poi, string language) => language switch
    {
        "vi" => poi.TextContentVi,
        "en" => poi.TextContentEn,
        "zh" => poi.TextContentZh,
        "ko" => poi.TextContentKo,
        "ja" => poi.TextContentJa,
        _ => poi.TextContentEn
    };

    private static void SetNameTranslation(POI poi, string language, string? value)
    {
        switch (language)
        {
            case "vi": poi.NameVi = value; break;
            case "en": poi.NameEn = value; break;
            case "zh": poi.NameZh = value; break;
            case "ko": poi.NameKo = value; break;
            case "ja": poi.NameJa = value; break;
        }
    }

    private static void SetDescriptionTranslation(POI poi, string language, string? value)
    {
        switch (language)
        {
            case "vi": poi.DescriptionVi = value; break;
            case "en": poi.DescriptionEn = value; break;
            case "zh": poi.DescriptionZh = value; break;
            case "ko": poi.DescriptionKo = value; break;
            case "ja": poi.DescriptionJa = value; break;
        }
    }

    private static void SetTextContentTranslation(POI poi, string language, string? value)
    {
        switch (language)
        {
            case "vi": poi.TextContentVi = value; break;
            case "en": poi.TextContentEn = value; break;
            case "zh": poi.TextContentZh = value; break;
            case "ko": poi.TextContentKo = value; break;
            case "ja": poi.TextContentJa = value; break;
        }
    }
}
