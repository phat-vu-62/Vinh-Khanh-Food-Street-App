@page "/translations"
@inject IAdminDataService DataService
@inject ToastService Toasts

<div class="d-flex justify-content-between align-items-center mb-3 text-white">
    <div>
        <h1 class="h4 mb-0">Translations</h1>
        <small class="text-white-50">Review and edit POI translations by language</small>
    </div>
    <div class="d-flex gap-2">
        <select class="form-select bg-dark text-white border-secondary" style="min-width: 120px;" @bind="_selectedLanguage">
            @foreach (var language in _languages)
            {
                <option value="@language">@language.ToUpper()</option>
            }
        </select>
        <button class="btn btn-primary" @onclick="TranslateAllAsync" disabled="@_isTranslatingAll">
            @if (_isTranslatingAll)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                <span>Đang dịch...</span>
            }
            else
            {
                <span>Dịch tất cả POI</span>
            }
        </button>
    </div>
</div>

<section class="module-panel">
    <LoadingState IsLoading="_isLoading" Message="Đang tải bản dịch..." />

    @if (!_isLoading && _pois.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-translate empty-icon"></i>
            <div class="empty-title">Không tìm thấy điểm tham quan nào</div>
            <div class="empty-description">Hãy thêm điểm tham quan trước, sau đó bạn có thể quản lý bản dịch đa ngôn ngữ tại đây.</div>
        </div>
    }
    else if (!_isLoading)
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th>POI</th>
                        <th>Original Text</th>
                        <th>Translated Text (@_selectedLanguage.ToUpper())</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var poi in _pois.OrderBy(x => x.Name))
                    {
                        <tr>
                            <td>
                                <strong>@poi.Name</strong>
                                <div class="small text-muted">Tên</div>
                            </td>
                            <td>@poi.Name</td>
                            <td>
                                <input type="text" class="form-control" 
                                       value="@GetNameTranslation(poi, _selectedLanguage)" 
                                       @onchange="@(e => SetNameTranslation(poi, _selectedLanguage, e.Value?.ToString()))" />
                            </td>
                            <td class="text-end" rowspan="2" style="vertical-align: middle;">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => SavePoiAsync(poi)">Lưu thay đổi</button>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>@poi.Name</strong>
                                <div class="small text-muted">Mô tả</div>
                            </td>
                            <td class="text-muted" style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@poi.Description</td>
                            <td>
                                <input type="text" class="form-control" 
                                       value="@GetDescriptionTranslation(poi, _selectedLanguage)" 
                                       @onchange="@(e => SetDescriptionTranslation(poi, _selectedLanguage, e.Value?.ToString()))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private readonly List<POI> _pois = [];
    private readonly string[] _languages = ["vi", "en", "zh", "ko", "ja"];
    private string _selectedLanguage = "en";
    private bool _isLoading;
    private bool _isTranslatingAll;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            _pois.Clear();
            var data = DataService.GetPois();
            if (data != null)
            {
                _pois.AddRange(data);
            }
        }
        catch (Exception ex)
        {
            Toasts.Error("Không thể tải danh sách bản dịch.");
        }
        finally
        {
            _isLoading = false;
        }

        return Task.CompletedTask;
    }

    private async Task SavePoiAsync(POI poi)
    {
        try
        {
            DataService.UpdatePoi(poi);
            Toasts.Success("Đã lưu bản dịch thành công.");
        }
        catch
        {
            Toasts.Error("Không thể lưu bản dịch.");
        }
    }

    private async Task TranslateAllAsync()
    {
        try
        {
            _isTranslatingAll = true;
            var translatedCount = await DataService.TranslateAllPoisAsync();
            if (translatedCount > 0)
            {
                Toasts.Success($"✔ Đã dịch thành công {translatedCount} POI.");
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            Toasts.Error($"❌ Tự động dịch thất bại: {ex.Message}");
        }
        finally
        {
            _isTranslatingAll = false;
        }
    }

    private static string? GetNameTranslation(POI poi, string language) => language switch
    {
        "vi" => poi.NameVi,
        "en" => poi.NameEn,
        "zh" => poi.NameZh,
        "ko" => poi.NameKo,
        "ja" => poi.NameJa,
        _ => poi.NameEn
    };

    private static string? GetDescriptionTranslation(POI poi, string language) => language switch
    {
        "vi" => poi.DescriptionVi,
        "en" => poi.DescriptionEn,
        "zh" => poi.DescriptionZh,
        "ko" => poi.DescriptionKo,
        "ja" => poi.DescriptionJa,
        _ => poi.DescriptionEn
    };

    private static void SetNameTranslation(POI poi, string language, string? value)
    {
        switch (language)
        {
            case "vi": poi.NameVi = value; break;
            case "en": poi.NameEn = value; break;
            case "zh": poi.NameZh = value; break;
            case "ko": poi.NameKo = value; break;
            case "ja": poi.NameJa = value; break;
        }
    }

    private static void SetDescriptionTranslation(POI poi, string language, string? value)
    {
        switch (language)
        {
            case "vi": poi.DescriptionVi = value; break;
            case "en": poi.DescriptionEn = value; break;
            case "zh": poi.DescriptionZh = value; break;
            case "ko": poi.DescriptionKo = value; break;
            case "ja": poi.DescriptionJa = value; break;
        }
    }
}
