@page "/translations"
@inject IAdminDataService DataService
@inject ToastService Toasts

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-0 text-orange">Bản dịch đa ngôn ngữ</h1>
        <p class="text-muted mb-0">Quản lý nội dung hiển thị cho khách du lịch quốc tế</p>
    </div>
    <div class="d-flex gap-3">
        <div class="input-group" style="width: 200px;">
            <span class="input-group-text bg-white border-end-0 rounded-start-3"><i class="bi bi-translate text-muted"></i></span>
            <select class="form-select border-start-0 rounded-end-3 fw-bold" @bind="_selectedLanguage">
                @foreach (var language in _languages)
                {
                    <option value="@language">@(language == "vi" ? "Tiếng Việt 🇻🇳" : language == "en" ? "English 🇺🇸" : language == "zh" ? "Chinese 🇨🇳" : language == "ko" ? "Korean 🇰🇷" : "Japanese 🇯🇵")</option>
                }
            </select>
        </div>
        <button class="btn btn-modern btn-primary-f&b shadow-sm" @onclick="TranslateAllAsync" disabled="@_isTranslatingAll">
            @if (_isTranslatingAll)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                <span>Đang xử lý...</span>
            }
            else
            {
                <span><i class="bi bi-stars me-1"></i> Dịch tất cả POI</span>
            }
        </button>
    </div>
</div>

<section class="food-card p-4 border-0 shadow-sm">
    <LoadingState IsLoading="_isLoading" Message="Đang tải bản dịch..." />

    @if (!_isLoading && _pois.Count == 0)
    {
        <div class="empty-state py-5">
            <i class="bi bi-translate text-muted" style="font-size: 3rem;"></i>
            <h5 class="fw-bold mt-3">Chưa có dữ liệu địa điểm</h5>
            <p class="text-muted">Bạn cần tạo các địa điểm trước khi bắt đầu quản lý bản dịch.</p>
        </div>
    }
    else if (!_isLoading)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="bg-light">
                    <tr>
                        <th class="border-0" style="width: 20%;">Địa điểm</th>
                        <th class="border-0" style="width: 35%;">Văn bản gốc (VN)</th>
                        <th class="border-0" style="width: 35%;">Bản dịch (@_selectedLanguage.ToUpper())</th>
                        <th class="border-0 text-center" style="width: 10%;">Tác vụ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var poi in _pois.OrderBy(x => x.Name))
                    {
                        <!-- Name Translation Row -->
                        <tr class="border-bottom-0">
                            <td>
                                <div class="fw-bold">@poi.Name</div>
                                <span class="badge badge-pill badge-gray mt-1">Tên quán</span>
                            </td>
                            <td class="text-dark">@poi.Name</td>
                            <td>
                                <input type="text" class="form-control form-control-sm rounded-3 border-orange border-opacity-25" 
                                       placeholder="Chưa có bản dịch..."
                                       value="@GetNameTranslation(poi, _selectedLanguage)" 
                                       @onchange="@(e => SetNameTranslation(poi, _selectedLanguage, e.Value?.ToString()))" />
                            </td>
                            <td class="text-center" rowspan="2">
                                <button class="btn btn-modern btn-primary-f&b btn-sm rounded-3 w-100 mb-2" @onclick="() => SavePoiAsync(poi)">Lưu</button>
                                <button class="btn btn-modern btn-light btn-sm rounded-3 w-100" title="Chi tiết" @onclick="() => SavePoiAsync(poi)"><i class="bi bi-three-dots"></i></button>
                            </td>
                        </tr>
                        <!-- Description Translation Row -->
                        <tr class="table-active-light">
                            <td class="border-top-0 pt-0">
                                <span class="badge badge-pill badge-orange mt-1">Mô tả</span>
                            </td>
                            <td class="text-muted small border-top-0 pt-0" style="max-width: 300px; white-space: normal;">@poi.Description</td>
                            <td class="border-top-0 pt-0">
                                <textarea class="form-control form-control-sm rounded-3 border-orange border-opacity-10" rows="1"
                                       placeholder="Mô tả cho du khách..."
                                       value="@GetDescriptionTranslation(poi, _selectedLanguage)" 
                                       @onchange="@(e => SetDescriptionTranslation(poi, _selectedLanguage, e.Value?.ToString()))"></textarea>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private readonly List<POI> _pois = [];
    private readonly string[] _languages = ["vi", "en", "zh", "ko", "ja"];
    private string _selectedLanguage = "en";
    private bool _isLoading;
    private bool _isTranslatingAll;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            _pois.Clear();
            var data = DataService.GetPois();
            if (data != null)
            {
                _pois.AddRange(data);
            }
        }
        catch (Exception ex)
        {
            Toasts.Error("Không thể tải danh sách bản dịch.");
        }
        finally
        {
            _isLoading = false;
        }

        return Task.CompletedTask;
    }

    private async Task SavePoiAsync(POI poi)
    {
        try
        {
            DataService.UpdatePoi(poi);
            Toasts.Success("Đã lưu bản dịch thành công.");
        }
        catch
        {
            Toasts.Error("Không thể lưu bản dịch.");
        }
    }

    private async Task TranslateAllAsync()
    {
        try
        {
            _isTranslatingAll = true;
            var translatedCount = await DataService.TranslateAllPoisAsync();
            if (translatedCount > 0)
            {
                Toasts.Success($"✔ Đã dịch thành công {translatedCount} POI.");
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            Toasts.Error($"❌ Tự động dịch thất bại: {ex.Message}");
        }
        finally
        {
            _isTranslatingAll = false;
        }
    }

    private static string? GetNameTranslation(POI poi, string language) => language switch
    {
        "vi" => poi.NameVi,
        "en" => poi.NameEn,
        "zh" => poi.NameZh,
        "ko" => poi.NameKo,
        "ja" => poi.NameJa,
        _ => poi.NameEn
    };

    private static string? GetDescriptionTranslation(POI poi, string language) => language switch
    {
        "vi" => poi.DescriptionVi,
        "en" => poi.DescriptionEn,
        "zh" => poi.DescriptionZh,
        "ko" => poi.DescriptionKo,
        "ja" => poi.DescriptionJa,
        _ => poi.DescriptionEn
    };

    private static void SetNameTranslation(POI poi, string language, string? value)
    {
        switch (language)
        {
            case "vi": poi.NameVi = value; break;
            case "en": poi.NameEn = value; break;
            case "zh": poi.NameZh = value; break;
            case "ko": poi.NameKo = value; break;
            case "ja": poi.NameJa = value; break;
        }
    }

    private static void SetDescriptionTranslation(POI poi, string language, string? value)
    {
        switch (language)
        {
            case "vi": poi.DescriptionVi = value; break;
            case "en": poi.DescriptionEn = value; break;
            case "zh": poi.DescriptionZh = value; break;
            case "ko": poi.DescriptionKo = value; break;
            case "ja": poi.DescriptionJa = value; break;
        }
    }
}
