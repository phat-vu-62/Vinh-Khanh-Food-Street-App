@page "/tours"
@inject IAdminDataService DataService
@inject ToastService Toasts

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="h3 fw-bold mb-1">Thiết kế lộ trình</h1>
        <p class="text-muted mb-0">Xây dựng các tour tham quan theo chủ đề bằng cách kết nối nhiều địa điểm.</p>
    </div>
    <button class="btn btn-saas btn-saas-primary shadow-sm" @onclick="StartCreate">
        <i class="bi bi-map-fill"></i> Tạo lộ trình mới
    </button>
</div>

<LoadingState IsLoading="_isLoading" Message="Đang xử lý lộ trình..." />

@if (!_isLoading)
{
    @if (_tours.Count == 0)
    {
        <div class="saas-card p-5 text-center">
            <i class="bi bi-signpost-2 text-light" style="font-size: 3rem;"></i>
            <h5 class="fw-bold mt-4">Chưa có tour tham quan nào</h5>
            <p class="text-muted small">Ghép các quán ăn thành một lộ trình hấp dẫn cho thực khách.</p>
            <button class="btn btn-saas btn-saas-primary mt-3" @onclick="StartCreate">Tạo lộ trình đầu tiên</button>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var tour in _tours.OrderByDescending(x => x.Id))
            {
                <div class="col-md-6 col-xl-4">
                    <div class="saas-card h-100 d-flex flex-column">
                        <div class="p-4 flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <span class="saas-badge badge-highlight">TOUR #@tour.Id</span>
                                <div class="dropdown">
                                    <button class="btn btn-link link-muted p-0" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></button>
                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg">
                                        <li><button class="dropdown-item" @onclick="() => StartEdit(tour)"><i class="bi bi-pencil me-2"></i> Chỉnh sửa</button></li>
                                        <li><button class="dropdown-item text-danger" @onclick="() => DeleteAsync(tour.Id)"><i class="bi bi-trash me-2"></i> Xóa bỏ</button></li>
                                    </ul>
                                </div>
                            </div>
                            
                            <h5 class="fw-bold text-dark mb-2">@tour.Name</h5>
                            <p class="text-muted small mb-4" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 3em;">
                                @tour.Description
                            </p>

                            <div class="map-placeholder mb-4" style="height: 100px;">
                                <svg width="100%" height="60" viewBox="0 0 200 60">
                                    <path d="M20,30 Q60,10 100,30 T180,30" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-dasharray="4 4" />
                                    <circle cx="20" cy="30" r="4" fill="var(--primary-color)" />
                                    <circle cx="100" cy="30" r="4" fill="var(--primary-color)" />
                                    <circle cx="180" cy="30" r="4" fill="var(--primary-color)" />
                                </svg>
                            </div>

                            <div class="d-flex gap-4">
                                <div>
                                    <span class="d-block small text-muted mb-1">Số địa điểm</span>
                                    <span class="fw-bold text-dark">@tour.PoiIds.Count điểm</span>
                                </div>
                                <div>
                                    <span class="d-block small text-muted mb-1">Thời gian</span>
                                    <span class="fw-bold text-dark">~@(tour.PoiIds.Count * 20) phút</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="p-3 bg-light border-top mt-auto d-flex justify-content-between align-items-center">
                            <div class="d-flex" style="margin-left: 8px;">
                                @foreach(var poiId in tour.PoiIds.Take(3))
                                {
                                    <div class="bg-white rounded-circle border d-flex align-items-center justify-content-center shadow-sm" 
                                         style="width: 28px; height: 28px; margin-left: -8px;" title="@FindPoiName(poiId)">
                                        <i class="bi bi-geo-alt-fill text-primary" style="font-size: 0.7rem; color: var(--primary-color);"></i>
                                    </div>
                                }
                            </div>
                            <span class="saas-badge badge-active">Active</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@if (_editorOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8px);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content overflow-hidden">
                <EditForm Model="_form" OnValidSubmit="SaveAsync">
                    <div class="modal-header border-0 bg-light py-3 px-4">
                        <h5 class="modal-title fw-bold">@(_isEditing ? "🖊️ Cập nhật lộ trình" : "✨ Tạo lộ trình mới")</h5>
                        <button type="button" class="btn-close" @onclick="CloseEditor"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Tên lộ trình</label>
                                <InputText class="form-control" @bind-Value="_form.Name" placeholder="Ví dụ: Tour Hải Sản Vinh Khánh" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Mô tả ngắn</label>
                                <InputText class="form-control" @bind-Value="_form.Description" placeholder="Hành trình khám phá các món ốc..." />
                            </div>
                            
                            <div class="col-12">
                                <hr class="my-2" />
                            </div>

                            <div class="col-md-5">
                                <label class="form-label fw-bold">Chọn địa điểm để thêm</label>
                                <select class="form-select" @bind="_selectedPoiId">
                                    <option value="0">-- Chọn địa điểm --</option>
                                    @foreach (var poi in _pois.OrderBy(x => x.Name))
                                    {
                                        <option value="@poi.Id">@poi.Name</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-saas btn-saas-secondary w-100 mt-3" @onclick="AddPoiToTour">
                                    <i class="bi bi-plus-circle me-1"></i> Thêm vào chuỗi
                                </button>
                            </div>
                            
                            <div class="col-md-7">
                                <label class="form-label fw-bold">Thứ tự di chuyển (Kéo thả để sắp xếp)</label>
                                <div class="bg-light rounded-4 p-2 border" style="min-height: 150px;">
                                    <ul class="list-group list-group-flush" ondragover="event.preventDefault();">
                                        @if (_form.PoiIds.Count == 0)
                                        {
                                            <li class="list-group-item bg-transparent text-center py-4 text-muted border-0">
                                                <i class="bi bi-info-circle d-block mb-1"></i>
                                                Chưa có địa điểm nào trong lộ trình này
                                            </li>
                                        }
                                        @for (var i = 0; i < _form.PoiIds.Count; i++)
                                        {
                                            var currentIndex = i;
                                            var poiId = _form.PoiIds[currentIndex];
                                            <li class="list-group-item d-flex justify-content-between align-items-center bg-white rounded-3 shadow-sm mb-2 border-0"
                                                draggable="true" 
                                                @ondragstart="@(() => DragStart(currentIndex))"
                                                @ondrop="@(() => Drop(currentIndex))"
                                                style="cursor: grab;">
                                                <div class="d-flex align-items-center">
                                                    <span class="badge bg-primary text-white rounded-circle me-3" style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">@(i + 1)</span>
                                                    <span class="fw-semibold">@FindPoiName(poiId)</span>
                                                </div>
                                                <button type="button" class="btn btn-link text-danger p-1" @onclick="() => RemovePoi(currentIndex)">
                                                    <i class="bi bi-x-circle-fill"></i>
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 p-4 pt-0">
                        <button type="button" class="btn btn-saas btn-saas-secondary" @onclick="CloseEditor">Đóng</button>
                        <button type="submit" class="btn btn-saas btn-saas-primary px-4">Lưu lộ trình</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<Tour> _tours = [];
    private readonly List<POI> _pois = [];
    private bool _isLoading;
    private bool _editorOpen;
    private bool _isEditing;
    private int _selectedPoiId;
    private TourFormViewModel _form = new();
    
    private int? _draggedIndex;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            _tours.Clear();
            _pois.Clear();
            _tours.AddRange(DataService.GetTours());
            _pois.AddRange(DataService.GetPois());
            _selectedPoiId = _pois.FirstOrDefault()?.Id ?? 0;
        }
        catch
        {
            Toasts.Error("Cannot load tours.");
        }
        finally
        {
            _isLoading = false;
        }

        return Task.CompletedTask;
    }

    private void StartCreate()
    {
        _isEditing = false;
        _form = new TourFormViewModel { IsActive = true };
        _editorOpen = true;
    }

    private void StartEdit(Tour tour)
    {
        _isEditing = true;
        _form = new TourFormViewModel
        {
            Id = tour.Id,
            Name = tour.Name,
            Description = tour.Description,
            IsActive = tour.IsActive,
            PoiIds = tour.PoiIds.ToList()
        };
        _editorOpen = true;
    }

    private void AddPoiToTour()
    {
        if (_selectedPoiId == 0 || _form.PoiIds.Contains(_selectedPoiId))
        {
            return;
        }

        _form.PoiIds.Add(_selectedPoiId);
    }

    private void RemovePoi(int index)
    {
        if (index >= 0 && index < _form.PoiIds.Count)
        {
            _form.PoiIds.RemoveAt(index);
        }
    }

    private void DragStart(int index)
    {
        _draggedIndex = index;
    }

    private void Drop(int dropIndex)
    {
        if (_draggedIndex.HasValue && _draggedIndex.Value != dropIndex)
        {
            var item = _form.PoiIds[_draggedIndex.Value];
            _form.PoiIds.RemoveAt(_draggedIndex.Value);
            _form.PoiIds.Insert(dropIndex, item);
        }
        _draggedIndex = null;
    }

    private void MovePoi(int index, int delta)
    {
        var newIndex = index + delta;
        if (index < 0 || newIndex < 0 || index >= _form.PoiIds.Count || newIndex >= _form.PoiIds.Count)
        {
            return;
        }

        (_form.PoiIds[index], _form.PoiIds[newIndex]) = (_form.PoiIds[newIndex], _form.PoiIds[index]);
    }

    private Task SaveAsync()
    {
        try
        {
            var payload = new Tour
            {
                Id = _form.Id,
                Name = _form.Name,
                Description = _form.Description,
                IsActive = _form.IsActive,
                PoiIds = _form.PoiIds.ToList()
            };

            if (_isEditing)
            {
                DataService.UpdateTour(payload);
                Toasts.Success("Tour updated.");
            }
            else
            {
                DataService.AddTour(payload);
                Toasts.Success("Tour created.");
            }

            _editorOpen = false;
            LoadAsync();
        }
        catch
        {
            Toasts.Error("Save tour failed.");
        }

        return Task.CompletedTask;
    }

    private Task DeleteAsync(int id)
    {
        try
        {
            DataService.DeleteTour(id);
            Toasts.Success("Tour deleted.");
            LoadAsync();
        }
        catch
        {
            Toasts.Error("Delete tour failed.");
        }

        return Task.CompletedTask;
    }

    private string FindPoiName(int poiId) => _pois.FirstOrDefault(x => x.Id == poiId)?.Name ?? $"POI #{poiId}";

    private void CloseEditor() => _editorOpen = false;

}
