@page "/tours"
@inject IAdminDataService DataService
@inject ToastService Toasts

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Tours Management</h1>
        <small class="text-muted">Xây dựng Tours, thêm POI và sắp xếp trình tự</small>
    </div>
    <button class="btn btn-primary" @onclick="StartCreate">+ Thêm mới</button>
</div>

<section class="module-panel">
    <LoadingState IsLoading="_isLoading" Message="Đang tải danh sách hành trình..." />

    @if (!_isLoading && _tours.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-map empty-icon"></i>
            <div class="empty-title">Chưa có Tours nào</div>
            <div class="empty-description">Tạo Tours bằng cách kết hợp nhiều POI thành một tuyến đường đi bộ.</div>
            <button class="btn btn-primary mt-2" @onclick="StartCreate"><i class="bi bi-plus-lg"></i> Thêm mới</button>
        </div>
    }
    else if (!_isLoading)
    {
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th>Tour Name</th>
                        <th>Description</th>
                        <th>POI Sequence</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tour in _tours.OrderByDescending(x => x.Id))
                    {
                        <tr>
                            <td class="fw-semibold">@tour.Name</td>
                            <td class="text-muted" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@tour.Description</td>
                            <td>
                                @foreach (var poiId in tour.PoiIds)
                                {
                                    <span class="badge text-bg-secondary me-1">@FindPoiName(poiId)</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => StartEdit(tour)" title="Chỉnh sửa">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(tour.Id)" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (_editorOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5)">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content form-card">
                <EditForm Model="_form" OnValidSubmit="SaveAsync">
                    <div class="modal-header">
                        <h5 class="modal-title">@(_isEditing ? "Chỉnh sửa Tour" : "Thêm mới Tour")</h5>
                        <button type="button" class="btn-close" @onclick="CloseEditor"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Tour Name</label>
                                <InputText class="form-control" @bind-Value="_form.Name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Description</label>
                                <InputText class="form-control" @bind-Value="_form.Description" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Các POI có sẵn</label>
                                <select class="form-select" @bind="_selectedPoiId">
                                    @foreach (var poi in _pois.OrderBy(x => x.Name))
                                    {
                                        <option value="@poi.Id">@poi.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="button" class="btn btn-outline-primary w-100" @onclick="AddPoiToTour">Thêm</button>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">POI Sequence (Kéo để sắp xếp)</label>
                                <ul class="list-group list-group-flush border rounded" ondragover="event.preventDefault();">
                                    @if (_form.PoiIds.Count == 0)
                                    {
                                        <li class="list-group-item text-muted">Chưa chọn POI nào</li>
                                    }
                                    @for (var i = 0; i < _form.PoiIds.Count; i++)
                                    {
                                        var currentIndex = i;
                                        var poiId = _form.PoiIds[currentIndex];
                                        <li class="list-group-item d-flex justify-content-between align-items-center"
                                            draggable="true" 
                                            @ondragstart="@(() => DragStart(currentIndex))"
                                            @ondrop="@(() => Drop(currentIndex))"
                                            style="cursor: grab;">
                                            <span><i class="bi bi-grip-vertical text-muted me-2"></i> @FindPoiName(poiId)</span>
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => RemovePoi(currentIndex)">×</button>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseEditor">Hủy bỏ</button>
                        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<Tour> _tours = [];
    private readonly List<POI> _pois = [];
    private bool _isLoading;
    private bool _editorOpen;
    private bool _isEditing;
    private int _selectedPoiId;
    private TourFormViewModel _form = new();
    
    private int? _draggedIndex;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private Task LoadAsync()
    {
        try
        {
            _isLoading = true;
            _tours.Clear();
            _pois.Clear();
            _tours.AddRange(DataService.GetTours());
            _pois.AddRange(DataService.GetPois());
            _selectedPoiId = _pois.FirstOrDefault()?.Id ?? 0;
        }
        catch
        {
            Toasts.Error("Cannot load tours.");
        }
        finally
        {
            _isLoading = false;
        }

        return Task.CompletedTask;
    }

    private void StartCreate()
    {
        _isEditing = false;
        _form = new TourFormViewModel { IsActive = true };
        _editorOpen = true;
    }

    private void StartEdit(Tour tour)
    {
        _isEditing = true;
        _form = new TourFormViewModel
        {
            Id = tour.Id,
            Name = tour.Name,
            Description = tour.Description,
            IsActive = tour.IsActive,
            PoiIds = tour.PoiIds.ToList()
        };
        _editorOpen = true;
    }

    private void AddPoiToTour()
    {
        if (_selectedPoiId == 0 || _form.PoiIds.Contains(_selectedPoiId))
        {
            return;
        }

        _form.PoiIds.Add(_selectedPoiId);
    }

    private void RemovePoi(int index)
    {
        if (index >= 0 && index < _form.PoiIds.Count)
        {
            _form.PoiIds.RemoveAt(index);
        }
    }

    private void DragStart(int index)
    {
        _draggedIndex = index;
    }

    private void Drop(int dropIndex)
    {
        if (_draggedIndex.HasValue && _draggedIndex.Value != dropIndex)
        {
            var item = _form.PoiIds[_draggedIndex.Value];
            _form.PoiIds.RemoveAt(_draggedIndex.Value);
            _form.PoiIds.Insert(dropIndex, item);
        }
        _draggedIndex = null;
    }

    private void MovePoi(int index, int delta)
    {
        var newIndex = index + delta;
        if (index < 0 || newIndex < 0 || index >= _form.PoiIds.Count || newIndex >= _form.PoiIds.Count)
        {
            return;
        }

        (_form.PoiIds[index], _form.PoiIds[newIndex]) = (_form.PoiIds[newIndex], _form.PoiIds[index]);
    }

    private Task SaveAsync()
    {
        try
        {
            var payload = new Tour
            {
                Id = _form.Id,
                Name = _form.Name,
                Description = _form.Description,
                IsActive = _form.IsActive,
                PoiIds = _form.PoiIds.ToList()
            };

            if (_isEditing)
            {
                DataService.UpdateTour(payload);
                Toasts.Success("Tour updated.");
            }
            else
            {
                DataService.AddTour(payload);
                Toasts.Success("Tour created.");
            }

            _editorOpen = false;
            LoadAsync();
        }
        catch
        {
            Toasts.Error("Save tour failed.");
        }

        return Task.CompletedTask;
    }

    private Task DeleteAsync(int id)
    {
        try
        {
            DataService.DeleteTour(id);
            Toasts.Success("Tour deleted.");
            LoadAsync();
        }
        catch
        {
            Toasts.Error("Delete tour failed.");
        }

        return Task.CompletedTask;
    }

    private string FindPoiName(int poiId) => _pois.FirstOrDefault(x => x.Id == poiId)?.Name ?? $"POI #{poiId}";

    private void CloseEditor() => _editorOpen = false;

}
