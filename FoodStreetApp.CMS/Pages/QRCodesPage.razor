@page "/qrcodes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin, Owner")]
@namespace FoodStreetApp.CMS.Pages
@using FoodStreetApp.CMS.Interfaces
@using FoodStreetApp.Shared.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@inject IQRCodeService QRCodeService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IAdminDataService DataService
@inject AuthenticationStateProvider AuthProvider

<div class="page-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark">Mã QR Phố Ẩm Thực</h1>
            <p class="text-muted">Quét mã QR này để truy cập danh sách quán và nghe thuyết minh.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="unified-qr-card">
                <div class="qr-card-header">
                    <i class="bi bi-qr-code-scan"></i>
                    <span>Mã QR Chung</span>
                </div>
                <div class="qr-card-body">
                    <div class="qr-image-wrapper">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=280x280&data=@(Uri.EscapeDataString(_listenUrl))"
                             alt="QR Code" class="qr-image" />
                    </div>
                    <h5 class="fw-bold mt-3 mb-1">Phố Ẩm Thực Vĩnh Khánh</h5>
                    <p class="text-muted small mb-0">Quét để xem tất cả quán ăn</p>
                    <div class="qr-url-box mt-3">
                        <code>@_listenUrl</code>
                    </div>
                </div>
                <div class="qr-card-actions">
                    <button class="btn-qr-action btn-download" @onclick="DownloadUnifiedQR">
                        <i class="bi bi-download me-1"></i> Tải ảnh QR
                    </button>
                    <button class="btn-qr-action btn-print" @onclick="PrintQR">
                        <i class="bi bi-printer me-1"></i> In
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .unified-qr-card {
        background: white;
        border-radius: 24px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.08);
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.04);
    }

    .qr-card-header {
        background: linear-gradient(135deg, #3b82f6, #06b6d4);
        color: white;
        padding: 16px 24px;
        font-weight: 700;
        font-size: 1rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .qr-card-header i {
        font-size: 1.3rem;
    }

    .qr-card-body {
        padding: 32px;
        text-align: center;
    }

    .qr-image-wrapper {
        background: #f8fafc;
        padding: 20px;
        border-radius: 16px;
        display: inline-block;
        border: 2px dashed #e2e8f0;
    }

    .qr-image {
        width: 100%;
        max-width: 240px;
        height: auto;
        display: block;
    }

    .qr-url-box {
        font-size: 0.75rem;
        color: #636e72;
        word-break: break-all;
        background: #f1f5f9;
        padding: 10px 14px;
        border-radius: 10px;
    }

    .qr-card-actions {
        padding: 16px 24px;
        background: #f8fafc;
        border-top: 1px solid rgba(0,0,0,0.05);
        display: flex;
        gap: 12px;
    }

    .btn-qr-action {
        flex: 1;
        padding: 10px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.875rem;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-download {
        background: #3b82f6;
        color: white;
    }

    .btn-download:hover {
        background: #2563eb;
        transform: translateY(-1px);
    }

    .btn-print {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    .btn-print:hover {
        background: #e2e8f0;
    }

    @@media print {
        .sidebar, .top-header, .qr-card-actions, .btn {
            display: none !important;
        }
        .main-container {
            margin: 0 !important;
            padding: 0 !important;
        }
        .unified-qr-card {
            box-shadow: none !important;
            border: 1px solid #eee !important;
        }
    }
</style>

@code {
    private string _listenUrl = "";

    protected override void OnInitialized()
    {
        _listenUrl = $"{NavigationManager.BaseUri.TrimEnd('/')}/listen";
    }

    private async Task DownloadUnifiedQR()
    {
        // Fetch the QR image as base64 and download
        var qrApiUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=400x400&data={Uri.EscapeDataString(_listenUrl)}";
        await JSRuntime.InvokeVoidAsync("eval", $@"
            fetch('{qrApiUrl}')
                .then(r => r.blob())
                .then(b => {{
                    const url = URL.createObjectURL(b);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = 'QR_PhoAmThuc_VinhKhanh.png';
                    a.click();
                    URL.revokeObjectURL(url);
                }});
        ");
    }

    private async Task PrintQR()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }
}
