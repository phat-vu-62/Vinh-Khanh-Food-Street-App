@page "/qrcodes"
@using FoodStreetApp.CMS.Interfaces
@using FoodStreetApp.Shared.DTOs
@inject IQRCodeService QRCodeService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="page-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark">Quản lý mã QR</h1>
            <p class="text-muted">Tạo và quản lý mã QR dẫn đến trang nghe thuyết minh tự động.</p>
        </div>
        <button class="btn btn-primary d-flex align-items-center gap-2" @onclick="PrintAll">
            <i class="bi bi-printer"></i> In tất cả
        </button>
    </div>

    @if (qrCodes == null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!qrCodes.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-qr-code text-muted display-1"></i>
            <p class="mt-3">Chưa có dữ liệu quán ăn nào để tạo mã QR.</p>
        </div>
    }
    else
    {
        <div class="qr-grid">
            @foreach (var item in qrCodes)
            {
                <div class="qr-card">
                    <div class="qr-content">
                        <div class="qr-header">
                            <span class="restaurant-name">@item.Name</span>
                            <span class="badge bg-light text-primary border">ID: @item.Id</span>
                        </div>
                        
                        <div class="qr-image-wrapper">
                            <img src="data:image/png;base64,@item.QRCodeBase64" alt="QR Code" class="qr-image" />
                        </div>

                        <div class="qr-url">
                            <code>@item.DynamicUrl</code>
                        </div>
                    </div>
                    <div class="qr-actions">
                        <button class="btn btn-light btn-sm flex-fill" @onclick="() => DownloadQR(item)">
                            <i class="bi bi-download"></i> Tải ảnh
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .qr-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 24px;
    }

    .qr-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05);
        display: flex;
        flex-direction: column;
    }

    .qr-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .qr-content {
        padding: 24px;
        text-align: center;
        flex: 1;
    }

    .qr-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .restaurant-name {
        font-weight: 700;
        font-size: 1.1rem;
        color: #2d3436;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .qr-image-wrapper {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 12px;
        margin-bottom: 15px;
        display: inline-block;
    }

    .qr-image {
        width: 100%;
        max-width: 180px;
        height: auto;
        display: block;
    }

    .qr-url {
        font-size: 0.75rem;
        color: #636e72;
        word-break: break-all;
        background: #f1f2f6;
        padding: 8px;
        border-radius: 8px;
        margin-top: 10px;
    }

    .qr-actions {
        padding: 12px 20px;
        background: #f8f9fa;
        border-top: 1px solid rgba(0,0,0,0.05);
        display: flex;
        gap: 10px;
    }

    @@media print {
        .sidebar, .top-header, .qr-actions, .btn {
            display: none !important;
        }
        .main-container {
            margin: 0 !important;
            padding: 0 !important;
        }
        .qr-grid {
            display: block !important;
        }
        .qr-card {
            break-inside: avoid;
            margin-bottom: 50px;
            box-shadow: none !important;
            border: 1px solid #eee !important;
        }
    }
</style>

@code {
    private IEnumerable<RestaurantQRCodeDto>? qrCodes;

    protected override async Task OnInitializedAsync()
    {
        // Get the current base URL
        string baseUri = NavigationManager.BaseUri;
        qrCodes = await QRCodeService.GetRestaurantQRCodesAsync(baseUri);
    }

    private async Task DownloadQR(RestaurantQRCodeDto item)
    {
        var fileName = $"QR_{item.Name}_{item.Id}.png";
        await JSRuntime.InvokeVoidAsync("downloadBase64File", item.QRCodeBase64, "image/png", fileName);
    }

    private async Task PrintAll()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }
}
