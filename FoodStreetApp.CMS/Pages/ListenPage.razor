@page "/listen/{PoiId:int}"
@layout EmptyLayout
@using FoodStreetApp.CMS.Interfaces
@using FoodStreetApp.Shared.Entities
@inject IAdminDataService DataService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="listen-container">
    @if (_poi == null)
    {
        <div class="status-box">
            <i class="bi bi-search display-4 text-muted"></i>
            <h2 class="mt-3">Đang tìm dữ liệu...</h2>
        </div>
    }
    else
    {
        <div class="audio-card shadow-lg">
            <div class="gradient-bar"></div>
            
            <!-- Language Selector -->
            <div class="lang-selector">
                <button class="lang-btn @(_currentLang == "vi" ? "active" : "")" @onclick='() => ChangeLang("vi")'>VN</button>
                <button class="lang-btn @(_currentLang == "en" ? "active" : "")" @onclick='() => ChangeLang("en")'>EN</button>
                <button class="lang-btn @(_currentLang == "zh" ? "active" : "")" @onclick='() => ChangeLang("zh")'>ZH</button>
                <button class="lang-btn @(_currentLang == "ko" ? "active" : "")" @onclick='() => ChangeLang("ko")'>KO</button>
                <button class="lang-btn @(_currentLang == "ja" ? "active" : "")" @onclick='() => ChangeLang("ja")'>JA</button>
            </div>

            <div class="card-content">
                <div class="icon-circle">
                    @if (_isBuffering)
                    {
                        <div class="spinner-border text-primary" role="status" style="width: 2rem; height: 2rem;"></div>
                    }
                    else
                    {
                        <i class="bi bi-shop"></i>
                    }
                </div>
                
                <h1 class="restaurant-title">@_currentName</h1>
                <p class="subtitle @(_hasError ? "text-danger fw-bold" : "")">@_statusMessage</p>

                <div class="player-controls">
                    <button class="play-btn @(_isPlaying ? "playing" : "")" @onclick="TogglePlay" disabled="@_isBuffering">
                        @if (_isPlaying)
                        {
                            <i class="bi bi-pause-fill"></i>
                        }
                        else
                        {
                            <i class="bi bi-play-fill ms-1"></i>
                        }
                    </button>
                </div>

                @if (_isPlaying && !_isBuffering)
                {
                    <div class="audio-wave">
                        <span></span><span></span><span></span><span></span><span></span>
                    </div>
                }

                <audio @ref="_audioElement" src="@_audioUrl" preload="auto" crossorigin="anonymous"></audio>
            </div>

            @if (!string.IsNullOrEmpty(_debugInfo))
            {
                <div class="debug-panel p-2 small text-muted text-center border-top">
                    <code>@_debugInfo</code>
                </div>
            }
        </div>
    }
</div>

<style>
    .listen-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 20px;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        font-family: 'Inter', sans-serif;
    }

    .audio-card {
        width: 100%;
        max-width: 400px;
        background: white;
        border-radius: 30px;
        overflow: hidden;
        position: relative;
    }

    .gradient-bar { height: 8px; background: linear-gradient(90deg, #0984e3, #00cec9); }

    .lang-selector { display: flex; justify-content: center; gap: 8px; padding: 20px 10px 0; }

    .lang-btn {
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 5px 12px;
        font-size: 0.75rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        color: #64748b;
    }

    .lang-btn.active { background: #0984e3; color: white; border-color: #0984e3; }

    .card-content { padding: 30px 30px 40px; text-align: center; }

    .icon-circle {
        width: 70px; height: 70px; background: #f0f7ff; border-radius: 50%;
        display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;
        color: #0984e3; font-size: 2.2rem;
    }

    .restaurant-title { font-weight: 800; font-size: 1.6rem; margin-bottom: 8px; color: #1e293b; }

    .subtitle { color: #64748b; font-size: 0.9rem; margin-bottom: 25px; min-height: 3rem; display: flex; align-items: center; justify-content: center; line-height: 1.4; }

    .play-btn {
        width: 85px; height: 85px; background: #0984e3; border: none; border-radius: 50%;
        color: white; font-size: 2.8rem; cursor: pointer; display: flex; align-items: center; justify-content: center;
        box-shadow: 0 10px 20px rgba(9, 132, 227, 0.3); transition: all 0.3s; margin: 0 auto;
    }

    .play-btn:active { transform: scale(0.95); }
    .play-btn:disabled { background: #cbd5e1; box-shadow: none; cursor: not-allowed; }
    .play-btn:not(.playing):not(:disabled) { animation: pulse 2s infinite; }
    .play-btn.playing { background: #1e293b; }

    @@keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(9, 132, 227, 0.4); }
        70% { box-shadow: 0 0 0 15px rgba(9, 132, 227, 0); }
        100% { box-shadow: 0 0 0 0 rgba(9, 132, 227, 0); }
    }

    .audio-wave { display: flex; justify-content: center; align-items: center; gap: 4px; height: 25px; margin-top: 25px; }
    .audio-wave span { width: 3px; background: #0984e3; border-radius: 2px; animation: wave 1s infinite alternate; }
    .audio-wave span:nth-child(1) { height: 8px; animation-delay: 0.1s; }
    .audio-wave span:nth-child(2) { height: 18px; animation-delay: 0.2s; }
    .audio-wave span:nth-child(3) { height: 22px; animation-delay: 0.3s; }
    .audio-wave span:nth-child(4) { height: 12px; animation-delay: 0.4s; }
    .audio-wave span:nth-child(5) { height: 8px; animation-delay: 0.5s; }

    @@keyframes wave { from { transform: scaleY(1); } to { transform: scaleY(2.2); } }
    .debug-panel { background: #f8fafc; font-family: monospace; }
</style>

@code {
    [Parameter] public int PoiId { get; set; }
    private POI? _poi;
    private ElementReference _audioElement;
    private DotNetObjectReference<ListenPage>? _objRef;

    private bool _isPlaying;
    private bool _isBuffering;
    private bool _hasError;
    private string _currentLang = "vi";
    private string _currentName = "";
    private string _statusMessage = "";
    private string _audioUrl = "";
    private string _debugInfo = "";

    protected override void OnInitialized()
    {
        _poi = DataService.GetPoiById(PoiId);
        if (_poi != null)
        {
            _audioUrl = FixAudioUrl(_poi.AudioUrl);
        }
        UpdateDisplay();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _poi != null)
        {
            _objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("audioHelper.attachEvents", _audioElement, _objRef);
        }
    }

    private string FixAudioUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return "";
        if (url.StartsWith("http")) return url;
        
        // Handle relative URLs
        var baseUri = NavigationManager.BaseUri.TrimEnd('/');
        return $"{baseUri}/{url.TrimStart('/')}";
    }

    private void ChangeLang(string lang)
    {
        _ = StopAllPlayback();
        _currentLang = lang;
        UpdateDisplay();
    }

    private void UpdateDisplay()
    {
        if (_poi == null) return;
        _hasError = false;

        _currentName = _currentLang switch
        {
            "en" => _poi.NameEn ?? _poi.Name,
            "zh" => _poi.NameZh ?? _poi.Name,
            "ko" => _poi.NameKo ?? _poi.Name,
            "ja" => _poi.NameJa ?? _poi.Name,
            _ => _poi.Name
        };

        var desc = _currentLang switch
        {
            "en" => _poi.DescriptionEn ?? _poi.Description,
            "zh" => _poi.DescriptionZh ?? _poi.Description,
            "ko" => _poi.DescriptionKo ?? _poi.Description,
            "ja" => _poi.DescriptionJa ?? _poi.Description,
            _ => _poi.Description
        };

        _statusMessage = desc ?? "Chạm để bắt đầu hành trình ẩm thực";
    }

    private async Task TogglePlay()
    {
        if (!_isPlaying)
        {
            _hasError = false;
            if (_currentLang == "vi" && !string.IsNullOrEmpty(_audioUrl))
            {
                _debugInfo = "Playing file: " + _audioUrl;
                await JSRuntime.InvokeVoidAsync("audioHelper.play", _audioElement);
            }
            else
            {
                _debugInfo = "Playing TTS for " + _currentLang;
                string textToSpeak = _currentLang switch
                {
                    "en" => _poi?.TextContentEn ?? _poi?.DescriptionEn ?? _poi?.NameEn,
                    "zh" => _poi?.TextContentZh ?? _poi?.DescriptionZh ?? _poi?.NameZh,
                    "ko" => _poi?.TextContentKo ?? _poi?.DescriptionKo ?? _poi?.NameKo,
                    "ja" => _poi?.TextContentJa ?? _poi?.DescriptionJa ?? _poi?.NameJa,
                    _ => _poi?.TextContent ?? _poi?.Description ?? _poi?.Name
                } ?? "";

                string ttsLang = _currentLang switch
                {
                    "en" => "en-US",
                    "zh" => "zh-CN",
                    "ko" => "ko-KR",
                    "ja" => "ja-JP",
                    _ => "vi-VN"
                };

                await JSRuntime.InvokeVoidAsync("audioHelper.speak", textToSpeak, ttsLang);
                _isPlaying = true; // For TTS we manually set playing state
            }
        }
        else
        {
            await StopAllPlayback();
        }
    }

    private async Task StopAllPlayback()
    {
        await JSRuntime.InvokeVoidAsync("audioHelper.pause", _audioElement);
        await JSRuntime.InvokeVoidAsync("audioHelper.stopSpeaking");
        _isPlaying = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPlaybackStateChanged(bool isPlaying)
    {
        _isPlaying = isPlaying;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnBuffering(bool isBuffering)
    {
        _isBuffering = isBuffering;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPlaybackError(string message)
    {
        _isPlaying = false;
        _isBuffering = false;
        _hasError = true;
        _statusMessage = "Lỗi âm thanh: " + message;
        _debugInfo = "ERROR: " + message;
        StateHasChanged();
    }

    public void Dispose()
    {
        _objRef?.Dispose();
    }
}
