@page "/listen/{PoiId:int}"
@page "/listen"
@layout EmptyLayout
@using FoodStreetApp.CMS.Interfaces
@using FoodStreetApp.Shared.Entities
@inject IAdminDataService DataService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@implements IDisposable

@if (_showList)
{
    <div class="list-container">
        <div class="list-header">
            <div class="list-header-icon"><i class="bi bi-shop"></i></div>
            <h1>Phố Ẩm Thực Vĩnh Khánh</h1>
            <p>Chọn quán để nghe thuyết minh</p>
        </div>
        <div class="poi-list">
            @foreach (var poi in _allPois)
            {
                <div class="poi-list-item" @onclick="() => SelectPoi(poi.Id)">
                    @if (!string.IsNullOrEmpty(poi.ImageUrl))
                    {
                        <img src="@FixUrl(poi.ImageUrl)" alt="@poi.Name" class="poi-list-img" />
                    }
                    else
                    {
                        <div class="poi-list-img-placeholder"><i class="bi bi-shop"></i></div>
                    }
                    <div class="poi-list-info">
                        <h3>@poi.Name</h3>
                        <p>@(poi.Description ?? "Phố ẩm thực Vĩnh Khánh")</p>
                    </div>
                    <i class="bi bi-chevron-right poi-list-arrow"></i>
                </div>
            }
        </div>
    </div>
}
else
{
<div class="listen-container">
    @if (_isLoading)
    {
        <div class="status-box text-center">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;"></div>
            <h2 class="fw-bold">Đang tải dữ liệu...</h2>
            <p class="text-muted">Vui lòng chờ trong giây lát</p>
        </div>
    }
    else if (_notFound || _poi == null)
    {
        <div class="status-box text-center p-4 shadow bg-white rounded-4" style="max-width: 350px;">
            <div class="mb-3 text-warning">
                <i class="bi bi-exclamation-triangle" style="font-size: 4rem;"></i>
            </div>
            <h2 class="fw-bold h4">Không tìm thấy quán!</h2>
            <p class="text-muted small">Mã QR này trỏ đến địa điểm không tồn tại hoặc đã bị xóa khỏi hệ thống.</p>
            <a href="/" class="btn btn-primary w-100 rounded-pill mt-3">Quay lại trang chủ</a>
        </div>
    }
    else if (!_poi.IsApproved)
    {
        <div class="status-box text-center p-4 shadow bg-white rounded-4" style="max-width: 380px;">
            <div class="mb-3" style="color: #f59e0b;">
                <i class="bi bi-hourglass-split" style="font-size: 4rem;"></i>
            </div>
            <h2 class="fw-bold h4">Địa điểm đang chờ duyệt</h2>
            <p class="text-muted small">Quán <strong>@_poi.Name</strong> chưa được Admin phê duyệt. Vui lòng quay lại sau khi địa điểm đã được duyệt.</p>
            <div class="p-3 bg-light rounded-3 mt-3">
                <i class="bi bi-info-circle text-muted me-1"></i>
                <span class="text-muted x-small">Nếu bạn là chủ quán, hãy liên hệ Admin để duyệt nhanh hơn.</span>
            </div>
        </div>
    }
    else if (!_isPaid)
    {
        @* ===== PAYWALL CARD ===== *@
        <div class="paywall-card shadow-lg">
            <div class="gradient-bar"></div>
            <div class="card-content">
                <div class="icon-circle mb-3">
                    <i class="bi bi-lock-fill"></i>
                </div>
                <h2 class="restaurant-title">@_poi.Name</h2>
                <p class="text-muted small mb-1">@(_poi.Description ?? "Phố ẩm thực Vĩnh Khánh")</p>
                
                <div class="paywall-divider"></div>
                
                <div class="price-box">
                    <span class="price-label">Phí nghe thuyết minh</span>
                    <span class="price-value">20.000₫</span>
                </div>
                <p class="text-muted x-small mb-3">Thanh toán 1 lần, nghe không giới hạn tại địa điểm này.</p>

                @if (!string.IsNullOrEmpty(_payError))
                {
                    <div class="alert alert-danger py-2 small mb-3 rounded-3">
                        <i class="bi bi-exclamation-circle me-1"></i>@_payError
                    </div>
                }

                <div class="pay-methods mb-3">
                    <button class="pay-method-btn @(_payMethod == "momo" ? "active" : "")" @onclick="SelectMomo">
                        <i class="bi bi-phone"></i> MoMo
                    </button>
                    <button class="pay-method-btn @(_payMethod == "vnpay" ? "active" : "")" @onclick="SelectVnpay">
                        <i class="bi bi-qr-code"></i> VNPay
                    </button>
                    <button class="pay-method-btn @(_payMethod == "bank" ? "active" : "")" @onclick="SelectBank">
                        <i class="bi bi-bank"></i> CK
                    </button>
                </div>

                <button class="btn-pay-listen" @onclick="ProcessListenPayment" disabled="@_isPayProcessing">
                    @if (_isPayProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Đang xử lý...</span>
                    }
                    else
                    {
                        <i class="bi bi-shield-check me-1"></i>
                        <span>Thanh toán 20.000₫</span>
                    }
                </button>
            </div>
        </div>
    }
    else
    {
        @* ===== AUDIO PLAYER (after payment) ===== *@
        <div class="audio-card shadow-lg">
            <div class="gradient-bar"></div>

            @* Back button *@
            <button class="back-btn" @onclick="GoBackToList"><i class="bi bi-arrow-left"></i></button>

            @* Restaurant Image *@
            @if (!string.IsNullOrEmpty(_poi?.ImageUrl))
            {
                <div class="poi-hero-img">
                    <img src="@FixUrl(_poi.ImageUrl)" alt="@_poi.Name" />
                </div>
            }

            <div class="lang-selector">
                @foreach (var l in new[] { "vi", "en", "zh", "ko", "ja" })
                {
                    <button class="lang-btn @(_currentLang == l ? "active" : "")" @onclick='() => ChangeLang(l)'>@GetLangLabel(l)</button>
                }
            </div>

            <div class="card-content">
                <h1 class="restaurant-title">@_currentName</h1>
                <p class="restaurant-desc">@_statusMessage</p>

                @if (_showBrowserWarning)
                {
                    <div class="alert alert-warning p-2 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        Hãy nhấn <b>⋮</b> chọn <b>Mở bằng trình duyệt</b> để nghe tốt nhất.
                    </div>
                }

                <div class="player-controls">
                    <button id="main-play-btn" class="play-btn @(_isPlaying ? "playing" : "")" disabled="@_isBuffering">
                        @if (_isBuffering)
                        {
                            <div class="spinner-border text-white" style="width: 1.5rem; height: 1.5rem;"></div>
                        }
                        else
                        {
                            <i class="bi @(_isPlaying ? "bi-pause-fill" : "bi-play-fill ms-1")"></i>
                        }
                    </button>
                </div>

                @if (_isPlaying && !_isBuffering)
                {
                    <div class="audio-wave"><span></span><span></span><span></span><span></span><span></span></div>
                }

                <audio @ref="_audioElement" id="listenAudio" src="@_audioUrl" preload="auto" crossorigin="anonymous"></audio>

                <div class="paid-badge mt-3">
                    <i class="bi bi-patch-check-fill text-success me-1"></i>
                    <span class="x-small text-success">Đã thanh toán</span>
                </div>
            </div>
        </div>
    }
</div>
}

<script>
    window.initAudioMobileBridge = function(dotNetHelper, audioElement, playButtonId) {
        const playButton = document.getElementById(playButtonId);
        if (!playButton || !audioElement) return;

        // --- TRACKING LOGIC ---
        const poiId = window.location.pathname.split("/").pop();
        console.log("[QR PAGE] Loaded poiId:", poiId);

        let userId = localStorage.getItem("tracking_user_id");
        if (!userId) {
            userId = 'web-' + Math.random().toString(36).substr(2, 9);
            localStorage.setItem("tracking_user_id", userId);
        }

        async function track(action, extra = {}) {
            const payload = {
                userId: userId,
                poiId: parseInt(poiId),
                action: action,
                ...extra
            };

            console.log("[TRACKING] Sending:", payload);

            try {
                const res = await fetch("/api/history", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });
                console.log("[TRACKING] " + (res.ok ? "Success" : "Failed") + " (Status: " + res.status + ")");
            } catch (err) {
                console.error("[TRACKING] ERROR:", err);
            }
        }

        // 1. On page load (Initial Scanned Event)
        track("qr_scanned", { qrCode: window.location.href });
        // 2. Track poi_viewed (so it counts in dashboard metrics)
        track("poi_viewed");

        // --- REFACTORED PRECISION SESSION TRACKING ---
        let totalElapsedSeconds = 0;
        let timerInterval = null;
        let hasSentFinalTracking = false;

        function startTracking() {
            if (timerInterval) return;
            // If already sent for previous play, reset for new play session
            if (hasSentFinalTracking) {
                hasSentFinalTracking = false;
                totalElapsedSeconds = 0;
            }
            timerInterval = setInterval(() => {
                totalElapsedSeconds++;
            }, 1000);
        }

        function pauseTracking() {
            clearInterval(timerInterval);
            timerInterval = null;
        }

        function sendFinalTracking() {
            pauseTracking();
            if (hasSentFinalTracking || totalElapsedSeconds <= 0) return;
            
            hasSentFinalTracking = true;
            // Send the final cumulative duration
            track("audio_played", { durationSeconds: totalElapsedSeconds });
        }

        window.audioState = {
            isPlaying: false,
            currentLang: 'vi',
            ttsText: '',
            ttsLang: 'vi-VN',
            audioUrl: ''
        };

        playButton.onclick = function() {
            try {
                if (window.audioState.isPlaying) {
                    audioElement.pause();
                    if (window.speechSynthesis) window.speechSynthesis.cancel();
                    window.audioState.isPlaying = false;
                    pauseTracking(); // Just pause the timer, don't send yet
                    dotNetHelper.invokeMethodAsync('OnPlaybackStateChanged', false);
                } else {
                    // Just set state, timer will start when audio actually plays
                    if (window.audioState.currentLang === 'vi' && window.audioState.audioUrl) {
                        const playPromise = audioElement.play();
                        if (playPromise !== undefined) {
                            playPromise.then(() => {
                                // Handled by onplaying
                            }).catch(e => {
                                pauseTracking();
                                dotNetHelper.invokeMethodAsync('OnPlaybackError', "Browser Block: " + e.message);
                            });
                        }
                    } else {
                        if (!window.speechSynthesis) {
                            pauseTracking();
                            dotNetHelper.invokeMethodAsync('ToggleBrowserWarning', true);
                            return;
                        }
                        window.speechSynthesis.cancel();
                        const u = new SpeechSynthesisUtterance(window.audioState.ttsText);
                        u.lang = window.audioState.ttsLang;
                        u.onstart = () => {
                            window.audioState.isPlaying = true;
                            startTracking(); // Start only when audible
                            dotNetHelper.invokeMethodAsync('OnPlaybackStateChanged', true);
                        };
                        u.onend = () => {
                            window.audioState.isPlaying = false;
                            sendFinalTracking(); // End of audio = send
                            dotNetHelper.invokeMethodAsync('OnPlaybackStateChanged', false);
                        };
                        u.onerror = (e) => {
                            pauseTracking();
                            if (e.error !== 'interrupted') {
                                dotNetHelper.invokeMethodAsync('OnPlaybackError', "Voice Error: " + e.error);
                            } else {
                                window.audioState.isPlaying = false;
                                dotNetHelper.invokeMethodAsync('OnPlaybackStateChanged', false);
                            }
                        };
                        window.speechSynthesis.speak(u);
                    }
                }
            } catch (err) {
                pauseTracking();
                dotNetHelper.invokeMethodAsync('OnPlaybackError', err.message);
            }
        };

        audioElement.onplaying = () => {
            window.audioState.isPlaying = true;
            startTracking(); // START when actually playing
            dotNetHelper.invokeMethodAsync('OnPlaybackStateChanged', true);
        };
        audioElement.onpause = () => {
            window.audioState.isPlaying = false;
            pauseTracking(); // PAUSE timer, but don't send yet
            dotNetHelper.invokeMethodAsync('OnPlaybackStateChanged', false);
        };
        audioElement.onended = () => {
            window.audioState.isPlaying = false;
            sendFinalTracking(); // END = Send hit
            dotNetHelper.invokeMethodAsync('OnPlaybackStateChanged', false);
        };
        audioElement.onwaiting = () => {
            pauseTracking(); // PAUSE during buffering
            dotNetHelper.invokeMethodAsync('OnBuffering', true);
        };
        audioElement.oncanplay = () => dotNetHelper.invokeMethodAsync('OnBuffering', false);

        // Final attempt on closing tab
        window.addEventListener('beforeunload', () => {
            sendFinalTracking();
        });
    };

    window.updateAudioState = function(data) {
        if (window.audioState) Object.assign(window.audioState, data);
    };

    // Payment helpers
    window.getDeviceId = function() {
        let id = localStorage.getItem("tracking_user_id");
        if (!id) {
            id = 'web-' + Math.random().toString(36).substr(2, 9);
            localStorage.setItem("tracking_user_id", id);
        }
        return id;
    };

    window.checkLocalPayment = function(poiId) {
        return localStorage.getItem("paid_" + poiId) === "true";
    };

    window.saveLocalPayment = function(poiId) {
        localStorage.setItem("paid_" + poiId, "true");
    };

    // --- QR PRESENCE HEARTBEAT ---
    // Sends qr_listen_ping every 2 seconds while user is on the listen page after payment.
    // Stops when user leaves the page (beforeunload / visibilitychange).
    window._qrPingInterval = null;

    window.startQrPresencePing = function(poiId) {
        // Prevent duplicate intervals
        if (window._qrPingInterval) return;

        const userId = window.getDeviceId();
        console.log("[QR-PRESENCE] Starting heartbeat for user:", userId, "POI:", poiId);

        function sendPing() {
            try {
                fetch("/api/history", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        userId: userId,
                        poiId: 0,
                        action: "qr_listen_ping"
                    })
                }).catch(() => {});
            } catch(e) {}
        }

        // Send immediate first ping
        sendPing();

        // Then every 2 seconds
        window._qrPingInterval = setInterval(sendPing, 2000);

        // Stop heartbeat when user leaves or hides page
        window.addEventListener('beforeunload', window._stopQrPing);
        document.addEventListener('visibilitychange', function() {
            if (document.visibilityState === 'hidden') {
                window._stopQrPing();
            } else if (document.visibilityState === 'visible') {
                // Resume if they come back
                if (!window._qrPingInterval) {
                    sendPing();
                    window._qrPingInterval = setInterval(sendPing, 2000);
                }
            }
        });
    };

    window._stopQrPing = function() {
        if (window._qrPingInterval) {
            clearInterval(window._qrPingInterval);
            window._qrPingInterval = null;
            console.log("[QR-PRESENCE] Heartbeat stopped");
        }
    };

    window.stopQrPresencePing = function() {
        window._stopQrPing();
    };
</script>

<style>
    .listen-container { display: flex; justify-content: center; align-items: center; min-height: 100vh; background: #f1f5f9; padding: 20px; font-family: 'Inter', sans-serif; }
    .audio-card, .paywall-card { width: 100%; max-width: 400px; background: white; border-radius: 32px; overflow: hidden; position: relative; }
    .gradient-bar { height: 6px; background: linear-gradient(90deg, #3b82f6, #06b6d4); }
    .lang-selector { display: flex; justify-content: center; gap: 8px; padding: 20px 10px 0; }
    .lang-btn { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 6px 12px; font-size: 0.7rem; font-weight: bold; color: #64748b; cursor: pointer; transition: 0.2s; border: 1px solid transparent; }
    .lang-btn.active { background: #3b82f6; color: white; border-color: #3b82f6; }
    .card-content { padding: 30px; text-align: center; }
    .icon-circle { width: 64px; height: 64px; background: #eff6ff; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; color: #3b82f6; font-size: 1.8rem; }
    .restaurant-title { font-weight: 800; font-size: 1.5rem; color: #1e293b; margin-bottom: 8px; }
    .subtitle { font-size: 0.9rem; color: #64748b; min-height: 2.5rem; margin-bottom: 15px; display: flex; align-items: center; justify-content: center; line-height: 1.4; }
    .play-btn { width: 80px; height: 80px; background: #3b82f6; border: none; border-radius: 50%; color: white; font-size: 2.5rem; box-shadow: 0 10px 20px rgba(59, 130, 246, 0.3); cursor: pointer; transition: 0.2s; margin: 0 auto; display: flex; align-items: center; justify-content: center; }
    .play-btn.playing { background: #0f172a; }
    .audio-wave { display: flex; justify-content: center; gap: 4px; height: 20px; margin-top: 20px; }
    .audio-wave span { width: 3px; background: #3b82f6; border-radius: 2px; animation: w 0.8s infinite alternate; }
    @@keyframes w { from { height: 4px; } to { height: 18px; } }
    .x-small { font-size: 0.72rem; }

    /* Paywall styles */
    .paywall-card .icon-circle { background: #fef3c7; color: #f59e0b; }
    .paywall-divider { height: 1px; background: linear-gradient(90deg, transparent, #e2e8f0, transparent); margin: 16px 0; }
    .price-box { 
        background: linear-gradient(135deg, #f0fdf4, #ecfdf5); 
        border: 2px solid #86efac; 
        border-radius: 16px; 
        padding: 16px; 
        margin-bottom: 8px; 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
    }
    .price-label { font-weight: 600; color: #374151; font-size: 0.9rem; }
    .price-value { font-weight: 800; color: #059669; font-size: 1.4rem; }
    .pay-methods { display: flex; gap: 8px; justify-content: center; }
    .pay-method-btn {
        flex: 1;
        background: #f8fafc;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 10px 8px;
        font-size: 0.75rem;
        font-weight: 600;
        color: #64748b;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .pay-method-btn.active { 
        border-color: #3b82f6; 
        color: #3b82f6; 
        background: #eff6ff; 
        box-shadow: 0 0 12px rgba(59,130,246,0.15);
    }
    .btn-pay-listen {
        width: 100%;
        padding: 14px;
        background: linear-gradient(135deg, #f59e0b, #ef4444);
        border: none;
        border-radius: 16px;
        color: white;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .btn-pay-listen:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(245,158,11,0.3); }
    .btn-pay-listen:disabled { opacity: 0.6; cursor: not-allowed; }
    .paid-badge {
        display: inline-flex;
        align-items: center;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 20px;
        padding: 4px 14px;
    }

    /* List View */
    .list-container { min-height: 100vh; background: #f1f5f9; font-family: 'Inter', sans-serif; }
    .list-header { background: linear-gradient(135deg, #3b82f6, #06b6d4); color: white; padding: 40px 24px 30px; text-align: center; }
    .list-header-icon { width: 56px; height: 56px; background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; font-size: 1.5rem; }
    .list-header h1 { font-size: 1.4rem; font-weight: 800; margin: 0 0 4px; }
    .list-header p { font-size: 0.85rem; opacity: 0.85; margin: 0; }
    .poi-list { padding: 16px; }
    .poi-list-item { display: flex; align-items: center; gap: 14px; background: white; border-radius: 16px; padding: 12px; margin-bottom: 10px; cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 8px rgba(0,0,0,0.04); border: 1px solid rgba(0,0,0,0.04); }
    .poi-list-item:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.08); }
    .poi-list-item:active { transform: scale(0.98); }
    .poi-list-img { width: 64px; height: 64px; border-radius: 12px; object-fit: cover; flex-shrink: 0; }
    .poi-list-img-placeholder { width: 64px; height: 64px; border-radius: 12px; background: #eff6ff; display: flex; align-items: center; justify-content: center; color: #3b82f6; font-size: 1.5rem; flex-shrink: 0; }
    .poi-list-info { flex: 1; min-width: 0; }
    .poi-list-info h3 { font-size: 0.95rem; font-weight: 700; color: #1e293b; margin: 0 0 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .poi-list-info p { font-size: 0.75rem; color: #64748b; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.3; }
    .poi-list-arrow { color: #cbd5e1; font-size: 1rem; }

    /* Redesigned Player */
    .back-btn { position: absolute; top: 16px; left: 16px; z-index: 10; background: rgba(255,255,255,0.9); border: none; border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 1.1rem; color: #475569; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .back-btn:hover { background: white; }
    .poi-hero-img { width: 100%; height: 200px; overflow: hidden; }
    .poi-hero-img img { width: 100%; height: 100%; object-fit: cover; }
    .restaurant-desc { font-size: 0.85rem; color: #64748b; line-height: 1.5; margin-bottom: 20px; max-height: 4.5em; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
</style>

@code {
    [Parameter] public int PoiId { get; set; }
    private POI? _poi;
    private ElementReference _audioElement;
    private DotNetObjectReference<ListenPage>? _objRef;
    private bool _isPlaying, _isBuffering, _hasError, _showBrowserWarning;
    private bool _isLoading = true;
    private bool _notFound = false;
    private string _currentLang = "vi", _currentName = "", _statusMessage = "", _audioUrl = "";

    // List state
    private bool _showList = false;
    private List<POI> _allPois = new();

    // Payment state
    private bool _isPaid = false;
    private bool _isPayProcessing = false;
    private string? _payError;
    private string _payMethod = "momo";
    private string _deviceId = "";

    private void SelectMomo() => _payMethod = "momo";
    private void SelectVnpay() => _payMethod = "vnpay";
    private void SelectBank() => _payMethod = "bank";

    private string GetLangLabel(string lang) => lang switch {
        "vi" => "🇻🇳 VI",
        "en" => "🇺🇸 EN",
        "zh" => "🇨🇳 ZH",
        "ko" => "🇰🇷 KO",
        "ja" => "🇯🇵 JA",
        _ => lang.ToUpper()
    };

    private void SelectPoi(int poiId)
    {
        NavigationManager.NavigateTo($"/listen/{poiId}", forceLoad: true);
    }

    private void GoBackToList()
    {
        NavigationManager.NavigateTo("/listen", forceLoad: true);
    }

    protected override void OnInitialized() {
        if (PoiId == 0) {
            // No specific POI → show list
            _allPois = DataService.GetPois().Where(p => p.IsApproved).OrderBy(p => p.Name).ToList();
            _showList = true;
            _isLoading = false;
            return;
        }

        try {
            _poi = DataService.GetPoiById(PoiId);
            if (_poi != null) {
                _audioUrl = FixUrl(_poi.AudioUrl);
                UpdateDisplay();
            } else {
                _notFound = true;
            }
        } catch (Exception ex) {
            Console.WriteLine($"[ListenPage] Error loading POI: {ex.Message}");
            _hasError = true;
            _statusMessage = "Không thể tải dữ liệu";
        } finally {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender && _poi != null && _poi.IsApproved) {
            // Get device ID and check payment
            _deviceId = await JSRuntime.InvokeAsync<string>("getDeviceId");
            
            // Check localStorage first (fast)
            var localPaid = await JSRuntime.InvokeAsync<bool>("checkLocalPayment", PoiId);
            if (localPaid)
            {
                _isPaid = true;
                StateHasChanged();
                await Task.Delay(100);
                await InitPlayer();
                // Start QR presence heartbeat after payment confirmed
                await JSRuntime.InvokeVoidAsync("startQrPresencePing", PoiId);
                return;
            }

            // Check server (in case localStorage was cleared but payment exists)
            try {
                var http = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
                var resp = await http.PostAsJsonAsync("api/listen/check-payment", new { deviceId = _deviceId, poiId = PoiId });
                if (resp.IsSuccessStatusCode)
                {
                    var json = await resp.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                    if (json.TryGetProperty("paid", out var paidProp) && paidProp.GetBoolean())
                    {
                        _isPaid = true;
                        await JSRuntime.InvokeVoidAsync("saveLocalPayment", PoiId);
                        StateHasChanged();
                        await Task.Delay(100);
                        await InitPlayer();
                        // Start QR presence heartbeat after payment confirmed
                        await JSRuntime.InvokeVoidAsync("startQrPresencePing", PoiId);
                        return;
                    }
                }
            } catch { /* server check failed, show paywall */ }

            StateHasChanged();
        }
    }

    private async Task InitPlayer()
    {
        _objRef = DotNetObjectReference.Create(this);
        await Task.Delay(300);
        await JSRuntime.InvokeVoidAsync("initAudioMobileBridge", _objRef, _audioElement, "main-play-btn");
        await SyncDataToJs();
    }

    private async Task ProcessListenPayment()
    {
        _payError = null;
        _isPayProcessing = true;
        StateHasChanged();

        try
        {
            // Simulate payment delay
            await Task.Delay(2000);

            // Call API to record payment
            var http = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
            var resp = await http.PostAsJsonAsync("api/listen/pay", new { deviceId = _deviceId, poiId = PoiId, amount = 20000 });

            if (resp.IsSuccessStatusCode)
            {
                // Save to localStorage
                await JSRuntime.InvokeVoidAsync("saveLocalPayment", PoiId);
                _isPaid = true;
                StateHasChanged();

                // Wait for DOM update then init player
                await Task.Delay(200);
                await InitPlayer();
                // Start QR presence heartbeat after payment
                await JSRuntime.InvokeVoidAsync("startQrPresencePing", PoiId);
            }
            else
            {
                _payError = "Thanh toán thất bại. Vui lòng thử lại.";
            }
        }
        catch (Exception ex)
        {
            _payError = $"Lỗi kết nối: {ex.Message}";
        }
        finally
        {
            _isPayProcessing = false;
            StateHasChanged();
        }
    }

    private string FixUrl(string? u) => string.IsNullOrEmpty(u) ? "" : (u.Contains("://") || u.StartsWith("data:") ? u : $"{NavigationManager.BaseUri.TrimEnd('/')}/{u.TrimStart('/')}");

    private async Task ChangeLang(string l) { 
        await JSRuntime.InvokeVoidAsync("eval", "if(window.audioState){ window.audioState.isPlaying = false; if(window.speechSynthesis) window.speechSynthesis.cancel(); }");
        _isPlaying = false; 
        _currentLang = l; 
        UpdateDisplay();
        await SyncDataToJs();
        StateHasChanged();
    }

    private void UpdateDisplay() {
        if (_poi == null) return;
        _hasError = false;
        _currentName = _currentLang switch { "en" => _poi.NameEn, "zh" => _poi.NameZh, "ko" => _poi.NameKo, "ja" => _poi.NameJa, _ => _poi.Name } ?? _poi.Name;
        _statusMessage = _currentLang switch { "en" => _poi.DescriptionEn, "zh" => _poi.DescriptionZh, "ko" => _poi.DescriptionKo, "ja" => _poi.DescriptionJa, _ => _poi.Description } ?? _poi.Description ?? "Sẵn sàng...";
    }

    private async Task SyncDataToJs() {
        if (_poi == null) return;
        var text = _currentLang switch { "en" => _poi.TextContentEn, "zh" => _poi.TextContentZh, "ko" => _poi.TextContentKo, "ja" => _poi.TextContentJa, _ => _poi.TextContent } ?? _statusMessage;
        var langCode = _currentLang switch { "en" => "en-US", "zh" => "zh-CN", "ko" => "ko-KR", "ja" => "ja-JP", _ => "vi-VN" };

        await JSRuntime.InvokeVoidAsync("updateAudioState", new {
            currentLang = _currentLang,
            ttsText = text,
            ttsLang = langCode,
            audioUrl = _audioUrl
        });
    }

    [JSInvokable] public void OnPlaybackStateChanged(bool it) { _isPlaying = it; if(it) _hasError = false; StateHasChanged(); }
    [JSInvokable] public void OnBuffering(bool it) { _isBuffering = it; StateHasChanged(); }
    [JSInvokable] public void ToggleBrowserWarning(bool it) { _showBrowserWarning = it; StateHasChanged(); }
    
    [JSInvokable] public void OnPlaybackError(string m) { 
        _isPlaying = false; _isBuffering = false; _hasError = true; 
        _statusMessage = "Sự cố âm thanh";
        StateHasChanged(); 
    }

    public async void Dispose()
    {
        _objRef?.Dispose();
        // Stop QR presence heartbeat when leaving the page
        try { await JSRuntime.InvokeVoidAsync("stopQrPresencePing"); } catch { }
    }
}
