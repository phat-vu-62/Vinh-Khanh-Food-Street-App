@page "/listen/{PoiId:int}"
@layout EmptyLayout
@using FoodStreetApp.CMS.Interfaces
@using FoodStreetApp.Shared.Entities
@inject IAdminDataService DataService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="listen-container">
    @if (_poi == null)
    {
        <div class="status-box text-center">
            <div class="spinner-border text-primary mb-3"></div>
            <h2>Đang tìm quán ăn...</h2>
        </div>
    }
    else
    {
        <div class="audio-card shadow-lg">
            <div class="gradient-bar"></div>
            
            <div class="lang-selector">
                @foreach (var l in new[] { "vi", "en", "zh", "ko", "ja" })
                {
                    <button class="lang-btn @(_currentLang == l ? "active" : "")" @onclick='() => ChangeLang(l)'>@l.ToUpper()</button>
                }
            </div>

            <div class="card-content">
                <div class="icon-circle">
                    @if (_isBuffering) { <div class="spinner-border text-primary" style="width: 2rem; height: 2rem;"></div> }
                    else { <i class="bi bi-shop"></i> }
                </div>
                
                <h1 class="restaurant-title">@_currentName</h1>
                <p class="subtitle @(_hasError ? "text-danger fw-bold" : "")">@_statusMessage</p>

                <div class="player-controls">
                    <button id="main-play-btn" class="play-btn @(_isPlaying ? "playing" : "")" disabled="@_isBuffering">
                        <i class="bi @(_isPlaying ? "bi-pause-fill" : "bi-play-fill ms-1")"></i>
                    </button>
                </div>

                @if (_isPlaying && !_isBuffering)
                {
                    <div class="audio-wave"><span></span><span></span><span></span><span></span><span></span></div>
                }

                <audio @ref="_audioElement" id="listenAudio" src="@_audioUrl" preload="auto" crossorigin="anonymous"></audio>
            </div>

            <div class="debug-panel p-2 x-small text-muted text-center border-top">
                <code>@_debugInfo</code>
            </div>
        </div>
    }
</div>

<script>
    window.initAudioMobileBridge = function(dotNetHelper, audioElement, playButtonId) {
        const playButton = document.getElementById(playButtonId);
        if (!playButton || !audioElement) return;

        window.audioState = {
            isPlaying: false,
            currentLang: 'vi',
            ttsText: '',
            ttsLang: 'vi-VN',
            audioUrl: ''
        };

        playButton.onclick = function() {
            try {
                if (window.audioState.isPlaying) {
                    audioElement.pause();
                    if (window.speechSynthesis) window.speechSynthesis.cancel();
                    window.audioState.isPlaying = false;
                } else {
                    if (window.audioState.currentLang === 'vi' && window.audioState.audioUrl) {
                        audioElement.play().catch(e => dotNetHelper.invokeMethodAsync('OnPlaybackError', e.message));
                    } else {
                        if (!window.speechSynthesis) {
                            dotNetHelper.invokeMethodAsync('OnPlaybackError', "Trình duyệt không hỗ trợ AI đọc. Hãy dùng Chrome/Safari.");
                            return;
                        }
                        window.speechSynthesis.cancel();
                        const u = new SpeechSynthesisUtterance(window.audioState.ttsText);
                        u.lang = window.audioState.ttsLang;
                        u.onstart = () => dotNetHelper.invokeMethodAsync('OnPlaybackStateChanged', true);
                        u.onend = () => dotNetHelper.invokeMethodAsync('OnPlaybackStateChanged', false);
                        u.onerror = (e) => {
                            // IGNORE 'interrupted' because it's triggered by .cancel()
                            if (e.error !== 'interrupted') {
                                dotNetHelper.invokeMethodAsync('OnPlaybackError', "AI Voice: " + e.error);
                            } else {
                                dotNetHelper.invokeMethodAsync('OnPlaybackStateChanged', false);
                            }
                        };
                        window.speechSynthesis.speak(u);
                    }
                    window.audioState.isPlaying = true;
                }
                dotNetHelper.invokeMethodAsync('OnPlaybackStateChanged', window.audioState.isPlaying);
            } catch (err) {
                dotNetHelper.invokeMethodAsync('OnPlaybackError', err.message);
            }
        };

        // Standard Audio Bindings
        audioElement.onplaying = () => dotNetHelper.invokeMethodAsync('OnPlaybackStateChanged', true);
        audioElement.onpause = () => dotNetHelper.invokeMethodAsync('OnPlaybackStateChanged', false);
        audioElement.onended = () => dotNetHelper.invokeMethodAsync('OnPlaybackStateChanged', false);
        audioElement.onwaiting = () => dotNetHelper.invokeMethodAsync('OnBuffering', true);
        audioElement.oncanplay = () => dotNetHelper.invokeMethodAsync('OnBuffering', false);
    };

    window.updateAudioState = function(data) {
        if (window.audioState) Object.assign(window.audioState, data);
    };
</script>

<style>
    .listen-container { display: flex; justify-content: center; align-items: center; min-height: 100vh; background: #f1f5f9; padding: 20px; font-family: 'Inter', sans-serif; }
    .audio-card { width: 100%; max-width: 400px; background: white; border-radius: 32px; overflow: hidden; position: relative; }
    .gradient-bar { height: 6px; background: linear-gradient(90deg, #3b82f6, #06b6d4); }
    .lang-selector { display: flex; justify-content: center; gap: 8px; padding: 20px 10px 0; }
    .lang-btn { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 6px 12px; font-size: 0.7rem; font-weight: bold; color: #64748b; cursor: pointer; transition: 0.2s; }
    .lang-btn.active { background: #3b82f6; color: white; border-color: #3b82f6; }
    .card-content { padding: 30px; text-align: center; }
    .icon-circle { width: 64px; height: 64px; background: #eff6ff; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; color: #3b82f6; font-size: 1.8rem; }
    .restaurant-title { font-weight: 800; font-size: 1.5rem; color: #1e293b; margin-bottom: 8px; }
    .subtitle { font-size: 0.9rem; color: #64748b; min-height: 3rem; margin-bottom: 30px; display: flex; align-items: center; justify-content: center; line-height: 1.4; }
    .play-btn { width: 80px; height: 80px; background: #3b82f6; border: none; border-radius: 50%; color: white; font-size: 2.5rem; box-shadow: 0 10px 20px rgba(59, 130, 246, 0.3); cursor: pointer; transition: 0.2s; margin: 0 auto; display: flex; align-items: center; justify-content: center; }
    .play-btn.playing { background: #0f172a; }
    .audio-wave { display: flex; justify-content: center; gap: 4px; height: 20px; margin-top: 20px; }
    .audio-wave span { width: 3px; background: #3b82f6; border-radius: 2px; animation: w 0.8s infinite alternate; }
    @@keyframes w { from { height: 4px; } to { height: 18px; } }
    .x-small { font-size: 0.65rem; }
</style>

@code {
    [Parameter] public int PoiId { get; set; }
    private POI? _poi;
    private ElementReference _audioElement;
    private DotNetObjectReference<ListenPage>? _objRef;
    private bool _isPlaying, _isBuffering, _hasError;
    private string _currentLang = "vi", _currentName = "", _statusMessage = "", _audioUrl = "", _debugInfo = "V-Final-Stable";

    protected override void OnInitialized() {
        _poi = DataService.GetPoiById(PoiId);
        if (_poi != null) {
            _audioUrl = FixUrl(_poi.AudioUrl);
            UpdateDisplay();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender && _poi != null) {
            _objRef = DotNetObjectReference.Create(this);
            await Task.Delay(300);
            await JSRuntime.InvokeVoidAsync("initAudioMobileBridge", _objRef, _audioElement, "main-play-btn");
            await SyncDataToJs();
        }
    }

    private string FixUrl(string? u) => string.IsNullOrEmpty(u) ? "" : (u.Contains("://") ? u : $"{NavigationManager.BaseUri.TrimEnd('/')}/{u.TrimStart('/')}");

    private async Task ChangeLang(string l) { 
        if (string.IsNullOrEmpty(l)) return;
        await JSRuntime.InvokeVoidAsync("eval", "if(window.audioState){ window.audioState.isPlaying = false; if(window.speechSynthesis) window.speechSynthesis.cancel(); }");
        _isPlaying = false; 
        _currentLang = l; 
        UpdateDisplay();
        await SyncDataToJs();
        StateHasChanged();
    }

    private void UpdateDisplay() {
        if (_poi == null) return;
        _hasError = false;
        _currentName = _currentLang switch { "en" => _poi.NameEn, "zh" => _poi.NameZh, "ko" => _poi.NameKo, "ja" => _poi.NameJa, _ => _poi.Name } ?? _poi.Name;
        _statusMessage = _currentLang switch { "en" => _poi.DescriptionEn, "zh" => _poi.DescriptionZh, "ko" => _poi.DescriptionKo, "ja" => _poi.DescriptionJa, _ => _poi.Description } ?? _poi.Description ?? "Sẵn sàng phát...";
    }

    private async Task SyncDataToJs() {
        if (_poi == null) return;
        var text = _currentLang switch { "en" => _poi.TextContentEn, "zh" => _poi.TextContentZh, "ko" => _poi.TextContentKo, "ja" => _poi.TextContentJa, _ => _poi.TextContent } ?? _statusMessage;
        var langCode = _currentLang switch { "en" => "en-US", "zh" => "zh-CN", "ko" => "ko-KR", "ja" => "ja-JP", _ => "vi-VN" };

        await JSRuntime.InvokeVoidAsync("updateAudioState", new {
            currentLang = _currentLang,
            ttsText = text,
            ttsLang = langCode,
            audioUrl = _audioUrl
        });
    }

    [JSInvokable] public void OnPlaybackStateChanged(bool it) { _isPlaying = it; if(it) _hasError = false; StateHasChanged(); }
    [JSInvokable] public void OnBuffering(bool it) { _isBuffering = it; StateHasChanged(); }
    [JSInvokable] public void OnPlaybackError(string m) { 
        _isPlaying = false; _isBuffering = false; _hasError = true; 
        _debugInfo = "Debug: " + m;
        _statusMessage = "Sự cố: " + m;
        StateHasChanged(); 
    }

    public void Dispose() => _objRef?.Dispose();
}
