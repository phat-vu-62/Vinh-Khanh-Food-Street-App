@page "/register"
@layout EmptyLayout
@using System.Text.Json
@using System.Text.Json.Serialization
@inject HttpClient Http
@inject NavigationManager NavigationManager

<div class="register-page">
    <div class="register-container">
        @* Header *@
        <div class="text-center mb-4">
            <i class="bi bi-egg-fried fs-1" style="color: #00d2ff;"></i>
            <h2 class="fw-bold mt-2 text-white">Đăng ký Chủ quán</h2>
            <p class="text-white-50 small">Tham gia hệ thống Food Street App</p>
        </div>

        @if (_step < 4)
        {
            @* Stepper *@
            <div class="stepper mb-4">
                <div class="stepper-track">
                    <div class="stepper-progress" style="width: @((_step - 1) * 50)%"></div>
                </div>
                <div class="stepper-dots">
                    @for (int i = 1; i <= 3; i++)
                    {
                        var step = i;
                        <div class="stepper-dot @(step <= _step ? "active" : "") @(step < _step ? "done" : "")">
                            @if (step < _step)
                            {
                                <i class="bi bi-check-lg"></i>
                            }
                            else
                            {
                                <span>@step</span>
                            }
                            <small class="stepper-label">
                                @(step == 1 ? "Thông tin" : step == 2 ? "Địa điểm" : "Thanh toán")
                            </small>
                        </div>
                    }
                </div>
            </div>
        }

        @* Error Alert *@
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger border-0 rounded-3 mb-3 shadow-sm" style="background: rgba(220, 53, 69, 0.15); color: #ff6b81;">
                <i class="bi bi-exclamation-circle-fill me-2"></i>@_error
            </div>
        }

        @* STEP 1: Personal Info *@
        @if (_step == 1)
        {
            <div class="step-card animate-in">
                <h5 class="fw-bold text-white mb-3"><i class="bi bi-person-badge me-2 text-info"></i>Thông tin cá nhân</h5>
                <div class="form-floating mb-3">
                    <input type="text" class="form-control glass-input" id="fullName" placeholder="Họ tên"
                           @bind="_fullName" @bind:event="oninput" />
                    <label for="fullName" class="text-white-50">Họ và tên *</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="tel" class="form-control glass-input" id="phone" placeholder="Số điện thoại"
                           @bind="_phone" @bind:event="oninput" />
                    <label for="phone" class="text-white-50">Số điện thoại *</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="email" class="form-control glass-input" id="email" placeholder="Email"
                           @bind="_email" @bind:event="oninput" />
                    <label for="email" class="text-white-50">Email</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="text" class="form-control glass-input" id="address" placeholder="Địa chỉ"
                           @bind="_address" @bind:event="oninput" />
                    <label for="address" class="text-white-50">Địa chỉ</label>
                </div>
                <button class="btn btn-gradient w-100 py-3 fw-bold" @onclick="GoStep2"
                        disabled="@(string.IsNullOrWhiteSpace(_fullName) || string.IsNullOrWhiteSpace(_phone))">
                    Tiếp tục <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>
        }

        @* STEP 2: POI Info *@
        @if (_step == 2)
        {
            <div class="step-card animate-in">
                <h5 class="fw-bold text-white mb-3"><i class="bi bi-shop me-2 text-info"></i>Thông tin địa điểm</h5>
                <div class="form-floating mb-3">
                    <input type="text" class="form-control glass-input" id="poiName" placeholder="Tên quán"
                           @bind="_poiName" @bind:event="oninput" />
                    <label for="poiName" class="text-white-50">Tên quán / địa điểm *</label>
                </div>
                <div class="info-box mb-3">
                    <i class="bi bi-info-circle text-info me-2"></i>
                    <span class="text-white-50 small">Địa điểm sẽ được tạo tại khu vực Phố ẩm thực Vĩnh Khánh. Bạn có thể chỉnh sửa vị trí chính xác sau khi đăng nhập.</span>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary flex-fill py-3" @onclick="() => _step = 1">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </button>
                    <button class="btn btn-gradient flex-fill py-3 fw-bold" @onclick="GoStep3"
                            disabled="@(string.IsNullOrWhiteSpace(_poiName))">
                        Tiếp tục <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        }

        @* STEP 3: Payment *@
        @if (_step == 3)
        {
            <div class="step-card animate-in">
                <h5 class="fw-bold text-white mb-3"><i class="bi bi-credit-card me-2 text-info"></i>Thanh toán đăng ký</h5>

                @* Summary *@
                <div class="summary-box mb-4">
                    <div class="summary-row">
                        <span class="text-white-50">Chủ quán</span>
                        <span class="text-white fw-semibold">@_fullName</span>
                    </div>
                    <div class="summary-row">
                        <span class="text-white-50">Số điện thoại</span>
                        <span class="text-white fw-semibold">@_phone</span>
                    </div>
                    <div class="summary-row">
                        <span class="text-white-50">Tên quán</span>
                        <span class="text-white fw-semibold">@_poiName</span>
                    </div>
                    <hr class="border-secondary my-2" />
                    <div class="summary-row">
                        <span class="text-white fw-bold">Phí đăng ký</span>
                        <span class="text-warning fw-bold fs-5">300.000₫</span>
                    </div>
                </div>

                @* Payment Methods *@
                <div class="mb-3">
                    <label class="text-white-50 small mb-2 d-block">Phương thức thanh toán</label>
                    <div class="d-flex gap-2">
                        <button class="payment-method @(_payMethod == "momo" ? "selected" : "")" @onclick="SelectMomo">
                            <i class="bi bi-phone fs-4 d-block mb-1"></i>
                            <span class="small">MoMo</span>
                        </button>
                        <button class="payment-method @(_payMethod == "vnpay" ? "selected" : "")" @onclick="SelectVnpay">
                            <i class="bi bi-qr-code fs-4 d-block mb-1"></i>
                            <span class="small">VNPay</span>
                        </button>
                        <button class="payment-method @(_payMethod == "bank" ? "selected" : "")" @onclick="SelectBank">
                            <i class="bi bi-bank fs-4 d-block mb-1"></i>
                            <span class="small">Chuyển khoản</span>
                        </button>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary flex-fill py-3" @onclick="() => _step = 2">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </button>
                    <button class="btn btn-pay flex-fill py-3 fw-bold @(_isProcessing ? "disabled" : "")" @onclick="ProcessPayment">
                        @if (_isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Đang xử lý...</span>
                        }
                        else
                        {
                            <i class="bi bi-shield-check me-1"></i>
                            <span>Thanh toán 300.000₫</span>
                        }
                    </button>
                </div>
            </div>
        }

        @* STEP 4: Success! *@
        @if (_step == 4)
        {
            <div class="step-card animate-in text-center">
                <div class="success-icon mb-3">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <h4 class="fw-bold text-white mb-2">Đăng ký thành công! 🎉</h4>
                <p class="text-white-50 mb-4">Tài khoản của bạn đã được tạo. Hãy sử dụng thông tin dưới đây để đăng nhập.</p>

                <div class="credential-box mb-4">
                    <div class="credential-row">
                        <span class="text-white-50"><i class="bi bi-person me-2"></i>Tên đăng nhập</span>
                        <span class="text-info fw-bold fs-5">@_phone</span>
                    </div>
                    <hr class="border-secondary my-2" />
                    <div class="credential-row">
                        <span class="text-white-50"><i class="bi bi-key me-2"></i>Mật khẩu</span>
                        <span class="text-warning fw-bold fs-5">123</span>
                    </div>
                </div>

                <div class="alert border-0 rounded-3 mb-4" style="background: rgba(255, 193, 7, 0.12); color: #ffc107;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <small>Lưu ý: Địa điểm sẽ cần Admin duyệt trước khi hiển thị trên app. Vui lòng đổi mật khẩu sau khi đăng nhập.</small>
                </div>

                <button class="btn btn-gradient w-100 py-3 fw-bold" @onclick="GoToLogin">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập ngay
                </button>
            </div>
        }

        @* Footer link *@
        @if (_step < 4)
        {
            <div class="text-center mt-4">
                <a href="/login" class="text-white-50 text-decoration-none small hover-link">
                    <i class="bi bi-arrow-left me-1"></i> Đã có tài khoản? Đăng nhập
                </a>
            </div>
        }
    </div>
</div>

<style>
    .register-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0a1628 0%, #132743 40%, #1a3a5c 70%, #0f2027 100%);
        padding: 20px;
        position: relative;
        overflow: hidden;
    }
    .register-page::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -30%;
        width: 600px;
        height: 600px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(0,210,255,0.06) 0%, transparent 70%);
        pointer-events: none;
    }
    .register-page::after {
        content: '';
        position: absolute;
        bottom: -40%;
        left: -20%;
        width: 500px;
        height: 500px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(58,123,213,0.06) 0%, transparent 70%);
        pointer-events: none;
    }
    .register-container {
        width: 100%;
        max-width: 520px;
        position: relative;
        z-index: 1;
    }

    /* Stepper */
    .stepper { position: relative; padding: 0 30px; }
    .stepper-track {
        position: absolute;
        top: 20px;
        left: 60px;
        right: 60px;
        height: 3px;
        background: rgba(255,255,255,0.1);
        border-radius: 2px;
    }
    .stepper-progress {
        height: 100%;
        background: linear-gradient(to right, #00d2ff, #3a7bd5);
        border-radius: 2px;
        transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .stepper-dots {
        display: flex;
        justify-content: space-between;
        position: relative;
    }
    .stepper-dot {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.85rem;
        color: rgba(255,255,255,0.3);
        background: rgba(255,255,255,0.05);
        border: 2px solid rgba(255,255,255,0.1);
        transition: all 0.3s ease;
        position: relative;
    }
    .stepper-dot.active {
        color: #fff;
        background: linear-gradient(135deg, #00d2ff, #3a7bd5);
        border-color: transparent;
        box-shadow: 0 0 20px rgba(0,210,255,0.3);
    }
    .stepper-dot.done {
        background: #10b981;
        border-color: transparent;
        box-shadow: 0 0 15px rgba(16,185,129,0.3);
    }
    .stepper-label {
        position: absolute;
        bottom: -22px;
        left: 50%;
        transform: translateX(-50%);
        white-space: nowrap;
        font-size: 0.65rem;
        font-weight: normal;
        color: rgba(255,255,255,0.4);
    }
    .stepper-dot.active .stepper-label { color: #00d2ff; }

    /* Step Card */
    .step-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        padding: 30px;
        backdrop-filter: blur(20px);
    }
    .animate-in {
        animation: slideUp 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Glass Input */
    .glass-input {
        background: rgba(255,255,255,0.06) !important;
        border: 1px solid rgba(255,255,255,0.12) !important;
        color: #fff !important;
        border-radius: 12px !important;
        transition: all 0.3s ease;
        height: auto !important;
        min-height: 65px !important;
        line-height: 1.6 !important;
    }
    .glass-input:focus {
        border-color: rgba(0,210,255,0.5) !important;
        box-shadow: 0 0 0 3px rgba(0,210,255,0.1) !important;
        background: rgba(255,255,255,0.08) !important;
    }
    .form-floating > label { color: rgba(255,255,255,0.4) !important; }
    .form-floating > .glass-input:focus ~ label,
    .form-floating > .glass-input:not(:placeholder-shown) ~ label {
        color: #00d2ff !important;
    }
    .form-floating > .glass-input:focus,
    .form-floating > .glass-input:not(:placeholder-shown) {
        padding-top: 30px !important;
        padding-bottom: 10px !important;
    }
    .form-floating > .glass-input ~ label::after {
        background-color: transparent !important;
    }

    /* Buttons */
    .btn-gradient {
        background: linear-gradient(to right, #3a7bd5, #00d2ff);
        border: none;
        border-radius: 14px;
        color: #fff;
        transition: all 0.3s ease;
    }
    .btn-gradient:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 8px 25px rgba(0,210,255,0.3);
        color: #fff;
    }
    .btn-gradient:disabled { opacity: 0.4; }
    .btn-outline-secondary {
        border: 1px solid rgba(255,255,255,0.15);
        color: rgba(255,255,255,0.6);
        border-radius: 14px;
    }
    .btn-outline-secondary:hover { background: rgba(255,255,255,0.05); color: #fff; }
    .btn-pay {
        background: linear-gradient(to right, #f59e0b, #ef4444);
        border: none;
        border-radius: 14px;
        color: #fff;
    }
    .btn-pay:hover:not(.disabled) {
        transform: translateY(-1px);
        box-shadow: 0 8px 25px rgba(245,158,11,0.3);
        color: #fff;
    }

    /* Info Box */
    .info-box {
        background: rgba(0,210,255,0.06);
        border: 1px solid rgba(0,210,255,0.15);
        border-radius: 12px;
        padding: 12px 16px;
        display: flex;
        align-items: flex-start;
    }

    /* Summary */
    .summary-box {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px;
        padding: 20px;
    }
    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 0;
    }

    /* Payment Methods */
    .payment-method {
        flex: 1;
        background: rgba(255,255,255,0.04);
        border: 2px solid rgba(255,255,255,0.1);
        border-radius: 14px;
        padding: 16px 8px;
        color: rgba(255,255,255,0.5);
        text-align: center;
        cursor: pointer;
        transition: all 0.25s ease;
    }
    .payment-method:hover { border-color: rgba(0,210,255,0.3); color: #fff; }
    .payment-method.selected {
        border-color: #00d2ff;
        color: #00d2ff;
        background: rgba(0,210,255,0.08);
        box-shadow: 0 0 15px rgba(0,210,255,0.15);
    }

    /* Credentials */
    .credential-box {
        background: rgba(16,185,129,0.08);
        border: 1px solid rgba(16,185,129,0.2);
        border-radius: 16px;
        padding: 24px;
    }
    .credential-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
    }

    /* Success Icon */
    .success-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: rgba(16,185,129,0.12);
        color: #10b981;
        font-size: 2.5rem;
        animation: scaleIn 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    @@keyframes scaleIn {
        from { transform: scale(0); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    /* Hover Link */
    .hover-link:hover { color: #00d2ff !important; }
</style>

@code {
    private int _step = 1;
    private string _fullName = "";
    private string _phone = "";
    private string _email = "";
    private string _address = "";
    private string _poiName = "";
    private string _payMethod = "momo";
    private string? _error;
    private bool _isProcessing = false;

    private void SelectMomo() => _payMethod = "momo";
    private void SelectVnpay() => _payMethod = "vnpay";
    private void SelectBank() => _payMethod = "bank";

    private void GoStep2()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_fullName) || string.IsNullOrWhiteSpace(_phone))
        {
            _error = "Vui lòng nhập họ tên và số điện thoại";
            return;
        }

        // Validate phone number format (starts with 0 or +84, 9-12 digits total)
        if (!System.Text.RegularExpressions.Regex.IsMatch(_phone, @"^(\+84|0)[0-9]{8,10}$"))
        {
            _error = "Số điện thoại không hợp lệ. Vui lòng nhập đúng định dạng (VD: 0912345678).";
            return;
        }

        // Validate email format if provided
        if (!string.IsNullOrWhiteSpace(_email))
        {
            if (!System.Text.RegularExpressions.Regex.IsMatch(_email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
            {
                _error = "Email không đúng định dạng.";
                return;
            }
        }

        _step = 2;
    }

    private void GoStep3()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_poiName))
        {
            _error = "Vui lòng nhập tên quán";
            return;
        }
        _step = 3;
    }

    private async Task ProcessPayment()
    {
        _error = null;
        _isProcessing = true;
        StateHasChanged();

        try
        {
            // Simulate payment processing delay
            await Task.Delay(2500);

            // Call register API
            var payload = new
            {
                fullName = _fullName,
                phone = _phone,
                email = _email,
                address = _address,
                poiName = _poiName,
                amount = 300000
            };

            var response = await Http.PostAsJsonAsync("api/auth/register-merchant", payload);
            var raw = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                _step = 4; // Success!
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _error = "Số điện thoại này đã được đăng ký. Vui lòng sử dụng SĐT khác hoặc đăng nhập.";
            }
            else
            {
                var result = JsonSerializer.Deserialize<JsonElement>(raw);
                _error = result.TryGetProperty("message", out var msg) ? msg.GetString() : "Có lỗi xảy ra khi đăng ký";
            }
        }
        catch (Exception ex)
        {
            _error = $"Lỗi kết nối: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void GoToLogin()
    {
        NavigationManager.NavigateTo("/login");
    }
}
