@page "/login"
@layout EmptyLayout
@inject NavigationManager NavigationManager

<div class="login-container">
    <div class="login-box card shadow-lg border-0">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <i class="bi bi-egg-fried fs-1 text-primary"></i>
                <h2 class="fw-bold mt-2">Food Street CMS</h2>
                <p class="text-muted">Đăng nhập để quản lý hệ thống</p>
            </div>

            @if (showError)
            {
                <div class="alert alert-danger mb-4" role="alert">
                    <i class="bi bi-exclame-circle-fill me-2"></i> Sai tài khoản hoặc mật khẩu!
                </div>
            }

            <form action="api/auth/login" method="post">
                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">USERNAME</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-person"></i></span>
                        <input name="username" type="text" class="form-control bg-light border-start-0" placeholder="Nhập username" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small fw-bold">PASSWORD</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock"></i></span>
                        <input name="password" type="password" class="form-control bg-light border-start-0" placeholder="Nhập password" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 fw-bold shadow">
                    ĐĂNG NHẬP <i class="bi bi-arrow-right-short ms-1"></i>
                </button>
            </form>

            <div class="mt-4 text-center">
                <small class="text-muted">Demo: admin / 123456 | owner / 123456</small>
            </div>
        </div>
    </div>
</div>

<style>
    .login-container {
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    }

    .login-box {
        width: 100%;
        max-width: 450px;
        border-radius: 20px;
    }

    .btn-primary {
        border-radius: 12px;
        background: #0d6efd;
        transition: transform 0.2s;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
    }
    
    .input-group-text {
        border-radius: 12px 0 0 12px;
    }
    
    .form-control {
        border-radius: 0 12px 12px 0;
    }
</style>

@code {
    private bool showError = false;

    protected override void OnInitialized()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("error", out var value))
        {
            showError = true;
        }
    }
}
