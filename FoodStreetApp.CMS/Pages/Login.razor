@page "/login"
@layout EmptyLayout
@using System.Text.Json
@using System.Text.Json.Serialization
@using FoodStreetApp.CMS.Services
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@inject CustomAuthStateProvider AuthProvider

<div class="login-container">
    <div class="login-box card shadow-lg border-0">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <i class="bi bi-egg-fried fs-1 text-primary"></i>
                <h2 class="fw-bold mt-2">Food Street App</h2>
                <p class="text-muted">Đăng nhập CMS (Debug Mode)</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mb-4" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i> @errorMessage
                </div>
            }

            <EditForm Model="loginRequest" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">USERNAME</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-person"></i></span>
                        <InputText @bind-Value="loginRequest.Username" class="form-control bg-light border-start-0" placeholder="admin / owner" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small fw-bold">PASSWORD</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock"></i></span>
                        <InputText @bind-Value="loginRequest.Password" type="password" class="form-control bg-light border-start-0" placeholder="123456" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 fw-bold shadow @(isSubmitting ? "disabled" : "")">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>ĐANG ĐĂNG NHẬP...</span>
                    }
                    else
                    {
                        <span>ĐĂNG NHẬP</span> <i class="bi bi-arrow-right-short ms-1"></i>
                    }
                </button>
            </EditForm>
        </div>
    </div>
</div>

<style>
    .login-container {
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);
    }
    .login-box { width: 100%; max-width: 450px; border-radius: 20px; }
    .btn-primary { border-radius: 12px; background: linear-gradient(to right, #3a7bd5, #00d2ff); border: none; }
</style>

@code {
    private LoginRequest loginRequest = new();
    private string? errorMessage;
    private bool isSubmitting = false;

    private async Task HandleLogin()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            // The relative path works because we set BaseAddress in Program.cs

            var response = await Http.PostAsJsonAsync("api/auth/login", loginRequest);
            
            // DEBUG LOGGING
            var raw = await response.Content.ReadAsStringAsync();
            Console.WriteLine("[DEBUG] Login Response Body: " + raw);

            if (response.IsSuccessStatusCode)
            {
                var result = JsonSerializer.Deserialize<LoginResult>(raw, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

                if (result != null && !string.IsNullOrEmpty(result.Token))
                {
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "token", result.Token);
                    
                    AuthProvider.NotifyUserAuthentication(result.Token);

                    if (string.Equals(result.Role, "Owner", StringComparison.OrdinalIgnoreCase))
                    {
                        NavigationManager.NavigateTo("/owner");
                    }
                    else
                    {
                        NavigationManager.NavigateTo("/");
                    }


                }
            }
            else
            {
                errorMessage = "Tài khoản hoặc mật khẩu không chính xác";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi kết nối: {ex.Message}";
            Console.WriteLine("[DEBUG] Exception: " + ex.Message);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public class LoginRequest 
    { 
        [JsonPropertyName("username")]
        public string Username { get; set; } = ""; 
        [JsonPropertyName("password")]
        public string Password { get; set; } = ""; 
    }

    public class LoginResult 
    { 
        [JsonPropertyName("token")]
        public string Token { get; set; } = ""; 
        [JsonPropertyName("role")]
        public string Role { get; set; } = ""; 
    }
}
