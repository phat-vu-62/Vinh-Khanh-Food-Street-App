@page "/login"
@layout EmptyLayout
@using System.Net.Http.Json
@using FoodStreetApp.CMS.Services
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@inject CustomAuthStateProvider AuthProvider

<div class="login-container">
    <div class="login-box card shadow-lg border-0">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <i class="bi bi-egg-fried fs-1 text-primary"></i>
                <h2 class="fw-bold mt-2">Food Street App</h2>
                <p class="text-muted">Đăng nhập để quản lý hệ thống CMS</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mb-4" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i> @errorMessage
                </div>
            }

            <EditForm Model="loginRequest" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">USERNAME</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-person"></i></span>
                        <InputText @bind-Value="loginRequest.Username" class="form-control bg-light border-start-0" placeholder="Nhập username" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small fw-bold">PASSWORD</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock"></i></span>
                        <InputText @bind-Value="loginRequest.Password" type="password" class="form-control bg-light border-start-0" placeholder="Nhập password" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 fw-bold shadow @(isSubmitting ? "disabled" : "")">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>ĐANG ĐĂNG NHẬP...</span>
                    }
                    else
                    {
                        <span>ĐĂNG NHẬP</span> <i class="bi bi-arrow-right-short ms-1"></i>
                    }
                </button>
            </EditForm>

            <div class="mt-4 text-center">
                <small class="text-muted">Tài khoản: admin | owner / Mật khẩu: 123456</small>
            </div>
        </div>
    </div>
</div>

<style>
    .login-container {
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);
    }

    .login-box {
        width: 100%;
        max-width: 450px;
        border-radius: 20px;
    }

    .btn-primary {
        border-radius: 12px;
        background: #00d2ff;
        background: linear-gradient(to right, #3a7bd5, #00d2ff);
        border: none;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 210, 255, 0.4);
    }
    
    .input-group-text {
        border-radius: 12px 0 0 12px;
    }
    
    .form-control {
        border-radius: 0 12px 12px 0;
    }
</style>

@code {
    private LoginRequest loginRequest = new();
    private string? errorMessage;
    private bool isSubmitting = false;

    private async Task HandleLogin()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var baseUrl = Configuration["Api:BaseUrl"] ?? "https://vinh-khanh-food-street-app.onrender.com/";
            var loginUrl = $"{baseUrl.TrimEnd('/')}/api/auth/login";
            var response = await Http.PostAsJsonAsync(loginUrl, loginRequest);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResult>();
                if (result != null)
                {
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "authToken", result.Token);
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "userId", result.UserId.ToString());
                    
                    AuthProvider.NotifyUserAuthentication(result.Token);

                    // Redirect based on role
                    if (result.Role == "admin") NavigationManager.NavigateTo("/");
                    else if (result.Role == "owner") NavigationManager.NavigateTo("/owner");
                    else NavigationManager.NavigateTo("/");
                }
            }
            else
            {
                try 
                {
                    var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                    errorMessage = error?.Message ?? "Đăng nhập thất bại. Vui lòng kiểm tra lại.";
                }
                catch 
                {
                    errorMessage = "Tài khoản hoặc mật khẩu không chính xác.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi kết nối: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public class LoginRequest { public string Username { get; set; } = ""; public string Password { get; set; } = ""; }
    public class LoginResult { public string Token { get; set; } = ""; public string Role { get; set; } = ""; public Guid UserId { get; set; } }
    public class ErrorResponse { public string Message { get; set; } = ""; }
}
