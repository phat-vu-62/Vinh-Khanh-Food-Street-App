@model FoodStreetApp.CMS.Models.StatCardModel

<div class="card @Model.CardClass h-100 border-0 shadow-sm">
    <div class="card-body d-flex align-items-center justify-content-between">
        <div>
            <div class="small opacity-75">@Model.Title</div>
            <div class="display-6 fw-semibold">@Model.Value</div>
        </div>
        <i class="bi @Model.Icon fs-2 opacity-75"></i>
    </div>
</div>
