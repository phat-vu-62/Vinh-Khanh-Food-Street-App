@inherits LayoutComponentBase

<div class="admin-shell">
    <aside class="sidebar">
        <div class="sidebar-brand">
            <i class="bi bi-fire fs-4"></i> FoodStreet CMS
        </div>
        <nav class="nav flex-column gap-1 mt-2">
            <NavLink href="/" class="nav-link" Match="NavLinkMatch.All">
                <i class="bi bi-speedometer2"></i> Dashboard
            </NavLink>
            <NavLink href="/poi" class="nav-link">
                <i class="bi bi-geo-alt"></i> POI
            </NavLink>
            <NavLink href="/audio" class="nav-link">
                <i class="bi bi-file-earmark-music"></i> Audio
            </NavLink>
            <NavLink href="/translations" class="nav-link">
                <i class="bi bi-translate"></i> Translations
            </NavLink>
            <NavLink href="/usage-history" class="nav-link">
                <i class="bi bi-clock-history"></i> Usage History
            </NavLink>
            <NavLink href="/tours" class="nav-link">
                <i class="bi bi-map"></i> Tours
            </NavLink>
        </nav>
    </aside>

    <main class="content">
        <div class="topbar d-flex justify-content-between align-items-center mb-4">
            <div>
                <h5 class="mb-0">FoodStreet CMS</h5>
                <small class="text-muted">Core modules: POI, Audio, Translations, Usage History, Tours</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge text-bg-dark-subtle">Admin</span>
            </div>
        </div>

        @Body
    </main>
</div>

<ToastHost />
