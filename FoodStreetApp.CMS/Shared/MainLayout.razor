@inherits LayoutComponentBase

<div class="admin-shell">
    <aside class="sidebar">
        <div class="sidebar-brand">FoodStreet CMS</div>
        <nav class="nav flex-column">
            <NavLink href="/" class="nav-link" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="/poi" class="nav-link">POI</NavLink>
            <NavLink href="/tours" class="nav-link">Tours</NavLink>
            <NavLink href="/audio" class="nav-link">Audio</NavLink>
            <NavLink href="/settings" class="nav-link">Settings</NavLink>
        </nav>
    </aside>

    <main class="content">
        <div class="topbar d-flex justify-content-between align-items-center mb-4">
            <div>
                <h5 class="mb-0">Admin Dashboard</h5>
                <small class="text-muted">FoodStreet management console</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge text-bg-dark-subtle">Admin</span>
            </div>
        </div>

        @Body
    </main>
</div>

<ToastHost />
