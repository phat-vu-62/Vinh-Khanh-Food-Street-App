@implements IDisposable
@inject FoodStreetApp.CMS.Services.ToastService Toasts

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
    @foreach (var toast in _toasts)
    {
        <div class="toast show @toast.CssClass mb-2" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto">@toast.Title</strong>
                <button type="button" class="btn-close" @onclick="() => RemoveToast(toast)"></button>
            </div>
            <div class="toast-body">@toast.Message</div>
        </div>
    }
</div>

@code {
    private readonly List<FoodStreetApp.CMS.Services.ToastMessage> _toasts = [];

    protected override void OnInitialized()
    {
        Toasts.OnShow += HandleShow;
    }

    private void HandleShow(FoodStreetApp.CMS.Services.ToastMessage message)
    {
        _toasts.Add(message);
        _ = Task.Run(async () =>
        {
            await Task.Delay(3000);
            await InvokeAsync(() =>
            {
                _toasts.Remove(message);
                StateHasChanged();
            });
        });
        StateHasChanged();
    }

    private void RemoveToast(FoodStreetApp.CMS.Services.ToastMessage message)
    {
        _toasts.Remove(message);
    }

    public void Dispose()
    {
        Toasts.OnShow -= HandleShow;
    }
}
