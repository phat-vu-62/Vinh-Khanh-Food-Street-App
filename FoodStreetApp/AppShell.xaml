<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FoodStreetApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FoodStreetApp.Views"
    xmlns:loc="clr-namespace:FoodStreetApp.Services"
    Title="Food Street Guide">

    <TabBar>
        <ShellContent
            Title="{loc:Translate Home}"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="HomePage" />

        <ShellContent
            Title="{loc:Translate Map}"
            ContentTemplate="{DataTemplate views:MapPage}"
            Route="MapPage" />

        <ShellContent
            Title="{loc:Translate Settings}"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>

</Shell>

