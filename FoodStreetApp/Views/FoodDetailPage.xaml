<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodStreetApp.Models"
             xmlns:viewmodels="clr-namespace:FoodStreetApp.ViewModels"
             x:Class="FoodStreetApp.Views.FoodDetailPage"
             Title="{Binding Place.Name}">

    <ScrollView>
        <VerticalStackLayout Padding="0" Spacing="20">
            <!-- Large Image Placeholder -->
            <Grid HeightRequest="250">
                <Image Source="{Binding Place.Image}" Aspect="AspectFill" />
            </Grid>

            <VerticalStackLayout Padding="20" Spacing="15">
                <Label Text="{Binding Place.Name}" FontSize="28" FontAttributes="Bold" />
                <Label Text="{Binding Place.Rating, StringFormat='⭐ {0}'}" FontSize="18" TextColor="Orange" FontAttributes="Bold" />

                <!-- Audio Player Section -->
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E0E0E0" Background="{AppThemeBinding Light=#F9F9F9, Dark=#2C2C2C}" Padding="15">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                        <Button Grid.Column="0" 
                                Text="{Binding PlayStatus}" 
                                Command="{Binding ToggleNarrationCommand}"
                                HeightRequest="50"
                                WidthRequest="100"
                                CornerRadius="25"
                                BackgroundColor="{AppThemeBinding Light=#4CAF50, Dark=#4CAF50}"
                                TextColor="White"
                                FontAttributes="Bold" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Audio Guide" FontSize="16" FontAttributes="Bold" />
                            <Label Text="Listen to the story of this place" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label Text="Description" FontSize="20" FontAttributes="Bold" Margin="0,10,0,0" />
                <Label Text="{Binding Place.Description}" FontSize="16" />

                <Button Text="Show on Map"
                        Command="{Binding ShowOnMapCommand}"
                        Margin="0,30,0,0"
                        HeightRequest="50"
                        CornerRadius="25"
                        BackgroundColor="{AppThemeBinding Light=#0066CC, Dark=#4DA6FF}"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>