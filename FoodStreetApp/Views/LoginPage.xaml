<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodStreetApp.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

            <!-- Header Icon -->
            <Label Text="🍜"
                   FontSize="64"
                   HorizontalOptions="Center"
                   Margin="0,0,0,8" />

            <Label Text="Đăng nhập"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#1a1a2e" />

            <Label Text="Phố Ẩm Thực Vĩnh Khánh"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="#666"
                   Margin="0,0,0,16" />

            <!-- Error Message -->
            <Frame IsVisible="{Binding HasError}"
                   Padding="12"
                   CornerRadius="8"
                   BackgroundColor="#FFF0F0"
                   BorderColor="#FF4444"
                   HasShadow="False">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#CC0000"
                       FontSize="13"
                       HorizontalTextAlignment="Center" />
            </Frame>

            <!-- Username -->
            <Frame Padding="0" CornerRadius="12" HasShadow="False" BackgroundColor="White" BorderColor="#E0E0E0">
                <Entry x:Name="UsernameEntry"
                       Placeholder="Tên tài khoản"
                       Text="{Binding Username, Mode=TwoWay}"
                       FontSize="16"
                       Margin="16,12"
                       Keyboard="Default"
                       ReturnType="Next"
                       Completed="OnUsernameCompleted" />
            </Frame>

            <!-- Password -->
            <Frame Padding="0" CornerRadius="12" HasShadow="False" BackgroundColor="White" BorderColor="#E0E0E0">
                <Entry x:Name="PasswordEntry"
                       Placeholder="Mật khẩu"
                       Text="{Binding Password, Mode=TwoWay}"
                       IsPassword="True"
                       FontSize="16"
                       Margin="16,12"
                       ReturnType="Done"
                       ReturnCommand="{Binding LoginCommand}" />
            </Frame>

            <!-- Login Button -->
            <Button Text="Đăng nhập"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    FontSize="16"
                    FontAttributes="Bold"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    Margin="0,8,0,0" />

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center" />

            <!-- Register Link -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,16,0,0">
                <Label Text="Chưa có tài khoản?"
                       FontSize="14"
                       TextColor="#666"
                       VerticalOptions="Center" />
                <Label Text="Đăng ký ngay"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <!-- Skip -->
            <Label Text="← Quay lại"
                   FontSize="13"
                   TextColor="#999"
                   HorizontalOptions="Center"
                   Margin="0,8,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
