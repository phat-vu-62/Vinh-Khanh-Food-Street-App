<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:FoodStreetApp.Services"
             x:Class="FoodStreetApp.Views.SettingsPage"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16" Margin="0,40,0,0">

            <Label Text="{loc:Translate Settings}" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Start"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                   Margin="0,0,0,10" />

            <!-- GPS & Location -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate GPS &amp; Location}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="{loc:Translate Update frequency (seconds)}"
                           FontSize="14"
                           Margin="0,4,0,0" />
                    <Slider x:Name="UpdateFrequencySlider"
                            Minimum="1"
                            Maximum="30"
                            Value="{Binding UpdateFrequency, Mode=TwoWay}" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="{Binding UpdateFrequency}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="{loc:Translate seconds}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Geofence -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate Geofence}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="{loc:Translate Default trigger radius (meters)}"
                           FontSize="14"
                           Margin="0,4,0,0" />
                    <Slider x:Name="DefaultRadiusSlider"
                            Minimum="5"
                            Maximum="200"
                            Value="{Binding DefaultRadius, Mode=TwoWay}" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="{Binding DefaultRadius}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="{loc:Translate meters}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>

                    <Label Text="{loc:Translate Cooldown period (minutes)}"
                           FontSize="14"
                           Margin="0,8,0,0" />
                    <Slider x:Name="CooldownSlider"
                            Minimum="1"
                            Maximum="30"
                            Value="{Binding CooldownMinutes, Mode=TwoWay}" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="{Binding CooldownMinutes}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="{loc:Translate minutes}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Audio & TTS -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate App Language}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="{loc:Translate App Display Language}"
                           FontSize="14"
                           Margin="0,4,0,4" />

                    <Picker x:Name="AppLanguagePicker"
                            Title="Select App Language"
                            ItemsSource="{Binding AvailableLanguages}"
                            ItemDisplayBinding="{Binding NativeName}"
                            SelectedItem="{Binding SelectedAppLanguage, Mode=TwoWay}"
                            FontSize="15"
                            BackgroundColor="#F5F5F5"
                            Margin="0,0,0,16" />

                    <Label Text="{loc:Translate Audio &amp; TTS}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="{loc:Translate Narration Language}"
                           FontSize="14"
                           Margin="0,4,0,4" />

                    <Picker x:Name="LanguagePicker"
                            Title="Select Narration Language"
                            ItemsSource="{Binding AvailableLanguages}"
                            ItemDisplayBinding="{Binding NativeName}"
                            SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                            FontSize="15"
                            BackgroundColor="#F5F5F5"
                            Margin="0,0,0,8" />
                </VerticalStackLayout>
            </Frame>

            <!-- Background Tracking -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate Background Tracking}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Grid ColumnDefinitions="*, Auto" Margin="0,4">
                        <Label Grid.Column="0"
                               Text="{loc:Translate Track even when app is minimized}"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                x:Name="BackgroundTrackingSwitch"
                                IsToggled="{Binding EnableBackgroundTracking, Mode=TwoWay}"
                                VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Account -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="8">
                    <Label Text="👤 Tài khoản"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <!-- Logged In State -->
                    <VerticalStackLayout IsVisible="{Binding IsLoggedIn}" Spacing="8">
                        <Label FontSize="14" Margin="0,4,0,0">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Xin chào, " TextColor="#333" />
                                    <Span Text="{Binding DisplayName}" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Button Text="Đăng xuất"
                                Clicked="OnLogoutClicked"
                                FontSize="14"
                                BackgroundColor="#FF4444"
                                TextColor="White"
                                CornerRadius="8"
                                HeightRequest="40" />
                    </VerticalStackLayout>

                    <!-- Logged Out State -->
                    <VerticalStackLayout IsVisible="{Binding IsNotLoggedIn}" Spacing="8">
                        <Label Text="Đăng nhập để đồng bộ lịch sử hoạt động"
                               FontSize="13"
                               TextColor="#666"
                               Margin="0,4,0,0" />
                        <Button Text="Đăng nhập"
                                Clicked="OnLoginClicked"
                                FontSize="14"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="8"
                                HeightRequest="40" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- About -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{loc:Translate ℹ️ About}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="{loc:Translate Vinh Khanh Food Street Guide}"
                           FontSize="14"
                           Margin="0,4,0,0" />
                    <Label Text="{loc:Translate AppVersion}"
                           FontSize="12"
                           TextColor="Gray" />
                    <Label Text="{loc:Translate Built with .NET MAUI}"
                           FontSize="12"
                           TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
