<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:FoodStreetApp.Services"
             x:Class="FoodStreetApp.Views.SettingsPage"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16" Margin="0,40,0,0">

            <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[Settings]}" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Start"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                   Margin="0,0,0,10" />

            <!-- GPS & Location -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[GPS &amp; Location]}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[Update frequency (seconds)]}"
                           FontSize="14"
                           Margin="0,4,0,0" />
                    <Slider x:Name="UpdateFrequencySlider"
                            Minimum="3"
                            Maximum="30"
                            Value="{Binding UpdateFrequency, Mode=TwoWay}" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="{Binding UpdateFrequency}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[seconds]}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Geofence -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[Geofence]}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[Default trigger radius (meters)]}"
                           FontSize="14"
                           Margin="0,4,0,0" />
                    <Slider x:Name="DefaultRadiusSlider"
                            Minimum="20"
                            Maximum="200"
                            Value="{Binding DefaultRadius, Mode=TwoWay}" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="{Binding DefaultRadius}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[meters]}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[Cooldown period (minutes)]}"
                           FontSize="14"
                           Margin="0,8,0,0" />
                    <Slider x:Name="CooldownSlider"
                            Minimum="1"
                            Maximum="30"
                            Value="{Binding CooldownMinutes, Mode=TwoWay}" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="{Binding CooldownMinutes}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[minutes]}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Audio & TTS -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[App Language]}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[App Display Language]}"
                           FontSize="14"
                           Margin="0,4,0,4" />

                    <Picker x:Name="AppLanguagePicker"
                            Title="Select App Language"
                            ItemsSource="{Binding AvailableLanguages}"
                            ItemDisplayBinding="{Binding NativeName}"
                            SelectedItem="{Binding SelectedAppLanguage, Mode=TwoWay}"
                            FontSize="15"
                            BackgroundColor="#F5F5F5"
                            Margin="0,0,0,16" />

                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[Audio &amp; TTS]}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[Narration Language]}"
                           FontSize="14"
                           Margin="0,4,0,4" />

                    <Picker x:Name="LanguagePicker"
                            Title="Select Narration Language"
                            ItemsSource="{Binding AvailableLanguages}"
                            ItemDisplayBinding="{Binding NativeName}"
                            SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                            FontSize="15"
                            BackgroundColor="#F5F5F5"
                            Margin="0,0,0,8" />
                </VerticalStackLayout>
            </Frame>

            <!-- Background Tracking -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[Background Tracking]}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Grid ColumnDefinitions="*, Auto" Margin="0,4">
                        <Label Grid.Column="0"
                               Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[Track even when app is minimized]}"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                x:Name="BackgroundTrackingSwitch"
                                IsToggled="{Binding EnableBackgroundTracking, Mode=TwoWay}"
                                VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- About -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🔄 Đồng bộ dữ liệu"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="Làm mới POI từ CMS (thêm/sửa/xóa) về app"
                           FontSize="13"
                           TextColor="Gray" />

                    <Button Text="Refresh POI từ CMS"
                            Command="{Binding RefreshPoiCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="10" />

                    <ActivityIndicator IsVisible="{Binding IsRefreshingPoi}"
                                       IsRunning="{Binding IsRefreshingPoi}"
                                       Color="{StaticResource Primary}" />

                    <Label Text="{Binding PoiSyncMessage}"
                           FontSize="12"
                           TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <!-- About -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[ℹ️ About]}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[Vinh Khanh Food Street Guide]}"
                           FontSize="14"
                           Margin="0,4,0,0" />
                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[AppVersion]}"
                           FontSize="12"
                           TextColor="Gray" />
                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[Built with .NET MAUI]}"
                           FontSize="12"
                           TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
