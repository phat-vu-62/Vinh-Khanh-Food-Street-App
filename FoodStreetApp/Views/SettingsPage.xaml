<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodStreetApp.Views.SettingsPage"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16" Margin="0,40,0,0">

            <Label Text="Settings" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Start"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                   Margin="0,0,0,10" />

            <!-- GPS & Location -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="12">
                    <Label Text="📍 GPS &amp; Location"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="Update frequency (seconds)"
                           FontSize="14"
                           Margin="0,4,0,0" />
                    <Slider x:Name="UpdateFrequencySlider"
                            Minimum="3"
                            Maximum="30"
                            Value="{Binding UpdateFrequency, Mode=TwoWay}" />
                    <Label Text="{Binding UpdateFrequency, StringFormat='{0} seconds'}"
                           HorizontalOptions="Center"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Geofence -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="12">
                    <Label Text="🎯 Geofence"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="Default trigger radius (meters)"
                           FontSize="14"
                           Margin="0,4,0,0" />
                    <Slider x:Name="DefaultRadiusSlider"
                            Minimum="20"
                            Maximum="200"
                            Value="{Binding DefaultRadius, Mode=TwoWay}" />
                    <Label Text="{Binding DefaultRadius, StringFormat='{0} meters'}"
                           HorizontalOptions="Center"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="Cooldown period (minutes)"
                           FontSize="14"
                           Margin="0,8,0,0" />
                    <Slider x:Name="CooldownSlider"
                            Minimum="1"
                            Maximum="30"
                            Value="{Binding CooldownMinutes, Mode=TwoWay}" />
                    <Label Text="{Binding CooldownMinutes, StringFormat='{0} minutes'}"
                           HorizontalOptions="Center"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Audio & TTS -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="12">
                    <Label Text="🔊 Audio &amp; TTS"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="Narration Language"
                           FontSize="14"
                           Margin="0,4,0,4" />

                    <Picker x:Name="LanguagePicker"
                            Title="Select Language"
                            ItemsSource="{Binding AvailableLanguages}"
                            ItemDisplayBinding="{Binding NativeName}"
                            SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                            FontSize="15"
                            BackgroundColor="#F5F5F5"
                            Margin="0,0,0,8" />

                    <Grid ColumnDefinitions="*, Auto" Margin="0,4">
                        <Label Grid.Column="0"
                               Text="Prefer TTS over audio files"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                x:Name="PreferTtsSwitch"
                                IsToggled="{Binding PreferTts, Mode=TwoWay}"
                                VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" Margin="0,4">
                        <Label Grid.Column="0"
                               Text="Enable audio notifications"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                x:Name="EnableAudioSwitch"
                                IsToggled="{Binding EnableAudio, Mode=TwoWay}"
                                VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- System Tests -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🧪 System Tests"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           Margin="0,0,0,4" />

                    <Button Text="📍 Test GPS Location"
                            Command="{Binding TestGpsCommand}"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="44"
                            FontSize="14" />

                    <Button Text="🔊 Test TTS"
                            Command="{Binding TestTtsCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="44"
                            FontSize="14" />

                    <Button Text="🎵 Test Narration Service"
                            Command="{Binding TestNarrationCommand}"
                            BackgroundColor="{StaticResource Secondary}"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="44"
                            FontSize="14" />

                    <Label Text="Press GPS test to check your current location"
                           FontSize="12"
                           TextColor="Gray"
                           HorizontalTextAlignment="Center"
                           Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Frame>

            <!-- Background Tracking -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="8">
                    <Label Text="🔄 Background Tracking"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Grid ColumnDefinitions="*, Auto" Margin="0,4">
                        <Label Grid.Column="0"
                               Text="Track even when app is minimized"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                x:Name="BackgroundTrackingSwitch"
                                IsToggled="{Binding EnableBackgroundTracking, Mode=TwoWay}"
                                VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- About -->
            <Frame Padding="16" CornerRadius="12" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="6">
                    <Label Text="ℹ️ About"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="Vinh Khanh Food Street Guide"
                           FontSize="14"
                           Margin="0,4,0,0" />
                    <Label Text="Version 2.0.0"
                           FontSize="12"
                           TextColor="Gray" />
                    <Label Text="Built with .NET MAUI"
                           FontSize="12"
                           TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
