<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodStreetApp.Models"
             xmlns:viewmodels="clr-namespace:FoodStreetApp.ViewModels"
             xmlns:loc="clr-namespace:FoodStreetApp.Services"
             x:Class="FoodStreetApp.Views.HomePage"
             Title="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[Home]}"
             Shell.NavBarIsVisible="False">

    <RefreshView IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
                 Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Spacing="0">
            <!-- Hero Header Section -->
            <Grid HeightRequest="250">
                <Image Source="vinhkhanh.jpg" Aspect="AspectFill" />

                <!-- Lớp gradient mờ ở phần dưới để chữ hiển thị rõ -->
                <BoxView BackgroundColor="Black" 
                         Opacity="0.4"
                         VerticalOptions="End" 
                         HeightRequest="100" />

                <VerticalStackLayout VerticalOptions="End" Padding="20">
                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[Discover Vinh Khanh Food Street]}" 
                           TextColor="White" 
                           FontSize="24" 
                           FontAttributes="Bold" />
                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[Famous seafood street in District 4]}" 
                           TextColor="White" 
                           FontSize="16" />
                </VerticalStackLayout>
            </Grid>

            <Grid Padding="20,10,20,20">
                <VerticalStackLayout Spacing="25">

                    <!-- Search Bar -->
                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E0E0E0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" Padding="10,0" ZIndex="1">
                        <SearchBar Placeholder="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[Search restaurants...]}" Text="{Binding SearchText}" BackgroundColor="Transparent" />
                    </Border>

                <!-- Featured Section (Horizontal Scroll) -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[🔥 Featured on Vinh Khanh]}" 
                           FontSize="20" 
                           FontAttributes="Bold" />

                    <CollectionView ItemsSource="{Binding FeaturedStalls}"
                                    ItemsLayout="HorizontalList"
                                    HeightRequest="260">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:FoodPlace">
                                <Border Margin="0,5,15,15" 
                                        WidthRequest="260"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="0"
                                        Background="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.1" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomeViewModel}}, Path=GoToDetailCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="146, Auto">
                                        <Image Source="{Binding Image}" Aspect="AspectFill" Grid.Row="0" />

                                        <VerticalStackLayout Grid.Row="1" Padding="15" Spacing="4">
                                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                                            <Label Text="{Binding Rating, StringFormat='⭐ {0:F1}'}" FontSize="14" TextColor="#FF9800" FontAttributes="Bold" />
                                            <Label Text="{Binding Description}" FontSize="12" TextColor="Gray" MaxLines="2" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Popular Spots Section (2 Column Grid) -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[⭐ Popular Seafood]}" 
                           FontSize="20" 
                           FontAttributes="Bold" />

                    <CollectionView ItemsSource="{Binding PopularSeafoodStalls}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="15" VerticalItemSpacing="15" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:FoodPlace">
                                <Border StrokeShape="RoundRectangle 16"
                                        StrokeThickness="0"
                                        Background="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                        Margin="0,0,0,10">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.1" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomeViewModel}}, Path=GoToDetailCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="120, Auto">
                                        <Image Source="{Binding Image}" Aspect="AspectFill" Grid.Row="0" />

                                        <VerticalStackLayout Grid.Row="1" Padding="12" Spacing="4">
                                            <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Rating, StringFormat='⭐ {0:F1}'}" FontSize="12" TextColor="#FF9800" FontAttributes="Bold" />
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="📍" FontSize="10" VerticalOptions="Center" />
                                                <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[Vinh Khanh Street]}" FontSize="10" TextColor="Gray" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Search & All Restaurants Section -->
                <VerticalStackLayout Spacing="10" Margin="0, 15, 0, 10">
                    <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[🍽 All Restaurants]}" 
                           FontSize="20" 
                           FontAttributes="Bold" />

                    <!-- All Restaurants List -->
                    <CollectionView ItemsSource="{Binding AllRestaurants}" Margin="0,10,0,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:FoodPlace">
                                <Border StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        Background="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                        Margin="0,0,0,15">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomeViewModel}}, Path=GoToDetailCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="100, *" Padding="10" ColumnSpacing="15">
                                        <!-- Image -->
                                        <Border Grid.Column="0" StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="LightGray" HeightRequest="90">
                                            <Image Source="{Binding Image}" Aspect="AspectFill" />
                                        </Border>

                                        <!-- Details -->
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                            <Label Text="{Binding Rating, StringFormat='⭐ {0:F1}'}" FontSize="12" TextColor="#FF9800" FontAttributes="Bold" />
                                            <Label Text="{Binding Description}" FontSize="12" TextColor="Gray" MaxLines="2" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="12" Spacing="4" HorizontalOptions="Center">
                                <Label Text="Không có dữ liệu POI." HorizontalOptions="Center" TextColor="Gray" />
                                <Label Text="Vuốt xuống để làm mới." HorizontalOptions="Center" TextColor="Gray" FontSize="12" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Search Results Overlay -->
                <Border StrokeShape="RoundRectangle 12" 
                        StrokeThickness="1" 
                        Stroke="#E0E0E0"
                        Background="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
                        IsVisible="{Binding IsSearching}"
                        Margin="0,55,0,0"
                        Padding="0"
                        VerticalOptions="Start"
                        MaximumHeightRequest="300"
                        ZIndex="10">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.2" />
                    </Border.Shadow>
                    <CollectionView ItemsSource="{Binding SearchResults}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:FoodPlace">
                                <StackLayout Padding="15,10">
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomeViewModel}}, Path=GoToDetailCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </StackLayout.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Image HeightRequest="20" WidthRequest="20" VerticalOptions="Center">
                                            <Image.Source>
                                                <FontImageSource FontFamily="OpenSansRegular" Glyph="🔍" Size="18" Color="Gray"/>
                                            </Image.Source>
                                        </Image>
                                        <VerticalStackLayout VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                            <Label Text="{Binding Description}" FontSize="12" TextColor="Gray" MaxLines="1" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[No restaurants found]}" Padding="15" TextColor="Gray" HorizontalOptions="Center" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </Border>
            </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>