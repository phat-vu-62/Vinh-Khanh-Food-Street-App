<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:sensors="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="FoodStreetApp.Views.MapPage"
             Title="Food Street Guide">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Header with Reset Button -->
        <Frame Grid.Row="0"
               BackgroundColor="White"
               Padding="12"
               Margin="12,12,12,0"
               CornerRadius="12"
               HasShadow="True">
            <Grid ColumnDefinitions="*, Auto">
                <Label Grid.Column="0"
                       Text="Food Street Guide"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="{StaticResource Primary}" />

                <Button Grid.Column="1"
                        Text="🔄 Reset"
                        Clicked="OnResetClicked"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        Padding="12,6"
                        CornerRadius="8"
                        FontSize="13"
                        FontAttributes="Bold" />
            </Grid>
        </Frame>

        <!-- Map (Google Maps location button is built-in, no custom button needed) -->
        <maps:Map Grid.Row="1"
                  x:Name="map"
                  IsShowingUser="True"
                  MapType="Street"
                  Margin="12,8,12,0">
        </maps:Map>

        <!-- Compact Status Card -->
        <Frame Grid.Row="2" 
               BackgroundColor="White"
               Padding="16,12"
               Margin="12"
               CornerRadius="12"
               HasShadow="True">
            <VerticalStackLayout Spacing="6">

                <!-- Current Location -->
                <HorizontalStackLayout Spacing="6">
                    <Label Text="📍"
                           FontSize="14"
                           VerticalOptions="Center" />
                    <Label Text="{Binding CurrentLocationText}"
                           FontSize="13"
                           VerticalOptions="Center"
                           TextColor="#666" />
                </HorizontalStackLayout>

                <!-- Nearest POI -->
                <HorizontalStackLayout Spacing="6">
                    <Label Text="🎯"
                           FontSize="14"
                           VerticalOptions="Center" />
                    <Label Text="{Binding NearestPoiText}"
                           FontSize="13"
                           VerticalOptions="Center"
                           TextColor="#666" />
                </HorizontalStackLayout>

                <!-- Divider -->
                <BoxView HeightRequest="1"
                         BackgroundColor="#E0E0E0"
                         Margin="0,4" />

                <!-- Status Message -->
                <Label Text="{Binding StatusMessage}"
                       FontSize="14"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Primary}" />

            </VerticalStackLayout>
        </Frame>

    </Grid>

</ContentPage>
