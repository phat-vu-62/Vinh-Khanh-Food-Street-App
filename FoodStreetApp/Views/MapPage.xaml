<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:sensors="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:loc="clr-namespace:FoodStreetApp.Services"
             x:Class="FoodStreetApp.Views.MapPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto">

        <!-- Map (Google Maps location button is built-in, no custom button needed) -->
        <maps:Map Grid.Row="0"
                  x:Name="map"
                  IsShowingUser="True"
                  MapType="Street">
        </maps:Map>

        <!-- Compact Info Card OVERLAY (Hidden by default, shown when pin clicked) -->
        <Frame x:Name="MarkerInfoCard"
               Grid.Row="0"
               IsVisible="False"
               BackgroundColor="White"
               CornerRadius="16"
               HasShadow="True"
               Margin="15,120,15,15"
               Padding="16"
               VerticalOptions="Start"
               HorizontalOptions="FillAndExpand"
               BorderColor="Transparent">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                <!-- Icon -->
                <Frame Grid.Column="0" 
                       BackgroundColor="#F2F6FA" 
                       CornerRadius="24" 
                       HeightRequest="48" 
                       WidthRequest="48" 
                       Padding="0" 
                       HasShadow="False"
                       BorderColor="Transparent"
                       HorizontalOptions="Center" 
                       VerticalOptions="Center">
                    <Label Text="🍽️" 
                           FontSize="24" 
                           Opacity="0.6"
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" />
                </Frame>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label x:Name="MarkerTitleLabel" FontSize="18" TextColor="Black" FontAttributes="Bold" />
                    <Label x:Name="MarkerDescLabel" FontSize="14" TextColor="#777" MaxLines="2" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <ImageButton Grid.Column="2" 
                             Source="{FontImage &#x2715;, FontFamily=OpenSansRegular, Size=16, Color=#888}" 
                             Clicked="OnCloseMarkerInfoClicked" 
                             VerticalOptions="Start" 
                             HorizontalOptions="End" 
                             BackgroundColor="Transparent" 
                             WidthRequest="32" 
                             HeightRequest="32"
                             Padding="8"
                             Margin="0,-8,-8,0" />
            </Grid>
        </Frame>

        <Button Grid.Row="0"
                Text="{Binding Source={x:Static loc:LocalizationResourceManager.Instance}, Path=[Reset]}"
                Clicked="OnResetClicked"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                Padding="16,8"
                CornerRadius="8"
                FontSize="14"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0,65,12,0">
            <Button.Shadow>
                <Shadow Brush="Black" Offset="0,2" Opacity="0.2" Radius="4" />
            </Button.Shadow>
        </Button>

        <!-- Compact Status Card -->
        <Frame Grid.Row="1" 
               BackgroundColor="White"
               Padding="16,12"
               Margin="12"
               CornerRadius="12"
               HasShadow="True">
            <VerticalStackLayout Spacing="6">

                <!-- Current Location -->
                <HorizontalStackLayout Spacing="6">
                    <Label Text="📍"
                           FontSize="14"
                           VerticalOptions="Center" />
                    <Label Text="{Binding CurrentLocationText}"
                           FontSize="13"
                           VerticalOptions="Center"
                           TextColor="#666" />
                </HorizontalStackLayout>

                <!-- Nearest POI -->
                <HorizontalStackLayout Spacing="6">
                    <Label Text="🎯"
                           FontSize="14"
                           VerticalOptions="Center" />
                    <Label Text="{Binding NearestPoiText}"
                           FontSize="13"
                           VerticalOptions="Center"
                           TextColor="#666" />
                </HorizontalStackLayout>

                <!-- Divider -->
                <BoxView HeightRequest="1"
                         BackgroundColor="#E0E0E0"
                         Margin="0,4" />

                <!-- Status Message -->
                <Label Text="{Binding StatusMessage}"
                       FontSize="14"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Primary}" />

            </VerticalStackLayout>
        </Frame>

    </Grid>

</ContentPage>
