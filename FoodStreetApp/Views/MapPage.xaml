<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:sensors="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="FoodStreetApp.Views.MapPage"
             Title="Food Street Guide">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Top Control Bar -->
        <Frame Grid.Row="0"
               BackgroundColor="{StaticResource Primary}"
               Padding="15,10"
               Margin="10,10,10,0"
               CornerRadius="10"
               HasShadow="True">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="🔄 Reset All"
                        Clicked="OnResetClicked"
                        BackgroundColor="White"
                        TextColor="{StaticResource Primary}"
                        Padding="15,8"
                        CornerRadius="8"
                        FontSize="14"
                        FontAttributes="Bold" />
            </HorizontalStackLayout>
        </Frame>

        <!-- Map -->
        <maps:Map x:Name="map"
                  IsShowingUser="True"
                  MapType="Street"
                  Grid.Row="1">
        </maps:Map>

        <!-- Enhanced Status Panel -->
        <Frame Grid.Row="2" 
               BackgroundColor="{StaticResource Primary}"
               Padding="20,15"
               Margin="10"
               CornerRadius="15"
               HasShadow="True">
            <VerticalStackLayout Spacing="10">

                <!-- Current Location -->
                <Label Text="{Binding CurrentLocationText}"
                       TextColor="White"
                       FontSize="14"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <!-- Nearest POI -->
                <Label Text="{Binding NearestPoiText}"
                       TextColor="White"
                       FontSize="14"
                       HorizontalOptions="Center" />

                <!-- Divider -->
                <BoxView HeightRequest="1"
                         BackgroundColor="White"
                         Opacity="0.3"
                         Margin="0,5" />

                <!-- Status Message -->
                <Label Text="{Binding StatusMessage}"
                       TextColor="White"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <!-- App Title -->
                <Label Text="Vinh Khanh Street Audio Guide"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"
                       Opacity="0.7" />

            </VerticalStackLayout>
        </Frame>

    </Grid>

</ContentPage>
