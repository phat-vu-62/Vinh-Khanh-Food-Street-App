<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodStreetApp.Views.RegisterPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Center">

            <!-- Header -->
            <Label Text="📝"
                   FontSize="48"
                   HorizontalOptions="Center"
                   Margin="0,0,0,4" />

            <Label Text="Tạo tài khoản mới"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#1a1a2e" />

            <Label Text="Trải nghiệm ẩm thực không giới hạn"
                   FontSize="13"
                   HorizontalOptions="Center"
                   TextColor="#666"
                   Margin="0,0,0,12" />

            <!-- Error Message -->
            <Frame IsVisible="{Binding HasError}"
                   Padding="12"
                   CornerRadius="8"
                   BackgroundColor="#FFF0F0"
                   BorderColor="#FF4444"
                   HasShadow="False">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#CC0000"
                       FontSize="13"
                       HorizontalTextAlignment="Center" />
            </Frame>

            <!-- Success Message -->
            <Frame IsVisible="{Binding HasSuccess}"
                   Padding="12"
                   CornerRadius="8"
                   BackgroundColor="#F0FFF0"
                   BorderColor="#44BB44"
                   HasShadow="False">
                <Label Text="{Binding SuccessMessage}"
                       TextColor="#008800"
                       FontSize="13"
                       HorizontalTextAlignment="Center" />
            </Frame>

            <!-- Full Name (Required) -->
            <Frame Padding="0" CornerRadius="12" HasShadow="False" BackgroundColor="White" BorderColor="#E0E0E0">
                <Entry Placeholder="Họ và tên *"
                       Text="{Binding FullName, Mode=TwoWay}"
                       FontSize="15"
                       Margin="16,12" />
            </Frame>

            <!-- Email (Optional) -->
            <Frame Padding="0" CornerRadius="12" HasShadow="False" BackgroundColor="White" BorderColor="#E0E0E0">
                <Entry Placeholder="Email (tuỳ chọn)"
                       Text="{Binding Email, Mode=TwoWay}"
                       FontSize="15"
                       Keyboard="Email"
                       Margin="16,12" />
            </Frame>

            <!-- Phone Number -->
            <Frame Padding="0" CornerRadius="12" HasShadow="False" BackgroundColor="White" BorderColor="#E0E0E0">
                <Entry Placeholder="Số điện thoại *"
                       Text="{Binding PhoneNumber, Mode=TwoWay}"
                       FontSize="15"
                       Keyboard="Telephone"
                       Margin="16,12" />
            </Frame>

            <!-- Username -->
            <Frame Padding="0" CornerRadius="12" HasShadow="False" BackgroundColor="White" BorderColor="#E0E0E0">
                <Entry Placeholder="Tên tài khoản *"
                       Text="{Binding Username, Mode=TwoWay}"
                       FontSize="15"
                       Margin="16,12" />
            </Frame>

            <!-- Password -->
            <Frame Padding="0" CornerRadius="12" HasShadow="False" BackgroundColor="White" BorderColor="#E0E0E0">
                <Entry Placeholder="Mật khẩu (≥ 6 ký tự) *"
                       Text="{Binding Password, Mode=TwoWay}"
                       IsPassword="True"
                       FontSize="15"
                       Margin="16,12" />
            </Frame>

            <!-- Confirm Password -->
            <Frame Padding="0" CornerRadius="12" HasShadow="False" BackgroundColor="White" BorderColor="#E0E0E0">
                <Entry Placeholder="Xác nhận mật khẩu *"
                       Text="{Binding ConfirmPassword, Mode=TwoWay}"
                       IsPassword="True"
                       FontSize="15"
                       Margin="16,12" />
            </Frame>

            <!-- Register Button -->
            <Button Text="Đăng ký"
                    Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    FontSize="16"
                    FontAttributes="Bold"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    Margin="0,4,0,0" />

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center" />

            <!-- Back to Login -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,8,0,0">
                <Label Text="Đã có tài khoản?"
                       FontSize="14"
                       TextColor="#666"
                       VerticalOptions="Center" />
                <Label Text="Đăng nhập"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
